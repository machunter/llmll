{
  "schemaVersion": "0.10.0",
  "llmll_version": "0.3.0",
  "statements": [
    {
      "kind": "import",
      "path": "wasi.io",
      "capability": {
        "name": "stdout",
        "deterministic": false
      }
    },
    {
      "kind": "def-shell",
      "name": "step-fn",
      "params": [
        {
          "name": "state",
          "param_type": {
            "kind": "primitive",
            "name": "string"
          }
        },
        {
          "name": "input",
          "param_type": {
            "kind": "primitive",
            "name": "string"
          }
        }
      ],
      "body": {
        "kind": "do",
        "steps": [
          {
            "kind": "do-step",
            "name": "s1",
            "discard": true,
            "expr": {
              "kind": "pair",
              "fst": {
                "kind": "var",
                "name": "state"
              },
              "snd": {
                "kind": "app",
                "fn": "wasi.io.stdout",
                "args": [
                  {
                    "kind": "var",
                    "name": "input"
                  }
                ]
              }
            }
          },
          {
            "kind": "do-step",
            "expr": {
              "kind": "pair",
              "fst": {
                "kind": "var",
                "name": "s1"
              },
              "snd": {
                "kind": "app",
                "fn": "wasi.io.stdout",
                "args": [
                  {
                    "kind": "lit-string",
                    "value": "done"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
