; LT-CDP (v0.11) fixture — (spec-entropy :intentional) suppression.
; Cache lookup: the contract intentionally admits any (ok|error) result; the
; (spec-entropy :intentional) annotation suppresses the over-permissive
; diagnostic while still reporting the score.
(def-logic cache-lookup [k: int] -> int
  (post (>= result 0))
  (spec-entropy :intentional)
  k)
