;; @expect: FS-SIZE-1 POSITIVE WITNESS. 'Sized' binds to wasi.fs.size, so the RCode arm binder
;; @expect: carries {v : int | v >= 0} and (post (>= result 0)) is DISCHARGED FROM THE FACT with
;; @expect: no runtime guard. check clean, no RESP-FACT error, no W-RESP-FACT-NONE; verify SAFE.
;; @expect: DISCRIMINATING: delete the (wasi.fs.size, RCode) row from respFactTable and this same
;; @expect: file must REFUTE, as fs-exists-refutes does for the same shape bound to wasi.fs.exists.
(import wasi.fs (capability read "/tmp" :deterministic false))
(import wasi.io (capability stdout :deterministic false))
(export)
(type Ctl (| Boot) (| Sized) (| Halt))
(def-shell go [r: int p: Ctl c: Command] -> ((int, Ctl), Command)
  (pair (pair r p) c))
(def-shell size-step [p: Ctl x: Response] -> int
  (pre (= p Sized))
  (post (>= result 0))
  (match x ((RCode n) n) (_ 0)))
(def-shell step [s: (int, Ctl) input: string x: Response] -> ((int, Ctl), Command)
  (match (second s)
    ((Boot)  (go (first s) Sized (wasi.fs.size "/tmp/x")))
    ((Sized) (go (size-step Sized x) Halt (wasi.io.stdout "done")))
    ((Halt)  (go (first s) Halt (wasi.io.stdout "")))))
(def-shell done? [s: (int, Ctl)] -> bool
  (match (second s) ((Halt) true) ((Boot) false) ((Sized) false)))
(def-main :mode console
  :init (pair (pair 0 Boot) (wasi.io.stdout "start"))
  :step step
  :done? done?)
