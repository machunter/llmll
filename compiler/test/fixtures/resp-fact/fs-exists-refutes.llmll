;; @expect: NEGATIVE CONTROL for fs-stat-fact. Byte-for-byte the same shape and the SAME post,
;; @expect: except the tag binds to wasi.fs.exists, which declares NO fact. So no fact reaches the
;; @expect: RCode binder, 'age' is an unconstrained int, and (post (>= result 0)) is REFUTED.
;; @expect: This is the discrimination the fact must earn: fs-stat-fact verifies, this refutes, and
;; @expect: the ONLY difference is whether the bound builtin declares a fact. verify UNSAFE.
(import wasi.fs (capability read "/tmp" :deterministic false))
(import wasi.io (capability stdout :deterministic false))
(export)
(type Ctl (| Boot) (| Probed) (| Halt))
(def-shell go [r: int p: Ctl c: Command] -> ((int, Ctl), Command)
  (pair (pair r p) c))
(def-shell age-step [p: Ctl x: Response] -> int
  (pre (= p Probed))
  (post (>= result 0))
  (match x ((RCode age) age) (_ 0)))
(def-shell step [s: (int, Ctl) input: string x: Response] -> ((int, Ctl), Command)
  (match (second s)
    ((Boot)   (go (first s) Probed (wasi.fs.exists "/tmp")))
    ((Probed) (go (age-step Probed x) Halt (wasi.io.stdout "done")))
    ((Halt)   (go (first s) Halt (wasi.io.stdout "")))))
(def-shell done? [s: (int, Ctl)] -> bool
  (match (second s) ((Halt) true) ((Boot) false) ((Probed) false)))
(def-main :mode console
  :init (pair (pair 0 Boot) (wasi.io.stdout "start"))
  :step step
  :done? done?)
