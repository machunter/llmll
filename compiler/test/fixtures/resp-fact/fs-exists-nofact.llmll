;; @expect: FS-EXISTS-1 declares NO fact: its kind is RText and fact predicates are int-only.
;; @expect: A tag bound to wasi.fs.exists therefore gets W-RESP-FACT-NONE, not a fact and not an error.
(import wasi.fs (capability read "/tmp" :deterministic false))
(import wasi.io (capability stdout :deterministic false))
(export)
(type Ctl (| Boot) (| Asked) (| Halt))
(def-shell go [r: int p: Ctl c: Command] -> ((int, Ctl), Command)
  (pair (pair r p) c))
(def-shell kind-step [p: Ctl x: Response] -> int
  (pre (= p Asked))
  (match x ((RCode n) n) (_ 0)))
(def-shell step [s: (int, Ctl) input: string x: Response] -> ((int, Ctl), Command)
  (match (second s)
    ((Boot)  (go (first s) Asked (wasi.fs.exists "/tmp")))
    ((Asked) (go (kind-step Asked x) Halt (wasi.io.stdout "done")))
    ((Halt)  (go (first s) Halt (wasi.io.stdout "")))))
(def-shell done? [s: (int, Ctl)] -> bool
  (match (second s) ((Halt) true) ((Boot) false) ((Asked) false)))
(def-main :mode console
  :init (pair (pair 0 Boot) (wasi.io.stdout "start"))
  :step step
  :done? done?)
