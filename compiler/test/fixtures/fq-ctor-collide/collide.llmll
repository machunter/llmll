;; FQ-CTOR-COLLIDE-1 regression fixture — see docs/design/finding-fq-ctor-name-collision.md
;;
;; The parameter `bar` collides with the lowercasing of constructor `Bar` in the
;; emitted .fq namespace (FixpointEmit.hs applies T.toLower to constructor names).
;; `ca` neither takes nor returns an `S`; merely DECLARING the type is enough,
;; because the datatype declaration lands in the same .fq.
;;
;; EXPECTED (v0.14.65, the defect):  liquid-fixpoint crash,
;;   "Sort mismatch at argument #1 for function (declare-fun and (Bool Bool) Bool)
;;    supplied sort is S"
;; EXPECTED (once fixed):            SAFE, body-faithful
;;
;; Fails CLOSED: this never yields a false SAFE.
(type S (| Foo) (| Bar))

(def-shell ca [bar: bool] -> int
  (post (=> bar (= result 1)) :source "[FQ-CTOR-COLLIDE-1] colliding binder name")
  (if bar 1 0))
