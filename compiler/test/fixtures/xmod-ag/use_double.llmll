;; xmod-ag A1 witness (opened import): use-double calls the imported 'double'
;; by its bare (opened) name. With the body-VC ContractEnv seeded from the
;; cache, use-double verifies BODY-FAITHFUL via assume-guarantee against
;; double's contract (proves double's pre (>= x 0), assumes its post
;; result = x + x), instead of falling back to contract-only.
(import lib)
(open lib)
(def-shell use-double [x: int] -> int
  (pre (>= x 0))
  (post (= result (+ x x)))
  (double x))
