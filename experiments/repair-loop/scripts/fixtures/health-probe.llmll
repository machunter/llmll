;; Stop-fast discipline C — minimal LLMLL fixture exercised by
;; run_matrix.py:check_prereqs (check_compiler_health) to confirm the
;; `llmll` binary on PATH is healthy: it can parse and type-check a
;; trivial program. Acceptance: `llmll check` exits 0 on this file.
;;
;; If `llmll` is on PATH but broken (corrupt binary, missing runtime
;; dep, stale ~/.llmll/ cache), this probe fails and the matrix aborts
;; before any cell runs.
;;
;; Keep this fixture minimal — additional features risk false-negatives
;; under future compiler changes. Trivial int-identity with a post
;; clause that type-checks but does not exercise SMT verification
;; (discipline C calls `llmll check`, not `llmll verify`).

(def-logic identity-int [n: int]
  (post (= result n))
  n)
