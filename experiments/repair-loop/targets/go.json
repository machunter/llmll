{
  "target": "go",
  "version_pin_command": ["go", "version"],
  "expected_files_priority": ["solution.go"],
  "harness_files": ["go.mod", "solution_test.go"],
  "verifier_commands": [
    {
      "name": "vet",
      "argv": ["go", "vet", "./..."],
      "capture": "exit_and_text"
    },
    {
      "name": "build",
      "argv": ["go", "build", "-o", "/dev/null", "./..."],
      "capture": "exit_and_text"
    },
    {
      "name": "test",
      "argv": ["go", "test", "-v", "./..."],
      "capture": "exit_and_text"
    }
  ],
  "terminal_target_predicates": {
    "all-verifier-commands-pass": {
      "description": "All configured verifier commands exit 0. For Phase-1.75 Go: vet + build + test succeed. Module-mode operation requires go.mod (harness-injected). Test file solution_test.go is harness-owned.",
      "applies_to_commands": ["vet", "build", "test"]
    }
  },
  "scoring": {
    "correctness_rubric": "docs/design/language-comparison-experiments.md:198-211",
    "assurance_rubric": "docs/design/language-comparison-experiments.md:213-226",
    "go_assurance_sources": [
      "go vet (basic static analysis)",
      "go build (type-check + compile)",
      "go test (test pass rate)",
      "exported-type density (assurance subscore, Phase 1.75+)"
    ]
  },
  "context_injection": {
    "turn_artifact_path": "context/turn_{turn:02d}_verifier.json",
    "agent_instruction_path": "AGENT_INSTRUCTIONS.md",
    "problem_path": "problem.md",
    "target_descriptor_path": "TARGET.md"
  }
}
