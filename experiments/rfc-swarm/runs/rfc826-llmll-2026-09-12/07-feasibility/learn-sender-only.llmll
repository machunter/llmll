;; Stage H feasibility probe 6 — the frame condition, standing on its own.
;;
;; Shape under test: a frame stated against a *named* other key rather than a
;; generic witness. Probes 1, 2 and 5 carry a Skolem `okey` for "some key nobody
;; wrote". This probe pins the one key an implementer is actually tempted to
;; write: the packet's own target pair <ar$pro, ar$tpa>, whose hardware address
;; sits right there in ar$tha.
;;
;; Two reasons that temptation is wrong, and both are in the source. Line 312 says
;; ar$tha "has no meaning in the request form", so in a request the tempting value
;; is not a binding at all. And the table clauses at lines 209-218 enter exactly
;; one triplet, the sender's. Stage B §5 item 5 excludes the monitor role of lines
;; 337-348 for the related reason: its rule contradicts the target gate.
;;
;; `gated` abbreviates the hardware/protocol/optional-length conjunction that
;; probe 1 discharges in full.

(module learn-sender-only

  (def learn-sender-only
      [tbl: map[int,int]
       gated: bool
       skey: int sha: int
       tkey: int tha: int
       tpa: int mypa: int
       okey: int]
      -> map[int,int]

    (pre (!= tkey skey)
      :source "RFC 826 lines 210-213 — sender and target pairs are distinct keys in an exchange between two stations")
    (pre (and (!= okey skey) (!= okey tkey))
      :source "frame witness: okey ranges over keys that are neither pair in this packet")

    ;; [F1] The sender triplet is learned, on the merge path and the add path.
    (post (=> (and gated (or (map-has tbl skey) (= tpa mypa)))
              (and (map-has result skey) (= (map-get result skey) sha)))
      :source "RFC 826 lines 209-218 — merge the sender pair, or add the sender triplet when this node is the target")

    ;; [F2] The target pair is not learned. This is the clause the mutant breaks.
    (post (<=> (map-has result tkey) (map-has tbl tkey))
      :source "RFC 826 lines 209-218, 312 — only the sender triplet is entered; ar$tha has no meaning in a request")
    (post (=> (map-has tbl tkey) (= (map-get result tkey) (map-get tbl tkey)))
      :source "RFC 826 lines 209-218, 312 — only the sender triplet is entered; ar$tha has no meaning in a request")

    ;; [F3] Nothing else moves either.
    (post (<=> (map-has result okey) (map-has tbl okey))
      :source "RFC 826 lines 210-218 — only the sender pair's entry is written")
    (post (=> (map-has tbl okey) (= (map-get result okey) (map-get tbl okey)))
      :source "RFC 826 lines 210-218 — only the sender pair's entry is written")

    ;; [F4] The target gate, carried so the frame is not the only thing under test.
    (post (=> (and (not (map-has tbl skey)) (!= tpa mypa))
              (not (map-has result skey)))
      :source "RFC 826 line 214 — the target test gates the add")

    (if (and gated (or (map-has tbl skey) (= tpa mypa)))
        (map-put tbl skey sha)
        tbl)))
