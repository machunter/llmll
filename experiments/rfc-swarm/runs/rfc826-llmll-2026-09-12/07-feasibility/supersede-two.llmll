;; Stage H feasibility probe 5 — the joint invariant over two reception steps.
;;
;; Shape under test: the product/composition shape the architecture needs. Every
;; other probe is a single-step VC. This one threads the table through two
;; receptions in one body and states relations between the pre-state and the
;; post-post-state: supersession on a shared key, independence on distinct keys,
;; and a frame that has to survive both writes.
;;
;; Stage B recorded modeling decision O-1: "supersedes" means last-writer-wins
;; with respect to *step order*, because nothing in an ARP packet tells a receiver
;; which of two packets is newer. Step order here is the `let` sequencing, and it
;; appears in no clause as a value — which is the whole point of O-1.
;;
;; The two steps are written out rather than factored into a callee: the
;; strict-verified core rejects a call to a map-returning function, so a
;; composition probe has to inline what it composes. They are also not threaded
;; through a `let`: a `let` whose right-hand side is a map-valued `if` is refused
;; by the body-VC emitter (`Refused by: let`), while a `map-put` applied directly
;; to another `map-put` inside an `if` branch stays body-faithful. Composition in
;; this fragment is written as a nested store, not as a bound intermediate state.
;;
;; `gated1` / `gated2` abbreviate the hardware/protocol/optional-length
;; conjunction that probe 1 discharges in full.

(module supersede-two

  (def supersede-two
      [tbl: map[int,int]
       gated1: bool skey1: int sha1: int tpa1: int
       gated2: bool skey2: int sha2: int tpa2: int
       mypa: int
       okey: int]
      -> map[int,int]

    (pre (and (!= okey skey1) (!= okey skey2))
      :source "frame witness: okey ranges over keys neither reception writes")

    ;; [S1] Supersession. When both receptions are admitted and name the same
    ;; pair, the later hardware address is what the table holds.
    (post (=> (and gated1
                   (and gated2
                        (and (= skey1 skey2)
                             (or (map-has tbl skey1) (= tpa1 mypa)))))
              (and (map-has result skey2) (= (map-get result skey2) sha2)))
      :source "RFC 826 lines 231-234 — the new hardware address supersedes the old one; Stage B O-1")

    ;; [S2] The superseded value is gone, not merely shadowed. This is the clause
    ;; a first-writer-wins implementation breaks.
    (post (=> (and gated1
                   (and gated2
                        (and (= skey1 skey2)
                             (and (or (map-has tbl skey1) (= tpa1 mypa))
                                  (!= sha1 sha2)))))
              (!= (map-get result skey2) sha1))
      :source "RFC 826 lines 231-234, 443-445 — supersession, not accumulation")

    ;; [S3] Independence on distinct keys — the product half. Each reception's
    ;; outcome survives the other.
    (post (=> (and (!= skey1 skey2)
                   (and gated1 (or (map-has tbl skey1) (= tpa1 mypa))))
              (and (map-has result skey1) (= (map-get result skey1) sha1)))
      :source "RFC 826 lines 210-218 — each reception writes only its own sender pair")
    (post (=> (and (!= skey1 skey2)
                   (and gated2 (or (map-has tbl skey2) (= tpa2 mypa))))
              (and (map-has result skey2) (= (map-get result skey2) sha2)))
      :source "RFC 826 lines 210-218 — each reception writes only its own sender pair")

    ;; [S4] The target gate survives composition: a second reception not addressed
    ;; to this node still cannot create an entry.
    (post (=> (and (!= skey1 skey2)
                   (and (not (map-has tbl skey2)) (!= tpa2 mypa)))
              (not (map-has result skey2)))
      :source "RFC 826 line 214 — the target test gates the add at every step")

    ;; [S5] Frame across both steps.
    (post (<=> (map-has result okey) (map-has tbl okey))
      :source "RFC 826 lines 210-218 — nothing outside the two sender pairs moves")
    (post (=> (map-has tbl okey) (= (map-get result okey) (map-get tbl okey)))
      :source "RFC 826 lines 210-218 — nothing outside the two sender pairs moves")

    ;; A reception writes iff it is gated and either the sender pair is already
    ;; present (merge, lines 210-213) or this node is the target (add, 214-218).
    (if (and gated1 (or (map-has tbl skey1) (= tpa1 mypa)))
        ;; In this branch the first reception wrote skey1, so the second
        ;; reception's merge test on the intermediate table is
        ;; (skey2 = skey1) or (skey2 was already present). The select-over-store
        ;; step is written out because the emitter refuses a `map-has` applied to
        ;; a `map-put` in guard position.
        (if (and gated2 (or (= skey2 skey1) (or (map-has tbl skey2) (= tpa2 mypa))))
            (map-put (map-put tbl skey1 sha1) skey2 sha2)
            (map-put tbl skey1 sha1))
        (if (and gated2 (or (map-has tbl skey2) (= tpa2 mypa)))
            (map-put tbl skey2 sha2)
            tbl))))
