.stack-work/
dist-newstyle/
.DS_Store
target/
compiler/src/Main
generated/hangman/target/
generated/hangman/Cargo.lock
runtime/target/
runtime/Cargo.lock
generated/

# Remove runtime/ from tracking (moved to docs/archive)
runtime/

# Local agent workflows — not part of the project source
.agents/

# Outreach planning, drafts, and posting workspace — local only
outreach-workspace/
# Previously-tracked outreach drafts (moved to outreach-workspace/docs-outreach/)
docs/outreach/

# Example .verified.json sidecars — generated by llmll verify; only canonical
# benchmark sidecars are tracked (banking_ledger, erc20_token, totp_rfc6238).
examples/**/*.verified.json
!examples/banking_ledger/banking.llmll.verified.json
!examples/erc20_token/erc20_filled.ast.json.verified.json
!examples/totp_rfc6238/totp_filled.ast.json.verified.json

# Experiment fixture .verified.json sidecars — same rationale, no canonical
# exceptions in experiments/ (run artifacts under runs/ are the tracked record).
experiments/**/*.verified.json

# Local toolchain path overrides (machine-specific)
.env
tools/llmll-orchestra/.env
.vscode/
.claude/

# transient llmll checkout/verify runtime artifacts (R5 divergence sessions, locks, scratches)
*.llmll-lock.json
*.llmll-diverge.json
*.scratch.ast.json
*.scratch.llmll
*.sess-*
