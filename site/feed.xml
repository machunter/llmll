{%- comment -%}
The Atom feed for the series.

The posts are plain pages, not Jekyll `_posts`, so jekyll-feed (which minima's
<head> links as /feed.xml) found no entries and published an empty feed. This
file takes its place: jekyll-feed does not overwrite an existing feed.xml. The
entries come from _data/series.yml, the same list the byline and the
previous/next links read.
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  {%- assign latest = site.data.series | sort: "updated" | last %}
  <updated>{{ latest.updated | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {%- for p in site.data.series %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url | xml_escape }}</id>
    <published>{{ p.published | date_to_xmlschema }}</published>
    <updated>{{ p.updated | date_to_xmlschema }}</updated>
  </entry>
  {%- endfor %}
</feed>
