;; FALLBACK-ATTRIB-1: each function falls back, and W-BODY-FALLBACK names the
;; term that refused. The first four used to say "Refused by: if".
;; MUL-VAR-1 and DIV-VAR-1: a product (* x x) and a variable divisor are inside
;; the fragment now, so the refused term here is a ground zero divisor, which
;; still refuses (nonlinear:/).
(def-shell div-pos [x: int] -> int (post (>= result 0)) (if (>= x 0) (/ x 0) 0))
(def-shell div-let [x: int] -> int (post (>= result 0)) (if (>= x 0) (let [[y (/ x 0)]] y) 0))
(def-shell first-len [s: string] -> int (post (>= result 0)) (if (= s "a") (string-length (string-slice s 0 1)) 0))
(def-shell quot [x: int y: int] -> int (post (>= result 0)) (if (> x 0) (+ (/ x 0) 1) 0))
(def-shell if-arg [x: int] -> int (post (>= result 0)) (+ (if (> x 0) 1 2) 3))
;; The contract causes, which used to raise no warning.
(def-shell g [x: int] -> int x)
(def-shell post-call [x: int] -> int (post (>= (g result) 0)) x)
(def-shell pre-div [x: int] -> int (pre (>= (/ x 0) 0)) (post (>= result 0)) (if (>= x 0) x 0))
