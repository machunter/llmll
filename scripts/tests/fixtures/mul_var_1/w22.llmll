;; MUL-VAR-1 witness W22: rev3.py row "W22 4-factor monotone", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w22
  (export mv-w22)
  (def-shell mv-w22 [a: int b: int c: int d: int p: int q: int s: int t: int] -> int
    (pre (and (>= a 0) (and (>= b 0) (and (>= c 0) (and (>= d 0) (and (<= a p) (and (<= b q) (and (<= c s) (<= d t)))))))))
    (post (<= (* (* a b) (* c d)) (* (* p q) (* s t))))
    0))
