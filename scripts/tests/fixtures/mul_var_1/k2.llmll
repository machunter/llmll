;; MUL-VAR-1 witness K2: rev3.py row "K2 the same, channel fact split by if", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k2
  (export mv-k2)
  (def-shell mv-k2 [c: int w: int i: int] -> int
    (pre (and (= c 3) (and (>= w 1) (and (>= i 0) (< i (* 3 w))))))
    (post (< i (* c w)))
    0))
