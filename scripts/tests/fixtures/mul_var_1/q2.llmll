;; MUL-VAR-1 witness Q2: rev3.py row "Q2 alias both factors", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q2
  (export mv-q2)
  (def-shell mv-q2 [w: int h: int s: int t: int] -> int
    (pre (and (= s h) (= t w)))
    (post (= (* s t) (* w h)))
    0))
