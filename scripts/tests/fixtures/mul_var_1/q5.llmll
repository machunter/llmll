;; MUL-VAR-1 witness Q5: rev3.py row "Q5 chained constant", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q5
  (export mv-q5)
  (def-shell mv-q5 [w: int h: int k: int ch: int n: int] -> int
    (pre (and (= k 3) (and (= ch k) (= n (* w (* h ch))))))
    (post (= n (* k (* h w))))
    0))
