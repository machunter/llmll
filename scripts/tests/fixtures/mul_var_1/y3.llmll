;; MUL-VAR-1 witness Y3: rev3.py row "Y3 V-plane offset inside the frame", group Y, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-y3
  (export mv-y3)
  (def-shell mv-y3 [w: int h: int cw: int ch: int y: int x: int n: int r: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (= cw (/ (+ w 1) 2)) (and (= ch (/ (+ h 1) 2)) (and (= n (+ (* w h) (* 2 (* cw ch)))) (and (>= y 0) (and (>= x 0) (and (< y ch) (and (< x cw) (= r (+ (* w h) (+ (* cw ch) (+ (* y cw) x))))))))))))))
    (post (and (>= r 0) (< r n)))
    0))
