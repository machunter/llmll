;; MUL-VAR-1 witness N1: rev3.py row "N1 regroup wrong", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n1
  (export mv-n1)
  (def-shell mv-n1 [y: int w: int c: int r: int] -> int
    (pre (= r (* (* y w) c)))
    (post (= r (* y (* w y))))
    0))
