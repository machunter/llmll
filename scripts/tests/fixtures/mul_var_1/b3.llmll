;; MUL-VAR-1 witness B3: hand-written restatement of rev3.py row "B3 strLen holds the product", group B, truth true.
;; strLen s is (string-length s).
(module mv-b3
  (export mv-b3)
  (def-shell mv-b3 [w: int h: int y: int x: int s: string] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= (string-length s) (* w h)))))))
    (post (< (+ (* y w) x) (string-length s)))
    0))
