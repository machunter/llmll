;; MUL-VAR-1 witness O1: rev3.py row "O1 two definitions of x", group O, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-o1
  (export mv-o1)
  (def-shell mv-o1 [x: int y: int z: int w: int] -> int
    (pre (and (= x (+ y 1)) (= x (* 2 z))))
    (post (= (* x w) (* 2 (* z w))))
    0))
