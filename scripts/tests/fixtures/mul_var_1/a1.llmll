;; MUL-VAR-1 witness A1: rev3.py row "A1 abs as a factor", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a1
  (export mv-a1)
  (def-shell mv-a1 [dx: int st: int] -> int
    (pre (>= st 0))
    (post (>= (* (abs dx) st) 0))
    0))
