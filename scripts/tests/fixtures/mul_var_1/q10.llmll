;; MUL-VAR-1 witness Q10: rev3.py row "Q10 narrow row in wide stride", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q10
  (export mv-q10)
  (def-shell mv-q10 [w: int h: int y: int x: int st: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (>= st w))))))
    (post (< (+ (* y w) x) (* h st)))
    0))
