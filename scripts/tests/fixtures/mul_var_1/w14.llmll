;; MUL-VAR-1 witness W14: rev3.py row "W14 chroma covers (4cw*ch >= w*h)", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w14
  (export mv-w14)
  (def-shell mv-w14 [w: int h: int] -> int
    (pre (and (>= w 1) (>= h 1)))
    (post (>= (* 4 (* (/ (+ w 1) 2) (/ (+ h 1) 2))) (* w h)))
    0))
