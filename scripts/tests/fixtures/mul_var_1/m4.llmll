;; MUL-VAR-1 witness M4: rev3.py row "M4 no lower bound", group M, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-m4
  (export mv-m4)
  (def-shell mv-m4 [w: int h: int y: int x: int r: int] -> int
    (pre (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* y w) x))))))
    (post (>= r 0))
    0))
