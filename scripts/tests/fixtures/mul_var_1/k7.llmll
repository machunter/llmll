;; MUL-VAR-1 witness K7: rev3.py row "K7 half-scale of a product", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k7
  (export mv-k7)
  (def-shell mv-k7 [x: int sw: int w: int] -> int
    (pre (and (>= x 0) (and (< x w) (>= sw 0))))
    (post (<= (/ (* x sw) 2) (/ (* w sw) 2)))
    0))
