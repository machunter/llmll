;; MUL-VAR-1 witness BF6: hand-written restatement of rev3.py row "BF6 equal strings, length off by one", group BF, truth false.
;; strLen is (string-length _).
(module mv-bf6
  (export mv-bf6)
  (def-shell mv-bf6 [w: int h: int s: string t: string] -> int
    (pre (and (= s t) (>= (string-length s) (* w h))))
    (post (>= (string-length t) (+ (* w h) 1)))
    0))
