;; MUL-VAR-1 witness AF3: rev3.py row "AF3 if factor with a negative branch", group AF, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-af3
  (export mv-af3)
  (def-shell mv-af3 [x: int w: int] -> int
    (pre (>= w 0))
    (post (>= (* (if (> x 0) x (- 0 1)) w) 0))
    0))
