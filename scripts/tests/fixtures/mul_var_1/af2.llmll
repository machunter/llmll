;; MUL-VAR-1 witness AF2: rev3.py row "AF2 mod bound off by one", group AF, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-af2
  (export mv-af2)
  (def-shell mv-af2 [i: int w: int] -> int
    (pre (>= w 1))
    (post (< (* (mod i 3) w) (* 2 w)))
    0))
