;; MUL-VAR-1 witness A6: rev3.py row "A6 abs offsets in a raster", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a6
  (export mv-a6)
  (def-shell mv-a6 [dy: int dx: int w: int h: int] -> int
    (pre (and (< (abs dy) h) (and (< (abs dx) w) (>= w 1))))
    (post (< (+ (* (abs dy) w) (abs dx)) (* h w)))
    0))
