;; MUL-VAR-1 witness W12: rev3.py row "W12 next row", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w12
  (export mv-w12)
  (def-shell mv-w12 [y: int w: int x: int off: int r: int] -> int
    (pre (and (= off (+ (* y w) x)) (and (= x (- w 1)) (= r (+ off 1)))))
    (post (= r (* (+ y 1) w)))
    0))
