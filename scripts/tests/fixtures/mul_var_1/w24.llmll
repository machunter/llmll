;; MUL-VAR-1 witness W24: rev3.py row "W24 x*x+y*y=z*z parity", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w24
  (export mv-w24)
  (def-shell mv-w24 [x: int y: int z: int] -> int
    (pre (and (= (+ (* x x) (* y y)) (* z z)) (and (> x 0) (and (> y 0) (> z 0)))))
    (post (not (= (+ (* 4 (* x y)) 2) (* 4 (* z z)))))
    0))
