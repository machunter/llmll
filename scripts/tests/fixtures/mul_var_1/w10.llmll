;; MUL-VAR-1 witness W10: rev3.py row "W10 frame i of k", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w10
  (export mv-w10)
  (def-shell mv-w10 [f: int i: int k: int r: int] -> int
    (pre (and (>= f 0) (and (>= i 0) (and (< i k) (= r (* i f))))))
    (post (and (>= r 0) (<= (+ r f) (* k f))))
    0))
