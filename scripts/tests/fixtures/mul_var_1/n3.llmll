;; MUL-VAR-1 witness N3: rev3.py row "N3 rotate90 wrong stride", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n3
  (export mv-n3)
  (def-shell mv-n3 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* x w) (- (- h 1) y))))))))
    (post (< r (* w h)))
    0))
