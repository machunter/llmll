;; MUL-VAR-1 witness P5: rev3.py row "P5 let constant channel", group P, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-p5
  (export mv-p5)
  (def-shell mv-p5 [w: int h: int ch: int n: int] -> int
    (pre (and (= ch 3) (= n (* (* w h) ch))))
    (post (= n (* 3 (* w h))))
    0))
