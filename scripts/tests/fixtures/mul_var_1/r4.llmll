;; MUL-VAR-1 witness R4: rev3.py row "R4 bound from product pre", group R, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-r4
  (export mv-r4)
  (def-shell mv-r4 [w: int h: int n: int] -> int
    (pre (and (>= w 0) (and (>= h 0) (and (<= (* w h) 268435456) (= n (* 3 (* w h)))))))
    (post (<= n 9223372036854775807))
    0))
