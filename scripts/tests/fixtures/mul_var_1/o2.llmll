;; MUL-VAR-1 witness O2: rev3.py row "O2 stride named twice", group O, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-o2
  (export mv-o2)
  (def-shell mv-o2 [w: int pad: int cw: int st: int y: int] -> int
    (pre (and (= st (+ w pad)) (= st (* 2 cw))))
    (post (= (* y st) (* 2 (* y cw))))
    0))
