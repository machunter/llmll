;; MUL-VAR-1 witness N10: rev3.py row "N10 narrow row, stride too small", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n10
  (export mv-n10)
  (def-shell mv-n10 [w: int h: int y: int x: int st: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (>= st 0))))))
    (post (< (+ (* y w) x) (* h st)))
    0))
