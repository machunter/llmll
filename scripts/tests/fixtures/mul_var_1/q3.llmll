;; MUL-VAR-1 witness Q3: rev3.py row "Q3 equation written reversed", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q3
  (export mv-q3)
  (def-shell mv-q3 [w: int h: int y: int x: int c: int ch: int st: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= c 0) (and (< c ch) (and (= (* w ch) st) (= r (+ (+ (* y st) (* x ch)) c))))))))))
    (post (< r (* h st)))
    0))
