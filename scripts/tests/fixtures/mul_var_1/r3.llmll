;; MUL-VAR-1 witness R3: rev3.py row "R3 four-plane total", group R, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-r3
  (export mv-r3)
  (def-shell mv-r3 [w: int h: int a: int n: int r: int y: int x: int p: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= p 0) (and (< p 4) (and (= a (* w h)) (and (= n (* 4 a)) (= r (+ (* p a) (+ (* y w) x))))))))))))
    (post (and (>= r 0) (< r n)))
    0))
