;; MUL-VAR-1 witness W4: rev3.py row "W4 stride", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w4
  (export mv-w4)
  (def-shell mv-w4 [w: int h: int y: int x: int c: int st: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= st (* 3 w)) (and (>= c 0) (and (< c 3) (= r (+ (+ (* y st) (* 3 x)) c))))))))))
    (post (and (>= r 0) (< r (* h st))))
    0))
