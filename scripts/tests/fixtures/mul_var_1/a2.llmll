;; MUL-VAR-1 witness A2: rev3.py row "A2 mod as a factor", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a2
  (export mv-a2)
  (def-shell mv-a2 [i: int w: int] -> int
    (pre (>= w 0))
    (post (>= (* (mod i 3) w) 0))
    0))
