;; MUL-VAR-1 witness KF3: rev3.py row "KF3 blur row above at y=0", group KF, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-kf3
  (export mv-kf3)
  (def-shell mv-kf3 [y: int st: int x: int] -> int
    (pre (and (>= y 0) (and (>= st 1) (and (>= x 0) (< x st)))))
    (post (>= (+ (* (- y 1) st) x) 0))
    0))
