;; MUL-VAR-1 witness P7: rev3.py row "P7 cancel", group P, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-p7
  (export mv-p7)
  (def-shell mv-p7 [w: int h: int a: int b: int] -> int
    (pre (and (>= w 1) (and (= a (* w h)) (= b (* h w)))))
    (post (= (- a b) 0))
    0))
