;; MUL-VAR-1 witness W15: rev3.py row "W15 down2 (w/2)*(h/2) <= w*h", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w15
  (export mv-w15)
  (def-shell mv-w15 [w: int h: int] -> int
    (pre (and (>= w 0) (>= h 0)))
    (post (<= (* (/ w 2) (/ h 2)) (* w h)))
    0))
