;; MUL-VAR-1 witness Y6: rev3.py row "Y6 frame at most 3 luma", group Y, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-y6
  (export mv-y6)
  (def-shell mv-y6 [w: int h: int cw: int ch: int n: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (= cw (/ (+ w 1) 2)) (and (= ch (/ (+ h 1) 2)) (= n (+ (* w h) (* 2 (* cw ch)))))))))
    (post (<= n (* 3 (* w h))))
    0))
