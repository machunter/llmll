;; MUL-VAR-1 witness Q15: rev3.py row "Q15 total bound by a limit", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q15
  (export mv-q15)
  (def-shell mv-q15 [w: int h: int ch: int lim: int] -> int
    (pre (and (>= w 0) (and (>= h 0) (and (>= ch 0) (and (<= (* w h) lim) (<= ch 4))))))
    (post (<= (* (* w h) ch) (* 4 lim)))
    0))
