;; MUL-VAR-1 witness N6: rev3.py row "N6 linear bug, callee post holds product", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n6
  (export mv-n6)
  (def-shell mv-n6 [w: int h: int p: int x: int] -> int
    (pre (and (= p (* w h)) (>= x 0)))
    (post (>= x 1))
    0))
