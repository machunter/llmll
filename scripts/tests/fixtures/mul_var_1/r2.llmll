;; MUL-VAR-1 witness R2: rev3.py row "R2 BMP row stride", group R, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-r2
  (export mv-r2)
  (def-shell mv-r2 [w: int bpp: int st: int] -> int
    (pre (and (>= w 1) (and (>= bpp 1) (= st (* 4 (/ (+ (* w bpp) 31) 32))))))
    (post (>= (* 8 st) (* w bpp)))
    0))
