;; MUL-VAR-1 witness K10: rev3.py row "K10 RGB to row index, product of quotient", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k10
  (export mv-k10)
  (def-shell mv-k10 [i: int w: int y: int] -> int
    (pre (and (>= i 0) (and (< i (* 3 w)) (>= y 0))))
    (post (>= (* (/ i 3) y) 0))
    0))
