;; MUL-VAR-1 witness Q4: hand-written restatement of rev3.py row "Q4 buffer length as function", group Q, truth true.
;; bytesLen b is (bytes-length b); LLMLL bytes are fixed length, so b is bytes[64].
(module mv-q4
  (export mv-q4)
  (def-shell mv-q4 [w: int h: int y: int x: int b: bytes[64]] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= (bytes-length b) (* w h)))))))
    (post (and (>= (+ (* y w) x) 0) (< (+ (* y w) x) (bytes-length b))))
    0))
