;; MUL-VAR-1 witness Y4: rev3.py row "Y4 frame at least luma+2", group Y, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-y4
  (export mv-y4)
  (def-shell mv-y4 [w: int h: int cw: int ch: int n: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (= cw (/ (+ w 1) 2)) (and (= ch (/ (+ h 1) 2)) (= n (+ (* w h) (* 2 (* cw ch)))))))))
    (post (>= n (+ (* w h) 2)))
    0))
