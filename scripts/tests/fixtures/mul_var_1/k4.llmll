;; MUL-VAR-1 witness K4: rev3.py row "K4 sample count below header limit", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k4
  (export mv-k4)
  (def-shell mv-k4 [c: int w: int h: int lim: int] -> int
    (pre (and (>= c 1) (and (>= w 1) (and (>= h 1) (<= (* (* w h) c) lim)))))
    (post (<= (* w h) lim))
    0))
