;; MUL-VAR-1 witness N8: rev3.py row "N8 regrouped alias, wrong factor", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n8
  (export mv-n8)
  (def-shell mv-n8 [w: int h: int ch: int st: int y: int] -> int
    (pre (and (= st (* w ch)) (and (>= y 0) (< y h))))
    (post (< (* y st) (* (* w h) y)))
    0))
