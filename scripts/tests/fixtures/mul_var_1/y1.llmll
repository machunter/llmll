;; MUL-VAR-1 witness Y1: rev3.py row "Y1 chroma plane <= luma plane", group Y, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-y1
  (export mv-y1)
  (def-shell mv-y1 [w: int h: int cw: int ch: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (= cw (/ (+ w 1) 2)) (= ch (/ (+ h 1) 2))))))
    (post (<= (* cw ch) (* w h)))
    0))
