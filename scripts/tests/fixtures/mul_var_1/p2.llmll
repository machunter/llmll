;; MUL-VAR-1 witness P2: rev3.py row "P2 regroup value", group P, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-p2
  (export mv-p2)
  (def-shell mv-p2 [y: int w: int c: int r: int] -> int
    (pre (= r (* (* y w) c)))
    (post (= r (* y (* w c))))
    0))
