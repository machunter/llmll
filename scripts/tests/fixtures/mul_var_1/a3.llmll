;; MUL-VAR-1 witness A3: rev3.py row "A3 mod below its divisor, scaled", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a3
  (export mv-a3)
  (def-shell mv-a3 [i: int w: int] -> int
    (pre (>= w 1))
    (post (< (* (mod i 3) w) (* 3 w)))
    0))
