;; MUL-VAR-1 witness A5: rev3.py row "A5 product in an if branch", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a5
  (export mv-a5)
  (def-shell mv-a5 [x: int w: int] -> int
    (pre (>= w 0))
    (post (>= (if (> x 0) (* x w) 0) 0))
    0))
