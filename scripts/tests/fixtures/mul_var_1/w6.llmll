;; MUL-VAR-1 witness W6: rev3.py row "W6 crop size", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w6
  (export mv-w6)
  (def-shell mv-w6 [w: int h: int ox: int oy: int cw: int ch: int] -> int
    (pre (and (>= ox 0) (and (>= oy 0) (and (>= cw 0) (and (>= ch 0) (and (<= (+ ox cw) w) (<= (+ oy ch) h)))))))
    (post (<= (* cw ch) (* w h)))
    0))
