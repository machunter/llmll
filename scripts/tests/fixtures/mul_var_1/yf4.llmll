;; MUL-VAR-1 witness YF4: rev3.py row "YF4 chroma floor, n/2 not (n+1)/2", group YF, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-yf4
  (export mv-yf4)
  (def-shell mv-yf4 [w: int h: int cw: int ch: int y: int x: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (= cw (/ w 2)) (and (= ch (/ h 2)) (and (>= y 0) (< y h)))))))
    (post (>= (* cw ch) 1))
    0))
