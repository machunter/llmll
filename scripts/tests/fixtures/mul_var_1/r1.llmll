;; MUL-VAR-1 witness R1: rev3.py row "R1 rotate90 offset", group R, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-r1
  (export mv-r1)
  (def-shell mv-r1 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* x h) (- (- h 1) y))))))))
    (post (and (>= r 0) (< r (* w h))))
    0))
