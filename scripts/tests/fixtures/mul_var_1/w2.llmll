;; MUL-VAR-1 witness W2: rev3.py row "W2 buffer len w*h*3", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w2
  (export mv-w2)
  (def-shell mv-w2 [w: int h: int r: int] -> int
    (pre (and (>= w 0) (and (>= h 0) (= r (* (* w h) 3)))))
    (post (and (>= r 0) (= r (* 3 (* h w)))))
    0))
