;; MUL-VAR-1 witness Q9: rev3.py row "Q9 equation in a disjunct", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q9
  (export mv-q9)
  (def-shell mv-q9 [a: int d: int b: int] -> int
    (pre (or (= a d) (= a (+ d 0))))
    (post (= (* a b) (* d b)))
    0))
