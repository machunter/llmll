;; MUL-VAR-1 witness W8: rev3.py row "W8 chroma offset", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w8
  (export mv-w8)
  (def-shell mv-w8 [w: int h: int cy: int cx: int r: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (>= cy 0) (and (< cy (/ (+ h 1) 2)) (and (>= cx 0) (and (< cx (/ (+ w 1) 2)) (= r (+ (* cy (/ (+ w 1) 2)) cx)))))))))
    (post (and (>= r 0) (< r (* (/ (+ w 1) 2) (/ (+ h 1) 2)))))
    0))
