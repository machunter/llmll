;; MUL-VAR-1 witness M3: rev3.py row "M3 swapped stride y*h", group M, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-m3
  (export mv-m3)
  (def-shell mv-m3 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* y h) x)))))))
    (post (< r (* w h)))
    0))
