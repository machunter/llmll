;; MUL-VAR-1 witness W3: rev3.py row "W3 crux y*w+x < w*h", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w3
  (export mv-w3)
  (def-shell mv-w3 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* y w) x)))))))
    (post (and (>= r 0) (< r (* w h))))
    0))
