;; MUL-VAR-1 witness K12: rev3.py row "K12 stride equals padded row, two names", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k12
  (export mv-k12)
  (def-shell mv-k12 [w: int c: int pad: int st: int y: int x: int] -> int
    (pre (and (>= w 1) (and (>= c 1) (and (>= pad 0) (and (= st (+ (* w c) pad)) (and (>= y 0) (and (>= x 0) (< x w))))))))
    (post (<= (+ (* y st) (* x c)) (* (+ y 1) st)))
    0))
