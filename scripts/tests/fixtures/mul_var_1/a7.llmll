;; MUL-VAR-1 witness A7: rev3.py row "A7 interleaved channel by mod", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a7
  (export mv-a7)
  (def-shell mv-a7 [i: int w: int h: int y: int] -> int
    (pre (and (>= y 0) (and (< y h) (>= w 1))))
    (post (< (+ (* y (* 3 w)) (mod i 3)) (* h (* 3 w))))
    0))
