;; MUL-VAR-1 witness N2: rev3.py row "N2 buffer short by one row", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n2
  (export mv-n2)
  (def-shell mv-n2 [w: int h: int y: int x: int c: int ch: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= c 0) (and (<= c ch) (= r (+ (* (+ (* y w) x) ch) c)))))))))
    (post (< r (* h (* w ch))))
    0))
