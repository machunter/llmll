;; MUL-VAR-1 witness M2: rev3.py row "M2 y<=h", group M, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-m2
  (export mv-m2)
  (def-shell mv-m2 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (<= y h) (and (>= x 0) (and (< x w) (= r (+ (* y w) x)))))))
    (post (< r (* w h)))
    0))
