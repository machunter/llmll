;; MUL-VAR-1 witness N5: hand-written restatement of rev3.py row "N5 bytes read off by one, value", group N, truth false.
;; b is bytes[64]. The read in the pre is out of bounds in the counterexample (CLAUSE-WELLDEF-1).
(module mv-n5
  (export mv-n5)
  (def-shell mv-n5 [w: int h: int y: int x: int b: bytes[64] v: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (<= x w) (and (= (bytes-length b) (* w h)) (= v (bytes-get b (+ (* y w) x)))))))))
    (post (< (+ (* y w) x) (bytes-length b)))
    0))
