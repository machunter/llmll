;; MUL-VAR-1 witness AF1: rev3.py row "AF1 abs product can be zero", group AF, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-af1
  (export mv-af1)
  (def-shell mv-af1 [dx: int st: int] -> int
    (pre (>= st 0))
    (post (> (* (abs dx) st) 0))
    0))
