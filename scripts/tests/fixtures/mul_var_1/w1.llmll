;; MUL-VAR-1 witness W1: rev3.py row "W1 commute w*h = h*w", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w1
  (export mv-w1)
  (def-shell mv-w1 [w: int h: int r: int] -> int
    (pre (= r (* h w)))
    (post (= r (* w h)))
    0))
