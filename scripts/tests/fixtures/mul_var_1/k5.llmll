;; MUL-VAR-1 witness K5: rev3.py row "K5 row above in a blur", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k5
  (export mv-k5)
  (def-shell mv-k5 [y: int st: int x: int] -> int
    (pre (and (>= y 1) (and (>= st 0) (and (>= x 0) (< x st)))))
    (post (>= (+ (* (- y 1) st) x) 0))
    0))
