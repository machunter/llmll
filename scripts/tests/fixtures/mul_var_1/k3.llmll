;; MUL-VAR-1 witness K3: rev3.py row "K3 row offset, variable channels", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k3
  (export mv-k3)
  (def-shell mv-k3 [c: int w: int h: int y: int k: int r: int] -> int
    (pre (and (>= c 1) (and (>= w 1) (and (>= y 0) (and (< y h) (and (>= k 0) (and (< k (* c w)) (= r (+ (* y (* c w)) k)))))))))
    (post (and (>= r 0) (< r (* h (* c w)))))
    0))
