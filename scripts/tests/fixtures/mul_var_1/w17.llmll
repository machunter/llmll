;; MUL-VAR-1 witness W17: rev3.py row "W17 transpose offset", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w17
  (export mv-w17)
  (def-shell mv-w17 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* x h) y)))))))
    (post (and (>= r 0) (< r (* w h))))
    0))
