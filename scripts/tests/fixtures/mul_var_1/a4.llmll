;; MUL-VAR-1 witness A4: rev3.py row "A4 max as a factor", group A, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-a4
  (export mv-a4)
  (def-shell mv-a4 [x: int w: int] -> int
    (pre (>= w 0))
    (post (>= (* (max x 0) w) 0))
    0))
