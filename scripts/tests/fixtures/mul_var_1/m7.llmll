;; MUL-VAR-1 witness M7: rev3.py row "M7 wrong chroma w/2", group M, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-m7
  (export mv-m7)
  (def-shell mv-m7 [w: int h: int cy: int cx: int r: int] -> int
    (pre (and (>= w 1) (and (>= h 1) (and (>= cy 0) (and (< cy (/ (+ h 1) 2)) (and (>= cx 0) (and (< cx (/ (+ w 1) 2)) (= r (+ (* cy (/ w 2)) cx)))))))))
    (post (< r (* (/ w 2) (/ h 2))))
    0))
