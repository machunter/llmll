;; MUL-VAR-1 witness N7: rev3.py row "N7 linear bug beside a hard fact", group N, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-n7
  (export mv-n7)
  (def-shell mv-n7 [u: int v: int q: int x: int] -> int
    (pre (and (> u 0) (and (> v 0) (and (= q (* u u)) (>= x 0)))))
    (post (>= x 1))
    0))
