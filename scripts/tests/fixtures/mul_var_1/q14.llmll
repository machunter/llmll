;; MUL-VAR-1 witness Q14: rev3.py row "Q14 row end in a stride", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q14
  (export mv-q14)
  (def-shell mv-q14 [w: int h: int y: int x: int st: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= st w) (>= h 0)))))))
    (post (<= (+ (* y st) x) (* h st)))
    0))
