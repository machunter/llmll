;; MUL-VAR-1 witness N4: hand-written restatement of rev3.py row "N4 bytes-get off by one", group N, truth false.
;; b is bytes[64].
(module mv-n4
  (export mv-n4)
  (def-shell mv-n4 [w: int h: int y: int x: int b: bytes[64]] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (<= x w) (= (bytes-length b) (* w h)))))))
    (post (< (+ (* y w) x) (bytes-length b)))
    0))
