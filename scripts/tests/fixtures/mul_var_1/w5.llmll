;; MUL-VAR-1 witness W5: rev3.py row "W5 channels var", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w5
  (export mv-w5)
  (def-shell mv-w5 [w: int h: int y: int x: int c: int ch: int p: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (and (>= c 0) (and (< c ch) (and (= p (+ (* y w) x)) (= r (+ (* p ch) c))))))))))
    (post (and (>= r 0) (< r (* (* w h) ch))))
    0))
