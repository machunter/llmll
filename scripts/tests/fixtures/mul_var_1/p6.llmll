;; MUL-VAR-1 witness P6: rev3.py row "P6 commuted aliases, any sign", group P, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-p6
  (export mv-p6)
  (def-shell mv-p6 [a: int b: int c: int d: int r: int] -> int
    (pre (and (= a d) (and (= b c) (= r (* a b)))))
    (post (= r (* c d)))
    0))
