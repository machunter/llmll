;; MUL-VAR-1 witness Q1: rev3.py row "Q1 next-row regrouped", group Q, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-q1
  (export mv-q1)
  (def-shell mv-q1 [y: int w: int c: int] -> int
    (pre (and (>= y 0) (and (>= w 0) (>= c 0))))
    (post (= (* (+ y 1) (* w c)) (+ (* y (* c w)) (* c w))))
    0))
