;; MUL-VAR-1 witness M6: rev3.py row "M6 w*w = w*h", group M, truth false.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-m6
  (export mv-m6)
  (def-shell mv-m6 [w: int h: int r: int] -> int
    (pre (= r (* w w)))
    (post (= r (* w h)))
    0))
