;; MUL-VAR-1 witness W16: rev3.py row "W16 hflip offset", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w16
  (export mv-w16)
  (def-shell mv-w16 [w: int h: int y: int x: int r: int] -> int
    (pre (and (>= y 0) (and (< y h) (and (>= x 0) (and (< x w) (= r (+ (* y w) (- (- w 1) x))))))))
    (post (and (>= r 0) (< r (* w h))))
    0))
