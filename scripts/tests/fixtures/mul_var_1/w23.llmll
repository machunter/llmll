;; MUL-VAR-1 witness W23: rev3.py row "W23 irrational: x*x != 2*y*y", group W, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-w23
  (export mv-w23)
  (def-shell mv-w23 [x: int y: int] -> int
    (pre (and (> x 0) (> y 0)))
    (post (not (= (* x x) (* 2 (* y y)))))
    0))
