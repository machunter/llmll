;; MUL-VAR-1 witness O3: rev3.py row "O3 and in a pre, two products", group O, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-o3
  (export mv-o3)
  (def-shell mv-o3 [n: int w: int h: int c: int] -> int
    (pre (and (= n (* w h)) (= n (* h c))))
    (post (= (* n w) (* w (* h c))))
    0))
