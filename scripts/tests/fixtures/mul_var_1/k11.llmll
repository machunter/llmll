;; MUL-VAR-1 witness K11: rev3.py row "K11 quotient below width", group K, truth true.
;; Generated by scripts/mulvar/to_llmll.py. The post never names result, so the body VC is pre => post.
(module mv-k11
  (export mv-k11)
  (def-shell mv-k11 [i: int w: int] -> int
    (pre (and (>= i 0) (and (>= w 1) (< i (* 3 w)))))
    (post (< (/ i 3) w))
    0))
