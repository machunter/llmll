;; AND-GUARD-PRE-1: each body calls map-get or bytes-get in a later operand of
;; `and`, `or` or `=>`, where an earlier operand establishes the call's pre.
;; The call runs only when the earlier operand lets it, so each pre holds.
;; Before the fix the call was hoisted above the operator and its pre was
;; required on every path: each function was refuted at its call-site pre.

(def w1 [r: map[int,int] i: int] -> int
  (post (>= result 0))
  (if (and (map-has r i) (>= (map-get r i) 0)) 1 0))

(def a04 [r: map[int,int] i: int] -> int
  (post (>= result 0))
  (if (and (map-has r i) (and (>= i 0) (>= (map-get r i) 0))) 1 0))

(def a05 [r: map[int,int] i: int] -> int
  (post (>= result 0))
  (if (or (not (map-has r i)) (>= (map-get r i) 0)) 1 0))

(def a06 [r: map[int,int] i: int] -> int
  (post (>= result 0))
  (if (not (and (map-has r i) (< (map-get r i) 0))) 1 0))

(def a07 [r: map[int,int] i: int] -> int
  (post (>= result 0))
  (let [(ok (and (map-has r i) (>= (map-get r i) 0)))] (if ok 1 0)))

(def a11 [b: bytes[8] i: int] -> int
  (post (>= result 0))
  (if (and (>= i 0) (and (< i 8) (>= (bytes-get b i) 0))) 1 0))

(def a12 [b: bytes[8] i: int] -> int
  (post (>= result 0))
  (if (=> (and (>= i 0) (< i 8)) (>= (bytes-get b i) 0)) 1 0))

(def b08 [r: map[int,int] i: int] -> bool
  (post (=> result (map-has r i)))
  (and (map-has r i) (>= (map-get r i) 0)))
