;; EVAL-STRICT-1 invariant, rule 3 (strings): a string is a full value, so a failing piece of string-concat-many is evaluated although only emptiness is read.
(import wasi.io (capability stdout :deterministic false))
(def-shell use [s: int] -> bool (string-empty? (string-concat-many (list-map [1 2] (fn [x: int] (if (= x 2) (int-to-string (unwrap (string-to-int "bad-str"))) "a"))))))
(def-main :mode console
  :init (pair 0 (wasi.io.stdout (if (use 0) "true" "false")))
  :step (fn [s: int line: string _r: Response] (pair s (wasi.io.stdout ""))))
