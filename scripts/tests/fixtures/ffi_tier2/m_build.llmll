(import wasi.io (capability stdout))
(import c.stdlib (interface [
  [rand-of (fn [x: int] -> int)]
]))
(def-shell st [s: int r: Response] -> (int, Command) (pair (+ s 1) (wasi.io.stdout "|")))
(def-shell fin [s: int] -> bool (>= s 1))
(def-main :mode cli :init (pair 0 (wasi.io.stdout (int-to-string (rand-of 5)))) :step st :done? fin)
