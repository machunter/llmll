;; ABSTRACTION-VERDICT-1 A1: two equal calls to a contracted g. The post holds
;; for every pure g. Since CALL-CONGRUENCE-1 the VC knows equal calls agree, so
;; h is verified. g is proved.
(def-shell g [x: int] -> int (post (>= result 0)) (if (< x 0) (- 0 x) x))
(def-shell h [a: int] -> int (post (= result 0)) (- (g a) (g a)))
