;; ABSTRACTION-VERDICT-1 A4: the stated cost. The post is false (f 4 = -1),
;; but its only refutation needs the two self-calls to be unrelated, so it falls
;; back as abstraction:app:f instead of refuted.
(def-shell f [n: int] -> int (pre (>= n 0)) (post (>= result 0)) (if (< n 2) n (- (f (- n 1)) (f (- n 2)))))
