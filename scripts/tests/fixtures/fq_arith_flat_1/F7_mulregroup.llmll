;; FQ-ARITH-FLAT-1 F7: false. 2 * ((a / 2) * 3) is not ((2 * a) / 2) * 3. Refuting input: (f 1) gives 3, the post says 0.
;; A printer that regroups the right product as `2 * a / 2 * 3` proves it; the solver reads that as ((2 * a) / 2) * 3.
(def f [a: int] -> int (post (= result (* 2 (* (/ a 2) 3)))) (* (/ (* 2 a) 2) 3))
