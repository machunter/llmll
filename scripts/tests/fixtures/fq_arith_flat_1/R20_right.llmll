;; FQ-ARITH-FLAT-1 R20: true. A 20-term right-nested sum beside a trivial function.
;; On llmll 0.38.0 with --time-limit 15 the file stops at the limit (exit 5).
(def good [y: int] -> int (post (= result y)) y)
(def s [x0: int x1: int x2: int x3: int x4: int x5: int x6: int x7: int x8: int x9: int x10: int x11: int x12: int x13: int x14: int x15: int x16: int x17: int x18: int x19: int] -> int (post (= result (+ x0 (+ x1 (+ x2 (+ x3 (+ x4 (+ x5 (+ x6 (+ x7 (+ x8 (+ x9 (+ x10 (+ x11 (+ x12 (+ x13 (+ x14 (+ x15 (+ x16 (+ x17 (+ x18 x19))))))))))))))))))))) (+ x0 (+ x1 (+ x2 (+ x3 (+ x4 (+ x5 (+ x6 (+ x7 (+ x8 (+ x9 (+ x10 (+ x11 (+ x12 (+ x13 (+ x14 (+ x15 (+ x16 (+ x17 (+ x18 x19))))))))))))))))))))
