;; ABSTRACTION-LEN-EXACT-1 witness mk_dep_len (crm plan Rev 2); a fallback after CALL-RESULT-MARK-1.
(def-shell dep-make [b: bytes] -> int
  (pre (and (>= (bytes-length b) 1) (= (bytes-get b 0) 0)))
  (post (>= result 0))
  (let [(h (bytes-slice b 0 1))
        (k (bytes-get h 0))
        (m (bytes-make k 0))]
    (bytes-get b (+ (bytes-length m) (- (bytes-length b) 1)))))
