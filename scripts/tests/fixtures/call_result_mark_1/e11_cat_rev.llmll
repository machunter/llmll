;; ABSTRACTION-LEN-EXACT-1 witness E11-R: E11 with the operands swapped; the same answer, refuted.
(def-shell cat-at [b: bytes s: int] -> int
  (pre (and (>= s 0) (<= s (bytes-length b))))
  (post (>= result 0))
  (let [(y (bytes-slice b s (bytes-length b)))
        (x (bytes-slice b 0 s))
        (z (bytes-concat y x))]
    (bytes-get z (bytes-length b))))
