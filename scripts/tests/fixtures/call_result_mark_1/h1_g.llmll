;; CALL-RESULT-MARK-1 witness H1-G (must not refute): g's post atom c = 0 recurs as a guard on the else path without the call; g promises result 0 so the then-branch verifies.
(def-shell g [x: int] -> int
  (pre (= x 0))
  (post (and (= x 0) (= result 0)))
  0)

(def-shell h1 [b: bytes] -> int
  (pre (>= (bytes-length b) 1))
  (post (>= result 0))
  (let [(h (bytes-slice b 0 1)) (c (bytes-get h 0))]
    (if (= (bytes-get b 0) 0) (g c) (if (= c 0) (bytes-get b 99) 0))))
