;; BUILD-GATE-1 fixture. Compiled end to end through GHC by
;; scripts/build_smoke.sh on every CI run of the spec-roundtrip job.
;;
;; Purpose: this repository's corpus is a CHECK-ONLY corpus. Nothing in
;; scripts/, .github/, compiler/test/, tools/ or the Makefile invoked
;; `llmll build` before this fixture existed, so a program could typecheck
;; clean and fail at GHC with nothing to catch it. Three independent defects
;; of that shape were found in one release; WASI-RT was one of them.
;;
;; Every wasi.* builtin whose runtime lives in the codegen preamble is called
;; here at least once. Adding a builtin to builtinEnv (TypeCheck.hs) without a
;; preamble definition makes this file fail to build, which is the whole point.
;; Keep the call set complete: the unit test in compiler/test/Spec.hs checks
;; that definitions EXIST, and this fixture checks that they COMPILE TOGETHER
;; against their real imports and dependency set.
;;
;; BUILTIN-BODY-1 widened that division of labour and this file with it. Spec.hs
;; no longer covers only the wasi.* names, and the names it now EXEMPTS are the
;; eleven that codegen lowers through a hand-written emitApp equation rather
;; than through the generic fallthrough. Those eleven are unreachable by any
;; check that reads the emitter, so the only oracle left for them is a build.
;; `sha1` is the first of them called here; see its def below for why.
;;
;; Deliberately has no sibling imports and no def-interface: a build gate over
;; the preamble should fail for preamble reasons only. tools/llmll-driver/
;; shell.llmll was the other candidate and was rejected for that reason, and
;; because it calls only two of the seven names.
;;
;; EFFECT-RESP widened this fixture with a def-main. The BUILD-GATE-1 roadmap
;; row records three defects living in the check-passes/build-fails seam and
;; notes that only the first was covered here: WASI-RT was, the def-main :step
;; arity change was NOT, "since EFFECT-RESP has not shipped and the fixture has
;; no def-main". It ships now, so the gate takes the second witness. Without a
;; def-main no Main.hs is emitted at all, and the whole console harness -- the
;; response slot, the RC-4 settle branch, the three-argument step call -- sat
;; outside the only gate in this repository whose oracle is GHC.

(module smoke
  (import wasi.io    (capability stdout :deterministic false))
  (import wasi.fs    (capability read-write "/tmp"))
  (import wasi.http  (capability post :deterministic false))
  ;; CAP-PROC Phase 2 opens two namespaces. Neither capability clause is
  ;; enforced -- checkWasiCapability tests namespace membership and never reads
  ;; the verb (CAP-1-REAL) -- so `exec` here is documentation, not a bound.
  (import wasi.proc  (capability exec :deterministic false))
  (import wasi.clock (capability read :deterministic false))
  ;; ENV-READ-1 opens a third namespace. `:deterministic true` HERE is a type
  ;; error, unlike on every other import in this list, so the flag is written
  ;; false explicitly rather than omitted: the explicit form is what a reader
  ;; copying this fixture should copy.
  (import wasi.env   (capability read "HOME" :deterministic false))

  (def-shell smoke-stdout [msg: string]
    (wasi.io.stdout msg))

  (def-shell smoke-stderr [msg: string]
    (wasi.io.stderr msg))

  (def-shell smoke-response [code: int body: string]
    (wasi.http.response code body))

  (def-shell smoke-read [path: string]
    (wasi.fs.read path))

  (def-shell smoke-write [path: string body: string]
    (wasi.fs.write path body))

  (def-shell smoke-delete [path: string]
    (wasi.fs.delete path))

  (def-shell smoke-post [url: string body: string]
    (wasi.http.post url body))

  (def-shell smoke-list [path: string]
    (wasi.fs.list path))

  ;; CAP-PROC Phase 2. Four operations, each called once so the gate fails if a
  ;; builtinEnv entry lands without a preamble body.
  (def-shell smoke-mkdir [path: string]
    (wasi.fs.mkdir path))

  (def-shell smoke-sha256 [path: string]
    (wasi.fs.sha256 path))

  ;; FS-COPY-1. Two string arguments and RNone, so it exercises the binary
  ;; arity of the fs group against its real imports. copyFile comes from
  ;; System.Directory, which the preamble already imports for delete/list/mkdir,
  ;; so a missing import here would fail this gate rather than a user's build.
  (def-shell smoke-copy [src: string dst: string]
    (wasi.fs.copy src dst))

  ;; Nullary, so the name is a VALUE and not an application. This is the only
  ;; builtin of that shape besides RNone, and nothing in the corpus used one as
  ;; an expression before now.
  (def-shell smoke-clock [] -> Command
    wasi.clock.monotonic)

  ;; PROC-BOUNDARY-1. Nullary like the clock above. Here for this fixture's
  ;; stated contract -- every wasi.* name with a preamble body is called at
  ;; least once, so a builtinEnv entry landing without a body fails the BUILD
  ;; rather than a user's. Its RUNTIME behaviour (a real argument vector on the
  ;; RList arm) is settled by scripts/build-smoke/proc_boundary.llmll, which is
  ;; executed rather than only compiled.
  (def-shell smoke-args [] -> Command
    wasi.proc.args)

  ;; ENV-READ-1. Here for the same stated contract as smoke-args above: every
  ;; wasi.* name with a preamble body is called at least once, so a builtinEnv
  ;; entry landing without a body fails THIS build rather than a user's.
  ;;
  ;; The name is a PARAMETER and not a literal, deliberately. A literal would
  ;; also exercise the two literal side conditions, and this fixture's job is
  ;; the build, not the type rules; Spec.hs ER-8 through ER-11 own those, and
  ;; stage 6 below owns the runtime arms.
  (def-shell smoke-env [name: string] -> Command
    (wasi.env.get name))

  ;; exec/argv: SEVEN positional parameters since PROC-STDIN-1, and argv is
  ;; list[string]. The gate covers the list-typed ARGUMENT here the way
  ;; smoke-step covers the list-typed response payload. The stdin path is
  ;; "/dev/null", which is the spelling for "no input".
  (def-shell smoke-proc [exe: string args: list[string] cwd: string
                         out: string err: string secs: int]
    (wasi.proc.run exe args cwd out err secs "/dev/null"))

  ;; seq-commands is the Command monoid's <>; exercised so the gate covers
  ;; composition, not only the leaf constructors.
  (def-shell smoke-seq [path: string body: string]
    (seq-commands (wasi.fs.write path body)
                  (wasi.fs.delete path)))

  ;; BUILTIN-BODY-1. A crypto builtin in a fixture whose contract was written
  ;; around the wasi.* group, and the widening is deliberate: it matches the one
  ;; the same row made to Spec.hs, which grew from the sixteen wasi.* names to
  ;; all 101 entries of builtinEnv.
  ;;
  ;; WHY A BUILD IS THE ONLY THING THAT CAN GRADE THIS CALL. `sha1` reached the
  ;; generic fallthrough and emitted a call to an identifier nothing defines,
  ;; because the preamble binding is `sha1_hash`. The fix adds a hand-written
  ;; emitApp equation, and that equation is what puts the name OUT of reach of
  ;; the very check that found it: Spec.hs's population is the names whose
  ;; emission still starts with the mangled builtin name, so a name routed
  ;; through emitApp is exempt by construction. The class-size assertion there
  ;; moved 71 to 70 for exactly this reason. A typo in any of those equations
  ;; type-checks, verifies SAFE, and dies at GHC, which is the defect this
  ;; fixture's whole existence is about.
  ;;
  ;; MEASURED over scripts/build-smoke/*.llmll, so the gap is a number and not
  ;; an impression: of the twelve hand-written equations, this corpus called
  ;; three (`pair`, `list-length`, `string-length`) and now calls four. The
  ;; eight still uncalled are `first`, `second`, `bytes-length`, `bytes-get`,
  ;; `bytes-set`, `list-nth`, `string-slice` and `string-char-at`. Five of those
  ;; eight wrap an ARGUMENT in fromIntegral at the LT-INT call seam, where a
  ;; wrong wrapper is a GHC type error and nothing before a build sees it.
  ;;
  ;; So the call site below is the assertion. It needs no shell-side grep: if
  ;; the equation emits a name nothing binds, THIS FILE does not compile and
  ;; stage 4 fails on both implementations. `sha1_hash` is added to the emitted
  ;; -preamble name lists in scripts/build_smoke.sh and its LLMLL port as the
  ;; fail-open guard, the same way every wasi_* name above is guarded.
  ;;
  ;; bytes[20] in and bytes[20] out, per LLMLL.md 13.11. The declared domain is
  ;; narrower than FIPS 180-4, which is the open SHA1-DOMAIN-1 row and is not
  ;; this fixture's business.
  (def-shell smoke-sha1 [k: bytes[20]] -> bytes[20]
    (sha1 k))

  ;; EFFECT-RESP: the console harness. Every arm of Response is matched, so the
  ;; generated Main.hs only compiles if the emitted `data Response` declaration,
  ;; the response slot, and the three-argument step call all agree with what
  ;; TypeCheck accepted. The step consumes the response rather than binding it
  ;; to `_`, which is what makes this a gate over the CHANNEL and not only over
  ;; the arity.
  (def-shell smoke-init [] -> (int, Command)
    (pair 0 (wasi.io.stdout "")))

  (def-shell smoke-step [s: int input: string r: Response] -> (int, Command)
    (match r
      ((RNone)     (pair (+ s 1) (wasi.io.stdout input)))
      ((RText t)   (pair (+ s 1) (wasi.io.stdout t)))
      ((RCode n)   (pair (+ s 1) (wasi.io.stdout (int-to-string n))))
      ((RErr e)    (pair (+ s 1) (wasi.io.stderr e)))
      ;; Fifth arm. Its payload is a list[string], so this arm also pins that a
      ;; list-typed response payload survives codegen into the generated match.
      ((RList ns)  (pair (+ s 1) (wasi.io.stdout (int-to-string (list-length ns)))))))

  ;; JSON-1 (§13.13). Eighteen builtins over the sealed opaque carrier, each
  ;; called at least once, for the same reason the wasi.* names above are: an
  ;; entry in builtinEnv with no jsonPreamble body is the WASI-RT defect, and
  ;; this phase adds eighteen chances to repeat it.
  ;;
  ;; The numeral was "thirteen" here through two releases that shipped fourteen
  ;; names: Rev 4 of the JSON-1 proposal re-admitted json-get-number and this
  ;; comment was not moved with it. Corrected to eighteen with JSON-SCALAR-1's
  ;; four projections. The unit test in Spec.hs is what actually counts them;
  ;; a numeral in a comment cannot fail.
  ;;
  ;; All def-shell, and not by preference: every json-* name is in
  ;; coreExcludedBuiltins, so `def` is a check-time error (CORE-EXCL).
  (def-shell smoke-json-parse [s: string] -> Result[Json, string]
    (json-parse s))

  (def-shell smoke-json-ser [j: Json] -> string
    (json-serialize j))

  (def-shell smoke-json-get [j: Json k: string] -> Result[Json, string]
    (json-get j k))

  (def-shell smoke-json-get-string [j: Json k: string] -> Result[string, string]
    (json-get-string j k))

  (def-shell smoke-json-get-int [j: Json k: string] -> Result[int, string]
    (json-get-int j k))

  (def-shell smoke-json-get-bool [j: Json k: string] -> Result[bool, string]
    (json-get-bool j k))

  (def-shell smoke-json-number [j: Json k: string] -> Result[string, string]
    (json-get-number j k))

  (def-shell smoke-json-array [j: Json] -> Result[list[Json], string]
    (json-array j))

  ;; JSON-SCALAR-1. The projection family: the four above MINUS THE KEY, which
  ;; is what reads an element of the list json-array hands back. Present here
  ;; for this fixture's stated contract (every name with a preamble body is
  ;; called at least once); their RUNTIME behaviour, including the two refusals
  ;; that must not coerce, is settled by scripts/build-smoke/json_scalar.llmll,
  ;; which is executed rather than only compiled.
  (def-shell smoke-json-as-string [j: Json] -> Result[string, string]
    (json-as-string j))

  (def-shell smoke-json-as-int [j: Json] -> Result[int, string]
    (json-as-int j))

  (def-shell smoke-json-as-bool [j: Json] -> Result[bool, string]
    (json-as-bool j))

  (def-shell smoke-json-as-number [j: Json] -> Result[string, string]
    (json-as-number j))

  ;; Nullary, so the name is a VALUE and not an application — the
  ;; wasi.clock.monotonic shape.
  (def-shell smoke-json-object [] -> Json
    json-object)

  (def-shell smoke-json-set [j: Json k: string v: Json] -> Result[Json, string]
    (json-set j k v))

  (def-shell smoke-json-of-string [s: string] -> Json (json-of-string s))
  (def-shell smoke-json-of-int    [n: int]    -> Json (json-of-int n))
  (def-shell smoke-json-of-bool   [b: bool]   -> Json (json-of-bool b))
  (def-shell smoke-json-of-list   [xs: list[Json]] -> Json (json-of-list xs))

  (def-shell smoke-done? [s: int] -> bool (>= s 3))

  (def-main
    :mode    console
    :init    (smoke-init)
    :step    smoke-step
    :done?   smoke-done?))
