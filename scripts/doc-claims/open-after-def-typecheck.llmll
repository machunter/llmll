;; @doc: getting-started.md §4.8 (gotchas table) + §4.9 (`open` ordering WARNING block)
;; @cmd: typecheck {file}
;; @expect: check-error:is used before (open open-aux-lib)
;; @claim: an `(open ...)` placed AFTER a def-shell that calls its bare names leaves the call unresolved, and `llmll typecheck` exits 1 with `error: 'inc' is used before (open open-aux-lib); move the open above its first use` (XMOD-SCOPE rule R4, kind name-not-in-scope). Before XMOD-SCOPE, typecheck exited 0 with only `warning: call to unknown function`. This is the ORDER-SENSITIVE half of the "must appear before defs" cluster; import-after-def.llmll and decl-order-independent.llmll guard the position-INDEPENDENT half. open-after-def-verify.llmll guards that verify refuses with the same text.
(module open-after-def-typecheck
  (import open-aux-lib)
  (def-shell use-it [n: int] -> int (inc n))
  (open open-aux-lib))
