;; @doc: LLMLL.md §8.5 (a build's top-level names share one scope)
;; @expect: check-ok
;; @claim: support module for duplicate-def-xmod-rejected.llmll. Alone, a module declaring `(type Phase …)` checks clean, so a failure here localizes to this file rather than to the cross-module claim under test.
(module duplicate-def-xmod-aux-a
  (type Phase (| P1 int))
  (def mk-p1 [n: int] -> Phase (P1 n)))
