;; Leanstral demo: the single end-to-end obligation
;; (docs/archive/shipped-design-specs/leanstral-demo-spec.md §2).
;;
;; MUL-VAR-1: `n*n >= 0` is now proved in the decidable fragment (the product
;; facts give it), so the demo obligation is the eighth power `n^8`. Its degree
;; is over the product limit (design "Limits", degree 6), so the post lands at
;; `asserted` (reported as "not proven") without --leanstral. With --leanstral,
;; LLMLL states the faithful, result-bound theorem, Leanstral proves it
;; (`rw [h_body]; positivity`), and the Lean kernel + Mathlib check it ->
;; `verified-lean` with a re-checkable certificate. That delta is the C-property
;; demo.
;;
;;   llmll verify examples/leanstral-demo/square.llmll                      -> asserted
;;   LLMLL_LEANSTRAL_API_KEY=... llmll verify examples/leanstral-demo/square.llmll \
;;     --leanstral --leanstral-lean-project <mathlib-project>               -> verified-lean
;;
;; NOTE: `def-shell` (permissive), not `def`. A product over the degree limit
;; falls back, so the body lands in `erBodyFallback` (asserted), which IS the
;; obligation class Leanstral exists to discharge.

(def-shell square [n: int] -> int
  (post (>= result 0))
  (* (* (* n n) (* n n)) (* (* n n) (* n n))))
