;; netpbm — codec and transforms for the ASCII Netpbm formats PGM P2
;; (grayscale) and PPM P3 (colour). This module is the SHELL layer: it walks
;; lists and strings, which the verifier cannot reason about, and delegates
;; every per-sample and per-header decision to the verified core in
;; pixel.llmll (layer 1), geom.llmll (layer 2) and blur.llmll (layer 3).
;;
;; Representation
;;   Header = (channels, (width, (height, maxval)))     all int
;;   Image  = (Header, samples)                         samples : list[int]
;;   channels is 1 (P2) or 3 (P3). samples is row-major and channel-
;;   interleaved (r g b r g b ... for P3), of length width*height*channels.
;;
;; Contracts here are runtime-checked, not proved. Each transform carries
;;   pre  (image-ok? img)                 the input is well formed
;;   post (image-ok? result) + header facts
;; image-ok? folds over the sample list and compares its length with
;; width*height*channels, a product of variables; both are outside the
;; verifier's fragment (no list producer is reflected; nonlinear `*`).

(import pixel)
(open pixel)
(import blur)
(open blur)

;; ─── Types ──────────────────────────────────────────────────────────────

(type Header (int, (int, (int, int))))
(type Image (Header, list[int]))

;; ─── Header accessors (shell: nested pair projections fall back) ────────

;; Each post restates the projection. As a def the nested projection
;; falls back (W-BODY-FALLBACK app:first / app:second), and the let-bound
;; form that the verifier does accept crashes liquid-fixpoint.
(def-shell hdr-channels [h: Header] -> int
  (post (= result (first h)))
  (first h))
(def-shell hdr-width [h: Header] -> int
  (post (= result (first (second h))))
  (first (second h)))
(def-shell hdr-height [h: Header] -> int
  (post (= result (first (second (second h)))))
  (first (second (second h))))
(def-shell hdr-maxval [h: Header] -> int
  (post (= result (second (second (second h)))))
  (second (second (second h))))

(def-shell make-header [c: int w: int ht: int m: int] -> Header
  (post (and (= (hdr-channels result) c)
        (and (= (hdr-width result) w)
        (and (= (hdr-height result) ht) (= (hdr-maxval result) m)))))
  (pair c (pair w (pair ht m))))

;; One-level projections verify as defs.
(def img-header [img: Image] -> Header
  (post (= result (first img)))
  (first img))
(def img-samples [img: Image] -> list[int]
  (post (= result (second img)))
  (second img))

;; image-ok?, img-ok-header? and all-samples-ok? are the specification
;; predicates the contracts are written in; they carry no contract of their own.
(def-shell img-ok-header? [h: Header] -> bool
  (header-ok? (hdr-channels h) (hdr-width h) (hdr-height h) (hdr-maxval h)))

;; Samples per row: width * channels, linear through times-channels.
(def-shell row-length [h: Header] -> int
  (pre (img-ok-header? h))
  (post (>= result 1))
  (times-channels (hdr-channels h) (hdr-width h)))

;; Samples in the image: height * row-length. A product of two variables:
;; the one place the codec genuinely needs nonlinear arithmetic.
(def-shell sample-count [h: Header] -> int
  (pre (img-ok-header? h))
  (post (>= result 1))
  (* (hdr-height h) (row-length h)))

;; ─── Image well-formedness ──────────────────────────────────────────────

(def-shell all-samples-ok? [m: int xs: list[int]] -> bool
  (list-fold xs true (fn [acc: bool s: int] (and acc (= (sample-problem m s) 0)))))

(def-shell image-ok? [img: Image] -> bool
  (let [(h (img-header img))]
    (and (img-ok-header? h)
    (and (= (list-length (img-samples img)) (sample-count h))
         (all-samples-ok? (hdr-maxval h) (img-samples img))))))

;; ─── List plumbing ──────────────────────────────────────────────────────
;; No list-take / list-drop / zip builtin exists and list-nth is O(n), so
;; rows are cut with one left fold and glued back with another.

;; Split xs into consecutive chunks of n (the last may be short).
(def-shell chunk [xs: list[int] n: int] -> list[list[int]]
  (pre  (>= n 1))
  (post (and (= (flatten result) xs)
             (list-fold result true (fn [acc: bool r: list[int]]
               (and acc (and (>= (list-length r) 1) (<= (list-length r) n)))))))
  (let [(st (list-fold xs (pair (pair (list-empty) 0) (list-empty))
              (fn [acc: ((list[int], int), list[list[int]]) x: int]
                (let [(cur  (list-prepend x (first (first acc))))
                      (k    (+ (second (first acc)) 1))
                      (rows (second acc))]
                  (if (= k n)
                      (pair (pair (list-empty) 0) (list-prepend (list-reverse cur) rows))
                      (pair (pair cur k) rows))))))
        (tail (first (first st)))
        (rows (second st))]
    (if (= (second (first st)) 0)
        (list-reverse rows)
        (list-reverse (list-prepend (list-reverse tail) rows)))))

;; Concatenate a list of rows.
(def-shell flatten [rows: list[list[int]]] -> list[int]
  (post (= (list-length result)
           (list-fold rows 0 (fn [n: int r: list[int]] (+ n (list-length r))))))
  (list-reverse
    (list-fold rows (list-empty)
      (fn [acc: list[int] row: list[int]]
        (list-fold row acc (fn [a: list[int] x: int] (list-prepend x a)))))))

;; Elements of xs whose index lies in [lo, hi).
(def-shell slice-list [xs: list[int] lo: int hi: int] -> list[int]
  (post (= (list-length result)
           (max 0 (- (min hi (list-length xs)) (max lo 0)))))
  (list-reverse
    (second
      (list-fold xs (pair 0 (list-empty))
        (fn [acc: (int, list[int]) x: int]
          (pair (+ (first acc) 1)
                (if (in-span? lo hi (first acc)) (list-prepend x (second acc)) (second acc))))))))

;; Rows whose index lies in [lo, hi).
(def-shell slice-rows [xs: list[list[int]] lo: int hi: int] -> list[list[int]]
  (post (= (list-length result)
           (max 0 (- (min hi (list-length xs)) (max lo 0)))))
  (list-reverse
    (second
      (list-fold xs (pair 0 (list-empty))
        (fn [acc: (int, list[list[int]]) x: list[int]]
          (pair (+ (first acc) 1)
                (if (in-span? lo hi (first acc)) (list-prepend x (second acc)) (second acc))))))))

;; A row as index -> sample, for O(log n) neighbour reads in the blur.
(def-shell row-map [xs: list[int]] -> map[int, int]
  (post (and (not (map-has result (list-length xs)))
             (=> (>= (list-length xs) 1)
                 (and (map-has result 0) (map-has result (- (list-length xs) 1))))))
  (second
    (list-fold xs (pair 0 (map-empty))
      (fn [acc: (int, map[int, int]) s: int]
        (pair (+ (first acc) 1) (map-put (second acc) (first acc) s))))))

;; ─── Decoder ────────────────────────────────────────────────────────────

;; Drop a `#` comment from one line.
(def-shell strip-comment [line: string] -> string
  (post (and (not (string-contains result "#"))
             (<= (string-length result) (string-length line))))
  (unwrap-or (list-head (string-split "#" line)) ""))

(def-shell strip-comments [text: string] -> string
  (post (not (string-contains result "#")))
  (string-concat-many
    (list-map (string-split "\n" text)
              (fn [l: string] (string-concat (strip-comment l) "\n")))))

;; Whitespace-separated tokens.
(def-shell tokenize [text: string] -> list[string]
  (post (list-fold result true
          (fn [acc: bool t: string]
            (and acc (and (>= (string-length t) 1) (not (regex-match "[[:space:]]" t)))))))
  (list-map (regex-find-all "[^[:space:]]+" text)
            (fn [m: list[string]] (unwrap-or (list-head m) ""))))

;; Decimal digits only: string-to-int alone also accepts a sign.
(def-shell parse-nat [tok: string what: string] -> Result[int, string]
  (post (match result ((Success n) (>= n 0)) ((Error e) true)))
  (if (regex-match "^[0-9]+$" tok)
      (string-to-int tok)
      (err (string-concat-many [what " is not a non-negative integer: '" tok "'"]))))

;; Read one header integer off the token stream.
(def-shell next-int [toks: list[string] what: string] -> Result[(int, list[string]), string]
  (post (match result
          ((Success p) (and (>= (first p) 0)
                            (= (list-length (second p)) (- (list-length toks) 1))))
          ((Error e) (not (= e "")))))
  (match (list-head toks)
    ((Error e) (err (string-concat "missing " what)))
    ((Success t)
      (match (parse-nat t what)
        ((Error e) (err e))
        ((Success n) (ok (pair n (unwrap-or (list-tail toks) (list-empty)))))))))

;; Parse every remaining token as a sample in 0..m.
;; Accumulator: (error or "", (index, reversed samples)).
(def-shell parse-samples [m: int toks: list[string]] -> Result[list[int], string]
  (pre  (>= m 1))
  (post (match result
          ((Success xs) (and (all-samples-ok? m xs) (= (list-length xs) (list-length toks))))
          ((Error e) (not (= e "")))))
  (let [(st (list-fold toks (pair "" (pair 0 (list-empty)))
              (fn [acc: (string, (int, list[int])) tok: string]
                (if (not (= (first acc) ""))
                    acc
                    (let [(i  (first (second acc)))
                          (xs (second (second acc)))]
                      (match (parse-nat tok (string-concat "sample " (int-to-string i)))
                        ((Error e) (pair e (pair i xs)))
                        ((Success v)
                          (if (= (sample-problem m v) 0)
                              (pair "" (pair (+ i 1) (list-prepend v xs)))
                              (pair (string-concat-many ["sample " (int-to-string i) " (" (int-to-string v)
                                                         ") exceeds maxval " (int-to-string m)])
                                    (pair i xs))))))))))]
    (if (= (first st) "")
        (ok (list-reverse (second (second st))))
        (err (first st)))))

(def-shell decode-body [h: Header toks: list[string]] -> Result[Image, string]
  (pre  (img-ok-header? h))
  (post (match result
          ((Success img) (and (image-ok? img) (= (img-header img) h)))
          ((Error e) (not (= e "")))))
  (match (parse-samples (hdr-maxval h) toks)
    ((Error e) (err e))
    ((Success xs)
      (let [(want (sample-count h))
            (got  (list-length xs))]
        (if (= want got)
            (ok (pair h xs))
            (err (string-concat-many ["wrong sample count: " (int-to-string (hdr-width h)) "x"
                                      (int-to-string (hdr-height h)) "x" (int-to-string (hdr-channels h))
                                      " needs " (int-to-string want) " samples, found "
                                      (int-to-string got)])))))))

(def-shell decode-header [c: int toks: list[string]] -> Result[Image, string]
  (pre  (or (= c 1) (= c 3)))
  (post (match result
          ((Success img) (and (image-ok? img) (= (hdr-channels (img-header img)) c)))
          ((Error e) (not (= e "")))))
  (match (next-int toks "width")
    ((Error e) (err e))
    ((Success pw)
      (match (next-int (second pw) "height")
        ((Error e) (err e))
        ((Success ph)
          (match (next-int (second ph) "maxval")
            ((Error e) (err e))
            ((Success pm)
              (let [(problem (header-problem (first pw) (first ph) (first pm)))]
                (if (= problem "")
                    (decode-body (make-header c (first pw) (first ph) (first pm)) (second pm))
                    (err problem))))))))))

;; Text of a P2/P3 file -> image, or an error naming the problem.
(def-shell decode [text: string] -> Result[Image, string]
  (post (match result
          ((Success img) (image-ok? img))
          ((Error e) true)))
  (let [(toks (tokenize (strip-comments text)))]
    (match (list-head toks)
      ((Error e) (err "empty input: missing magic number"))
      ((Success magic)
        (let [(c (magic-channels magic))]
          (if (= c 0)
              (err (string-concat-many ["bad magic number '" magic "' (expected P2 or P3)"]))
              (decode-header c (unwrap-or (list-tail toks) (list-empty)))))))))

;; ─── Encoder ────────────────────────────────────────────────────────────

;; Samples, space-separated, a newline at each row end and after every 12th
;; sample of a row. The column logic is next-col / sep-after (verified).
(def-shell encode-body [rowlen: int xs: list[int]] -> string
  (pre  (>= rowlen 1))
  (post (= (list-length (tokenize result)) (list-length xs)))
  (string-concat-many
    (list-reverse
      (second
        (list-fold xs (pair 0 (list-empty))
          (fn [acc: (int, list[string]) s: int]
            (let [(col (first acc))]
              (pair (next-col rowlen col)
                    (list-prepend (sep-after rowlen col)
                                  (list-prepend (int-to-string s) (second acc)))))))))))

(def-shell encode [img: Image] -> string
  (pre  (image-ok? img))
  (post (= (decode result) (ok img)))
  (let [(h (img-header img))]
    (string-concat-many
      [(magic-for (hdr-channels h)) "\n"
       (int-to-string (hdr-width h)) " " (int-to-string (hdr-height h)) "\n"
       (int-to-string (hdr-maxval h)) "\n"
       (encode-body (row-length h) (img-samples img))])))

;; ─── Transforms ─────────────────────────────────────────────────────────

(def-shell invert [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (= (img-header result) (img-header img))))
  (let [(m (hdr-maxval (img-header img)))]
    (pair (img-header img)
          (list-map (img-samples img) (fn [s: int] (invert-sample m s))))))

(def-shell threshold [t: int img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (= (img-header result) (img-header img))))
  (let [(m (hdr-maxval (img-header img)))]
    (pair (img-header img)
          (list-map (img-samples img) (fn [s: int] (threshold-sample m t s))))))

;; Mirror left-right: reverse the pixel order inside each row.
(def-shell hflip [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (= (img-header result) (img-header img))))
  (let [(h (img-header img))
        (c (hdr-channels h))]
    (pair h (flatten (list-map (chunk (img-samples img) (row-length h))
                               (fn [row: list[int]] (flatten (list-reverse (chunk row c)))))))))

;; Mirror top-bottom: reverse the row order.
(def-shell vflip [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (= (img-header result) (img-header img))))
  (let [(h (img-header img))]
    (pair h (flatten (list-reverse (chunk (img-samples img) (row-length h)))))))

;; Crop to the cw x ch window whose top-left corner is (x, y).
(def-shell crop [x: int y: int cw: int ch: int img: Image] -> Image
  (pre  (and (image-ok? img)
             (crop-ok? (hdr-width (img-header img)) (hdr-height (img-header img)) x y cw ch)))
  (post (and (image-ok? result)
        (and (= (hdr-width (img-header result)) cw)
        (and (= (hdr-height (img-header result)) ch)
        (and (= (hdr-channels (img-header result)) (hdr-channels (img-header img)))
             (= (hdr-maxval (img-header result)) (hdr-maxval (img-header img))))))))
  (let [(h    (img-header img))
        (span (row-span (hdr-channels h) (hdr-width h) x cw))
        (rows (slice-rows (chunk (img-samples img) (row-length h)) y (+ y ch)))]
    (pair (make-header (hdr-channels h) cw ch (hdr-maxval h))
          (flatten (list-map rows (fn [row: list[int]] (slice-list row (first span) (second span))))))))

;; Colour to grayscale with integer luma. A P2 image is returned unchanged.
(def-shell grayscale [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result)
        (and (= (hdr-channels (img-header result)) 1)
        (and (= (hdr-width (img-header result)) (hdr-width (img-header img)))
             (= (hdr-height (img-header result)) (hdr-height (img-header img)))))))
  (let [(h (img-header img))
        (m (hdr-maxval h))]
    (if (= (hdr-channels h) 1)
        img
        (pair (make-header 1 (hdr-width h) (hdr-height h) m)
              (list-map (chunk (img-samples img) 3)
                        (fn [px: list[int]]
                          (luma m (unwrap-or (list-nth px 0) 0)
                                  (unwrap-or (list-nth px 1) 0)
                                  (unwrap-or (list-nth px 2) 0))))))))

;; 3x3 box blur, edges replicated. Every output sample is blur-sample
;; (verified: always in 0..maxval); this function only walks the grid.
;; Rows are held as index -> sample maps; the row list is indexed with
;; list-nth, O(height) per row, so O(height^2) row lookups in total.
(def-shell blur [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (= (img-header result) (img-header img))))
  (let [(h    (img-header img))
        (w    (hdr-width h))
        (ht   (hdr-height h))
        (c    (hdr-channels h))
        (m    (hdr-maxval h))
        ;; (fn ...) and not the bare name row-map: llmll test does not apply a
        ;; named function passed as a value (PBT-FN-VALUE-1).
        (rows (list-map (chunk (img-samples img) (row-length h)) (fn [r: list[int]] (row-map r))))]
    (pair h
      (flatten
        (list-map (range 0 ht)
          (fn [y: int]
            (let [(above (unwrap-or (list-nth rows (clamp-coord ht (- y 1))) (map-empty)))
                  (cur   (unwrap-or (list-nth rows y) (map-empty)))
                  (below (unwrap-or (list-nth rows (clamp-coord ht (+ y 1))) (map-empty)))]
              (flatten
                (list-map (range 0 w)
                  (fn [x: int]
                    (list-map (range 0 c)
                      (fn [k: int] (blur-sample m c w above cur below x k)))))))))))))

;; ─── Properties ─────────────────────────────────────────────────────────

;; A small well-formed test image built from arbitrary ints:
;; 1 or 3 channels, 1..4 x 1..4 pixels, maxval 1..255.
(def-shell test-image [cs: int ws: int hs: int ms: int vs: int] -> Image
  (post (image-ok? result))
  (let [(c  (if (= (mod cs 2) 0) 1 3))
        (w  (+ 1 (mod ws 4)))
        (ht (+ 1 (mod hs 4)))
        (m  (+ 1 (mod ms 255)))
        (h  (make-header c w ht m))]
    (pair h (list-map (range 0 (sample-count h))
                      (fn [i: int] (mod (+ (* i 37) vs) (+ m 1)))))))

(check "decode skips comments and trailing whitespace" :subject decode
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (decode (string-concat (encode img) "# trailing comment\n\t \n")) (ok img)))))

(check "invert is an involution" :subject invert
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (invert (invert img)) img))))

(check "hflip is an involution" :subject hflip
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (hflip (hflip img)) img))))

(check "vflip is an involution" :subject vflip
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (vflip (vflip img)) img))))

(check "hflip and vflip commute" :subjects [hflip vflip]
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (hflip (vflip img)) (vflip (hflip img))))))

(check "full-size crop is the identity" :subject crop
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))
          (h   (img-header img))]
      (= (crop 0 0 (hdr-width h) (hdr-height h) img) img))))

(check "grayscale yields a valid P2 image of the same size" :subject grayscale
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))
          (g   (grayscale img))]
      (and (image-ok? g) (= (hdr-channels (img-header g)) 1)))))

(check "blur of a constant image is the identity" :subject blur
  (for-all [cs: int ws: int hs: int ms: int v: int]
    (let [(img0 (test-image cs ws hs ms 0))
          (m    (hdr-maxval (img-header img0)))
          (img  (pair (img-header img0) (list-map (img-samples img0) (fn [s: int] (mod v (+ m 1))))))]
      (= (blur img) img))))

(check "threshold yields only 0 and maxval" :subject threshold
  (for-all [cs: int ws: int hs: int ms: int vs: int t: int]
    (let [(img (test-image cs ws hs ms vs))
          (m   (hdr-maxval (img-header img)))]
      (list-fold (img-samples (threshold t img)) true
        (fn [acc: bool s: int] (and acc (or (= s 0) (= s m))))))))

(check "decode rejects malformed input"
  (for-all [n: int]
    (and (not (is-ok (decode "P5\n1 1\n255\n0\n")))
    (and (not (is-ok (decode "P2\n2\n")))
    (and (not (is-ok (decode "P2\n1 1\n10\n11\n")))
    (and (not (is-ok (decode "P2\n2 2\n10\n1 2 3\n")))
    (and (not (is-ok (decode "P2\n0 2\n10\n\n")))
         (is-ok (decode "P2 # c\n# full line\n1 1 10 7")))))))))

;; Properties restating the runtime posts of the list and string plumbing,
;; so those posts carry `tested` evidence and not only a runtime check.

(check "chunk then flatten is the identity" :subject chunk
  (for-all [xs: list[int] n: int]
    (let [(k (+ 1 (mod n 5)))]
      (= (flatten (chunk xs k)) xs))))

(check "flatten keeps every element" :subject flatten
  (for-all [a: list[int] b: list[int]]
    (= (list-length (flatten [a b])) (+ (list-length a) (list-length b)))))

(check "slice-list length is the clipped span" :subject slice-list
  (for-all [xs: list[int] lo: int hi: int]
    (= (list-length (slice-list xs lo hi))
       (max 0 (- (min hi (list-length xs)) (max lo 0))))))

(check "strip-comments removes every comment" :subject strip-comments
  (for-all [a: string b: string]
    (not (string-contains (strip-comments (string-concat-many [a "#" b "\n" a "#"])) "#"))))

(check "tokenize yields non-empty tokens without whitespace" :subject tokenize
  (for-all [a: string b: string]
    (list-fold (tokenize (string-concat-many [a " \t" b "\n" a])) true
      (fn [acc: bool t: string]
        (and acc (and (>= (string-length t) 1) (not (regex-match "[[:space:]]" t))))))))

(check "parse-nat reads digits and refuses signs" :subject parse-nat
  (for-all [n: int]
    (let [(a (abs n))]
      (and (= (parse-nat (int-to-string a) "x") (ok a))
           (not (is-ok (parse-nat (string-concat "-" (int-to-string (+ a 1))) "x")))))))

(check "encode then decode is the identity" :subject encode
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (decode (encode img)) (ok img)))))

(check "encode-body writes one token per sample" :subject encode-body
  (for-all [xs: list[int] r: int]
    (let [(ys (list-map xs (fn [x: int] (abs x))))]
      (= (list-length (tokenize (encode-body (+ 1 (mod r 30)) ys))) (list-length ys)))))

(check "row-map holds index 0 .. n-1 and not n" :subject row-map
  (for-all [xs: list[int]]
    (and (not (map-has (row-map xs) (list-length xs)))
         (=> (>= (list-length xs) 1) (map-has (row-map xs) (- (list-length xs) 1))))))
