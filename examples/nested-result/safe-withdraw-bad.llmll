;; nested-result — the refuted twin (COMP-3b-general, v0.13.6).
;;
;; Same shape as safe-withdraw.llmll — the Result-typed `attempt` is matched INSIDE
;; the `let` body (nested, not top-level) — EXCEPT the Success arm returns the
;; payload `n` directly. `n` can be negative, violating the Balance refinement
;; {b : int | b >= 0}. The body passes a happy-path test (non-negative payloads
;; only), but the solver refutes on exactly the Success arm — per-arm localization,
;; through the `let`-nested match:
;;
;;   llmll verify ./safe-withdraw-bad.llmll --strict-verified-core
;;       ->  refuted: safe-withdraw  (Success arm does not establish b >= 0)

(type Balance (where [b: int] (>= b 0)))

(def safe-withdraw [attempt: Result[int, string] floor: int] -> Balance
  (pre (>= floor 0))
  (let [[guard floor]]
    (match attempt
      ((Success n) n)
      ((Error e)   guard))))
