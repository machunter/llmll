;; session-pay — the connected demo: ALL THREE capabilities in ONE verified scenario.
;;
;;   "Open a connection, then pay."  A payment is allowed ONLY when the session
;;   reaches ESTABLISHED, the funds are sufficient, and the amount is a bounded
;;   16-bit value — and the compiler PROVES the implementation obeys all three at
;;   once, on a single trust-report, through the call edges.
;;
;; Integrates, in one self-contained module (no cross-module import):
;;   1. STATE-SAFETY     — `step` is the RFC 793 connection state machine
;;                         (tcp_rfc793). States and events are real nullary-enum
;;                         sum types (`ConnState`/`Event`); verified.
;;   2. PAYMENT          — `debit` is the verified payment leaf (payments-core).
;;                         `open-and-pay` discharges its precondition at the call site.
;;   3. BOUNDED AMOUNT   — `amount: Word` is a refinement-typed 16-bit value
;;                         (return-refine). The Word bound supplies `amount >= 0`,
;;                         which discharges half of debit's precondition.
;;
;; OUTCOME ENCODING. `open-and-pay` returns a real payload-bearing sum,
;; `PayOutcome`: `Paid(debited-balance)` on success or `Rejected(code)` otherwise —
;; constructed natively (COMP-4 (a)/(c)) and discharged by constructor equality /
;; injectivity. No int sentinel: the outcome is a first-class constructor value, not
;; a `-1` masquerading as a balance. STATES and EVENTS stay real nullary enums.
;;
;; The post is the legal session-pay relation: pay (result = Paid(balance - amount))
;; IFF the (state,event) transition reaches ESTABLISHED *and* balance >= amount;
;; else Rejected(0).
;;
;;   llmll verify ./open-and-pay.llmll --trust-report
;;     -> step, debit, open-and-pay all verified; open-and-pay verified THROUGH
;;        the step and debit edges.
;;
;; Wrong twins: open-and-pay-bad-step (pays on an illegal transition),
;;              open-and-pay-unsafe (calls debit without the funds guard),
;;              open-and-pay-unbounded (drops the Word bound).
;;   Regenerate twin AST: llmll build ./open-and-pay.llmll --emit -o .

(type ConnState
  (| Closed)        ;; tag 0
  (| Listen)        ;; tag 1
  (| SynSent)       ;; tag 2
  (| SynRcvd)       ;; tag 3
  (| Established))  ;; tag 4

(type Event
  (| PassiveOpen)   ;; tag 0
  (| ActiveOpen)    ;; tag 1
  (| RcvSyn)        ;; tag 2
  (| RcvSynAck)     ;; tag 3
  (| RcvAck)        ;; tag 4
  (| SendData))     ;; tag 5

(type StepResult (where [r: int] (and (>= r 0) (<= r 5))))   ;; next state 0..4, or 5 = no legal transition
(type Word       (where [v: int] (and (>= v 0) (<= v 65535))))

;; The outcome is a real payload-bearing sum (COMP-4 (a)/(c)):
;;   Paid(n)     — n is the debited balance (balance - amount)
;;   Rejected(c) — c is a reason code (0 = guard failed)
(type PayOutcome
  (| Paid int)
  (| Rejected int))

;; --- 1. STATE-SAFETY: the RFC 793 state machine (verified leaf) -----------------
(def step [state: ConnState event: Event] -> StepResult
  (post
    (and (=> (and (= state Closed)      (= event PassiveOpen)) (= result 1))
    (and (=> (and (= state Closed)      (= event ActiveOpen))  (= result 2))
    (and (=> (and (= state Listen)      (= event RcvSyn))      (= result 3))
    (and (=> (and (= state SynSent)     (= event RcvSynAck))   (= result 4))
    (and (=> (and (= state SynRcvd)     (= event RcvAck))      (= result 4))
    (and (=> (and (= state Established) (= event SendData))    (= result 4))
         (or (and (= state Closed)      (= event PassiveOpen))
         (or (and (= state Closed)      (= event ActiveOpen))
         (or (and (= state Listen)      (= event RcvSyn))
         (or (and (= state SynSent)     (= event RcvSynAck))
         (or (and (= state SynRcvd)     (= event RcvAck))
         (or (and (= state Established) (= event SendData))
             (= result 5)
         ))))))))))))
    :source "RFC 793 §3.2 — connection state transition table")
  (if (and (= state Closed)      (= event PassiveOpen)) 1
  (if (and (= state Closed)      (= event ActiveOpen))  2
  (if (and (= state Listen)      (= event RcvSyn))      3
  (if (and (= state SynSent)     (= event RcvSynAck))   4
  (if (and (= state SynRcvd)     (= event RcvAck))      4
  (if (and (= state Established) (= event SendData))    4
    5)))))))

;; --- 2. PAYMENT: the verified payment leaf --------------------------------------
(def debit [balance: int amount: int] -> int
  (pre  (and (>= balance amount) (>= amount 0)))
  (post (and (= result (- balance amount)) (>= result 0)))
  (- balance amount))

;; --- 3. THE COMPOSER: session-gated, funds-guarded, bounded-amount payment ------
(def-shell open-and-pay [state: ConnState event: Event balance: int amount: Word] -> PayOutcome
  (pre (>= balance 0))
  (post
    (and (=> (and (or (and (= state SynSent)     (= event RcvSynAck))
                  (or (and (= state SynRcvd)     (= event RcvAck))
                      (and (= state Established) (= event SendData))))
                  (>= balance amount))
             (= result (Paid (- balance amount))))
         (=> (not (and (or (and (= state SynSent)     (= event RcvSynAck))
                       (or (and (= state SynRcvd)     (= event RcvAck))
                           (and (= state Established) (= event SendData))))
                       (>= balance amount)))
             (= result (Rejected 0))))
    :source "session-pay: pay iff a transition reaches ESTABLISHED (RFC 793 §3.2) and balance >= amount; else REJECTED")
  (let [[next (step state event)]]
    (if (and (= next 4) (>= balance amount))
        (let [[debited (debit balance amount)]] (Paid debited))
        (Rejected 0))))

(check "established + funds -> Paid; illegal transition -> Rejected"
  (for-all [balance: int amount: int]
    (if (and (>= balance 0) (and (>= amount 0) (and (<= amount 65535) (>= balance amount))))
        (and (= (open-and-pay SynSent RcvSynAck balance amount) (Paid (- balance amount)))   ;; SYN_SENT + RCV_SYN_ACK -> ESTABLISHED -> pay
             (= (open-and-pay Closed PassiveOpen balance amount) (Rejected 0)))              ;; CLOSED + PASSIVE_OPEN -> LISTEN (not established) -> reject
        true)))
