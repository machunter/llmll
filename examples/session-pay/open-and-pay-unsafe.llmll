;; session-pay WRONG TWIN #2 — drops the funds guard (payment safety violated).
;;
;; The body pays as soon as the session is ESTABLISHED, WITHOUT checking
;; `balance >= amount`. So nothing discharges debit's `(>= balance amount)`
;; precondition at the call site — the verifier REFUSES the code (call-site
;; precondition unmet), it never even reaches the postcondition.
;;   llmll verify ./open-and-pay-unsafe.llmll   -> call-site precondition of 'debit' not satisfied

(type ConnState
  (| Closed) (| Listen) (| SynSent) (| SynRcvd) (| Established))   ;; tags 0..4
(type Event
  (| PassiveOpen) (| ActiveOpen) (| RcvSyn) (| RcvSynAck) (| RcvAck) (| SendData))  ;; tags 0..5
(type StepResult (where [r: int] (and (>= r 0) (<= r 5))))
(type Word       (where [v: int] (and (>= v 0) (<= v 65535))))
(type PayOutcome (| Paid int) (| Rejected int))

(def step [state: ConnState event: Event] -> StepResult
  (post
    (and (=> (and (= state Closed)      (= event PassiveOpen)) (= result 1))
    (and (=> (and (= state Closed)      (= event ActiveOpen))  (= result 2))
    (and (=> (and (= state Listen)      (= event RcvSyn))      (= result 3))
    (and (=> (and (= state SynSent)     (= event RcvSynAck))   (= result 4))
    (and (=> (and (= state SynRcvd)     (= event RcvAck))      (= result 4))
    (and (=> (and (= state Established) (= event SendData))    (= result 4))
         (or (and (= state Closed)      (= event PassiveOpen))
         (or (and (= state Closed)      (= event ActiveOpen))
         (or (and (= state Listen)      (= event RcvSyn))
         (or (and (= state SynSent)     (= event RcvSynAck))
         (or (and (= state SynRcvd)     (= event RcvAck))
         (or (and (= state Established) (= event SendData))
             (= result 5)
         ))))))))))))
    :source "RFC 793 §3.2 — connection state transition table")
  (if (and (= state Closed)      (= event PassiveOpen)) 1
  (if (and (= state Closed)      (= event ActiveOpen))  2
  (if (and (= state Listen)      (= event RcvSyn))      3
  (if (and (= state SynSent)     (= event RcvSynAck))   4
  (if (and (= state SynRcvd)     (= event RcvAck))      4
  (if (and (= state Established) (= event SendData))    4
    5)))))))

(def debit [balance: int amount: int] -> int
  (pre  (and (>= balance amount) (>= amount 0)))
  (post (and (= result (- balance amount)) (>= result 0)))
  (- balance amount))

(def-shell open-and-pay [state: ConnState event: Event balance: int amount: Word] -> PayOutcome
  (pre (>= balance 0))
  (post
    (and (=> (and (or (and (= state SynSent)     (= event RcvSynAck))
                  (or (and (= state SynRcvd)     (= event RcvAck))
                      (and (= state Established) (= event SendData))))
                  (>= balance amount))
             (= result (Paid (- balance amount))))
         (=> (not (and (or (and (= state SynSent)     (= event RcvSynAck))
                       (or (and (= state SynRcvd)     (= event RcvAck))
                           (and (= state Established) (= event SendData))))
                       (>= balance amount)))
             (= result (Rejected 0))))
    :source "session-pay: pay iff a transition reaches ESTABLISHED (RFC 793 §3.2) and balance >= amount; else REJECTED")
  (let [[next (step state event)]]
    (if (= next 4)                                 ;; BUG: no `(>= balance amount)` guard
        (let [[debited (debit balance amount)]] (Paid debited))
        (Rejected 0))))
