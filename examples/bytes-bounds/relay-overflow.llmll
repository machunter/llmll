;; bytes-bounds — the refute crux for relay-buffer.llmll.
;;
;; Identical to relay-buffer's read, except the index is 40 and the relayed
;; buffer is 32 bytes. The caller knows the length only from `fresh32`'s
;; effective post, so this fixture is what distinguishes "the caller assumed a
;; length" from "the caller assumed a length it can actually reason with": if
;; the assumed post were decorative, index 40 would pass unnoticed.
;;
;; Expected REFUTED, localized at bytes-get.

;; The caller is a `def-shell` for the same STRICT-SIBLING reason as
;; relay-buffer.llmll; it does not affect the refutation.

(def fresh32 [] -> bytes[32]
  (bytes-zero))

(def-shell head-out-of-range [] -> int
  (post (and (>= result 0) (<= result 255)))
  (bytes-get (fresh32) 40))
