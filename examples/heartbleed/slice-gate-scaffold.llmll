;; ─────────────────────────────────────────────────────────────────────────
;; DELIVERY GATE — SCAFFOLD form. Same contracts as slice-gate.llmll, but every
;; body is an unfilled hole (?impl). This is what an orchestrated agent swarm
;; receives: a fully-contracted skeleton. Each hole is fillable independently
;; (modular verification checks each body against its own contract; callers
;; verify against callee CONTRACTS, not bodies). `llmll holes` enumerates the
;; fillable holes with RFC-6901 pointers; agents check out, fill, and verify.
;; ─────────────────────────────────────────────────────────────────────────

(def-shell payload-avail [record_len: int overhead: int] -> int
  (pre  (and (>= record_len 0) (and (>= overhead 0) (>= record_len overhead))))
  (post (and (>= result 0) (= result (- record_len overhead))))
  ?impl)

(def-shell gate-mac [n: int mac_ok: bool] -> int
  (pre  (>= n 0))
  (post (and (>= result 0) (and (<= result n) (=> (> result 0) mac_ok))))
  ?impl)

(def-shell gate-fresh [n: int last_seq: int incoming_seq: int] -> int
  (pre  (and (>= n 0) (and (>= last_seq 0) (>= incoming_seq 0))))
  (post (and (>= result 0) (and (<= result n) (=> (> result 0) (> incoming_seq last_seq)))))
  ?impl)

(def-shell gate-connected [n: int state: int] -> int
  (pre  (and (>= n 0) (>= state 0)))
  (post (and (>= result 0) (and (<= result n) (=> (> result 0) (>= state 5)))))
  ?impl)

(def-shell deliver-plaintext
    [record_len: int overhead: int last_seq: int incoming_seq: int mac_ok: bool state: int] -> int
  (pre  (and (>= record_len 0) (and (>= overhead 0) (and (>= record_len overhead)
             (and (>= last_seq 0) (and (>= incoming_seq 0)
             (>= state 0)))))))
  (post (and (>= result 0)
        (and (=> (> result 0) mac_ok)
        (and (=> (> result 0) (> incoming_seq last_seq))
             (=> (> result 0) (>= state 5))))))
  ?impl)
