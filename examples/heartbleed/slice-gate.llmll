;; ─────────────────────────────────────────────────────────────────────────
;; DELIVERY GATE — the load-bearing cross-component invariant of the flagship.
;;
;; A plaintext byte reaches the application ONLY IF all of:
;;   (1) its MAC verified            [goto-fail / CVE-2014-1266]
;;   (2) its sequence was fresh      [KRACK / replay]
;;   (3) the handshake is connected  [downgrade / state-confusion]
;;   (4) its record length was sound [Heartbleed / Ping-of-Death, via payload-avail]
;;
;; Each condition is supplied by ONE gate leaf's post-condition. The composer
;; `deliver-plaintext` chains them by NESTED CALLS (arg position — the ANF fix),
;; and its post is the CONJUNCTION of all four implications. That post is
;; provable ONLY because each leaf's contract carries (a) its own implication and
;; (b) the monotonicity `result <= n` that threads the running count down the
;; chain. Weaken any single leaf and the composer's post fails — a non-local,
;; cross-component refutation no unit test could establish.
;; ─────────────────────────────────────────────────────────────────────────

;; CONNECTED handshake state ordinal (0=start .. 5=connected).

;; Application payload available in a record of record_len (minus fixed overhead).
;; [Heartbleed / Ping-of-Death length discipline: result within record bounds.]
(def payload-avail [record_len: int overhead: int] -> int
  (pre  (and (>= record_len 0) (and (>= overhead 0) (>= record_len overhead))))
  (post (and (>= result 0) (= result (- record_len overhead))))
  (- record_len overhead))

;; Gate 1 — MAC. Pass the running count n only if the MAC verified.
;; [goto-fail]: result>0 => mac_ok=1. Also monotone: result <= n.
(def gate-mac [n: int mac_ok: int] -> int
  (pre  (and (>= n 0) (or (= mac_ok 0) (= mac_ok 1))))
  (post (and (>= result 0) (and (<= result n) (or (<= result 0) (= mac_ok 1)))))
  (if (= mac_ok 1) n 0))

;; Gate 2 — freshness. Pass the running count only if incoming seq is strictly ahead.
;; [KRACK / replay]: result>0 => incoming_seq > last_seq. Monotone: result <= n.
(def gate-fresh [n: int last_seq: int incoming_seq: int] -> int
  (pre  (and (>= n 0) (and (>= last_seq 0) (>= incoming_seq 0))))
  (post (and (>= result 0) (and (<= result n) (or (<= result 0) (> incoming_seq last_seq)))))
  (if (> incoming_seq last_seq) n 0))

;; Gate 3 — connected. Pass the running count only if the handshake reached CONNECTED (5).
;; [downgrade / state-confusion]: result>0 => state >= 5. Monotone: result <= n.
(def gate-connected [n: int state: int] -> int
  (pre  (and (>= n 0) (>= state 0)))
  (post (and (>= result 0) (and (<= result n) (or (<= result 0) (>= state 5)))))
  (if (>= state 5) n 0))

;; THE COMPOSER — nested calls in argument position (ANF fix). The post is the
;; four-way delivery gate: a positive delivery implies every upstream condition.
(def-shell deliver-plaintext
    [record_len: int overhead: int last_seq: int incoming_seq: int mac_ok: int state: int] -> int
  (pre  (and (>= record_len 0) (and (>= overhead 0) (and (>= record_len overhead)
             (and (>= last_seq 0) (and (>= incoming_seq 0)
             (and (or (= mac_ok 0) (= mac_ok 1)) (>= state 0))))))))
  (post (and (>= result 0)
        (and (or (<= result 0) (= mac_ok 1))
        (and (or (<= result 0) (> incoming_seq last_seq))
             (or (<= result 0) (>= state 5))))))
  (gate-connected
    (gate-fresh
      (gate-mac (payload-avail record_len overhead) mac_ok)
      last_seq incoming_seq)
    state))
