;; TCP RFC 793 — the CO-EVOLUTION starting point: a WEAK (under-specified) contract.
;;
;; Same buggy body as step-bad.llmll (allows SYN_SENT + SEND_DATA -> ESTABLISHED),
;; but the human-written contract is INCOMPLETE: it lists the six legal
;; transitions and forgets to say "every other (state,event) MUST be REJECTED."
;; A realistic spec gap. Against this weak post the buggy body VERIFIES — the bug
;; slips through, because nothing constrains the illegal pairs.
;;
;; This is the spec/implementation co-evolution beat:
;;   1. weak contract + buggy body      -> SAFE (the bug survives)
;;   2. llmll verify --cdp              -> low discriminative power (a degenerate
;;                                          impl satisfies the contract)
;;   3. add the rejection clause (cite RFC) -> step-bad.llmll
;;   4. re-verify                       -> refuted: step  (the bug is caught)
;;   llmll verify ./step-weak.llmll --strict-verified-core   ->  SAFE (survives)

(type ConnState  (where [s: int] (and (>= s 0) (<= s 4))))
(type Event      (where [e: int] (and (>= e 0) (<= e 5))))
(type StepResult (where [r: int] (and (>= r 0) (<= r 5))))

(def step [state: ConnState event: Event] -> StepResult
  (post
    (and (or (not (and (= state 0) (= event 0))) (= result 1))
    (and (or (not (and (= state 0) (= event 1))) (= result 2))
    (and (or (not (and (= state 1) (= event 2))) (= result 3))
    (and (or (not (and (= state 2) (= event 3))) (= result 4))
    (and (or (not (and (= state 3) (= event 4))) (= result 4))
         (or (not (and (= state 4) (= event 5))) (= result 4))
    )))))
    :source "RFC 793 §3.2 — legal transitions only (INCOMPLETE: no rejection clause)")
  (if (and (= state 0) (= event 0)) 1
  (if (and (= state 0) (= event 1)) 2
  (if (and (= state 1) (= event 2)) 3
  (if (and (= state 2) (= event 3)) 4
  (if (and (= state 3) (= event 4)) 4
  (if (and (= state 4) (= event 5)) 4
  (if (and (= state 2) (= event 5)) 4
    5))))))))
