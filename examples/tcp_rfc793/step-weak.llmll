;; TCP RFC 793 — the CO-EVOLUTION starting point: a WEAK (under-specified) post,
;; idiomatic enum types.
;;
;; The contract forbids the CLOSED -> ESTABLISHED jump but FORGETS the
;; LISTEN -> ESTABLISHED case — a realistic human spec gap. The body sneaks in an
;; illegal LISTEN + RcvAck -> ESTABLISHED transition; against the weak post it
;; VERIFIES — the bug slips through, because nothing forbids the LISTEN jump.
;;
;; This is the spec/implementation co-evolution beat:
;;   1. weak post + buggy body                 -> SAFE (the bug survives)
;;   2. notice it (human-in-the-loop): --cdp / --weakness-check do NOT auto-flag
;;      this (int,int)->refinement-style signature, so YOU spot the survival
;;   3. add the LISTEN clause, cite the RFC    -> step.llmll's full post
;;   4. re-verify                              -> refuted (the bug is caught)
;;   llmll verify ./step-weak.llmll --strict-verified-core  ->  SAFE (survives)

(type ConnState
  (| Closed)
  (| Listen)
  (| SynSent)
  (| SynRcvd)
  (| Established))

(type Event
  (| PassiveOpen)
  (| ActiveOpen)
  (| RcvSyn)
  (| RcvSynAck)
  (| RcvAck))

(def step [state: ConnState event: Event] -> ConnState
  (post
    ;; WEAK: forbids the CLOSED jump but omits the symmetric LISTEN clause.
    (not (and (= state Closed) (= result Established)))
    :source "RFC 793 §3.2 — no direct CLOSED -> ESTABLISHED (INCOMPLETE: omits LISTEN)")
  (match state
    ((Closed)      (match event ((PassiveOpen) Listen) ((ActiveOpen) SynSent) (_ Closed)))
    ((Listen)      (match event ((RcvSyn) SynRcvd) ((RcvAck) Established) (_ Listen)))
    ((SynSent)     (match event ((RcvSynAck) Established) (_ SynSent)))
    ((SynRcvd)     (match event ((RcvAck) Established) (_ SynRcvd)))
    ((Established)  Established)))
