;; TCP RFC 793 — connection state machine, idiomatic enum types.
;;
;; "Implement a protocol and let the compiler PROVE the implementation cannot
;;  violate the protocol's state-safety rules." States and events are real sum
;;  types and the body matches on them, reaching `verified` with NO int-encoding
;;  workaround: the compiler tags the nullary constructors internally
;;  (Closed=0 … Established=4) and discharges the post in pure QF-LIA
;;  (COMP-3b-general). See VERIFICATION_SCOPE.md for what is proven vs trusted.
;;
;; The `post` is a state-safety property authored FROM the RFC (not a copy of the
;; body): you cannot reach ESTABLISHED without the handshake — never straight from
;; CLOSED or LISTEN. A clean implementation satisfies it for all inputs; one that
;; skips the handshake is refuted and localized to the offending branch
;; (see step-bad.llmll).
;;   Regenerate twin: llmll build ./step.llmll --emit -o .

(type ConnState
  (| Closed)
  (| Listen)
  (| SynSent)
  (| SynRcvd)
  (| Established))

(type Event
  (| PassiveOpen)
  (| ActiveOpen)
  (| RcvSyn)
  (| RcvSynAck)
  (| RcvAck))

(def step [state: ConnState event: Event] -> ConnState
  (post
    (and (not (and (= state Closed) (= result Established)))
         (not (and (= state Listen) (= result Established))))
    :source "RFC 793 §3.2 — no direct CLOSED/LISTEN -> ESTABLISHED (handshake required)")
  (match state
    ((Closed)      (match event ((PassiveOpen) Listen) ((ActiveOpen) SynSent) (_ Closed)))
    ((Listen)      (match event ((RcvSyn) SynRcvd) (_ Listen)))
    ((SynSent)     (match event ((RcvSynAck) Established) (_ SynSent)))
    ((SynRcvd)     (match event ((RcvAck) Established) (_ SynRcvd)))
    ((Established)  Established)))
