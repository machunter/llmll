;; TCP RFC 793 — connection state machine, real outcome sum (COMP-4 (a)/(c)).
;;
;; "Implement a protocol and let the compiler PROVE the implementation maps EVERY
;;  (state, event) input to the right outcome." States and events are real nullary
;;  enums; the RESULT is a real payload-bearing sum, `StepOutcome`:
;;    Next(s)     — a legal transition, s = the next-state tag (Listen=1 … Established=4)
;;    Rejected(c) — an illegal (state, event) pair, c = a reason code (0)
;;  constructed natively (COMP-4 (a)/(c)) and discharged by constructor equality /
;;  refuted by injectivity. No `5 = REJECTED` int sentinel: the reject is a real
;;  constructor value, distinct from any next-state by Z3's datatype theory.
;;
;; The `post` is the FULL transition-table totality, authored FROM the RFC (not a
;; copy of the body): each legal pair maps to its specific `Next(tag)` via the `=>`
;; implication sugar (v0.14.16), and every pair outside the legal table maps to
;; `Rejected`. This is stronger than the earlier enum re-type (which proved only the
;; partial "no CLOSED/LISTEN -> ESTABLISHED" safety): the real outcome sum restores
;; the full totality the int-sentinel version once carried, WITHOUT the sentinel. A
;; body that skips the handshake is refuted and localized to the offending branch
;; (see step-bad.llmll).
;;   Regenerate twin: llmll build ./step.llmll --emit -o .

(type ConnState
  (| Closed)        ;; tag 0
  (| Listen)        ;; tag 1
  (| SynSent)       ;; tag 2
  (| SynRcvd)       ;; tag 3
  (| Established))  ;; tag 4

(type Event
  (| PassiveOpen)
  (| ActiveOpen)
  (| RcvSyn)
  (| RcvSynAck)
  (| RcvAck))

;; The outcome is a real payload-bearing sum (COMP-4 (a)/(c)):
;;   Next(s)     — legal transition, s = next-state tag
;;   Rejected(c) — illegal (state,event) pair, c = reason code
(type StepOutcome
  (| Next int)
  (| Rejected int))

(def step [state: ConnState event: Event] -> StepOutcome
  (post
    (and (=> (and (= state Closed)  (= event PassiveOpen)) (= result (Next 1)))
    (and (=> (and (= state Closed)  (= event ActiveOpen))  (= result (Next 2)))
    (and (=> (and (= state Listen)  (= event RcvSyn))      (= result (Next 3)))
    (and (=> (and (= state SynSent) (= event RcvSynAck))   (= result (Next 4)))
    (and (=> (and (= state SynRcvd) (= event RcvAck))      (= result (Next 4)))
         (or (and (= state Closed)  (= event PassiveOpen))
         (or (and (= state Closed)  (= event ActiveOpen))
         (or (and (= state Listen)  (= event RcvSyn))
         (or (and (= state SynSent) (= event RcvSynAck))
         (or (and (= state SynRcvd) (= event RcvAck))
             (= result (Rejected 0))
         ))))))))))
    :source "RFC 793 §3.2 — connection state transition table; illegal pairs -> REJECTED")
  (if (and (= state Closed)  (= event PassiveOpen)) (Next 1)
  (if (and (= state Closed)  (= event ActiveOpen))  (Next 2)
  (if (and (= state Listen)  (= event RcvSyn))      (Next 3)
  (if (and (= state SynSent) (= event RcvSynAck))   (Next 4)
  (if (and (= state SynRcvd) (= event RcvAck))      (Next 4)
    (Rejected 0)))))))
