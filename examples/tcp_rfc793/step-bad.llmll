;; TCP RFC 793 — the WRONG twin (REFUTED), idiomatic enum types.
;;
;; Identical to step.llmll EXCEPT the CLOSED + ActiveOpen arm jumps straight to
;; ESTABLISHED, skipping the SYN_SENT handshake. It type-checks (ConnState in,
;; ConnState out) and passes the happy-path `check` (a valid handshake never hits
;; that pair), but the solver REFUTES it against the state-safety post for the
;; (Closed, ActiveOpen) input — localized to that branch.
;;   llmll verify ./step-bad.llmll --strict-verified-core  ->  refuted: step

(type ConnState
  (| Closed)
  (| Listen)
  (| SynSent)
  (| SynRcvd)
  (| Established))

(type Event
  (| PassiveOpen)
  (| ActiveOpen)
  (| RcvSyn)
  (| RcvSynAck)
  (| RcvAck))

(def step [state: ConnState event: Event] -> ConnState
  (post
    (and (not (and (= state Closed) (= result Established)))
         (not (and (= state Listen) (= result Established))))
    :source "RFC 793 §3.2 — no direct CLOSED/LISTEN -> ESTABLISHED (handshake required)")
  (match state
    ((Closed)      (match event ((PassiveOpen) Listen) ((ActiveOpen) Established) (_ Closed)))
    ((Listen)      (match event ((RcvSyn) SynRcvd) (_ Listen)))
    ((SynSent)     (match event ((RcvSynAck) Established) (_ SynSent)))
    ((SynRcvd)     (match event ((RcvAck) Established) (_ SynRcvd)))
    ((Established)  Established)))
