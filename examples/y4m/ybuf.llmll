;; GENERATED by tools/fill.py from holed/ybuf.llmll and fills/ybuf.sexp.
;; The patched artifact is ybuf.ast.json; this file emits the same JSON-AST.
;; ybuf — LEVEL 1 of the y4m verified core.
;; Depends on: raster, xform. Verify raster.llmll and xform.llmll first.
;;
;; The index and slice decisions over the file's `bytes` buffer. The shell
;; reads the whole file with wasi.fs.read-bytes and keeps it as one buffer;
;; these defs find the header end and the FRAME markers, and cut the planes
;; and rows out of a frame payload with O(1) slices.
;;
;; Every index is a parameter or a linear term over parameters (no index is
;; bound by `let` and read twice through a slice, CONE-DEF-DIRECTION-1).
;; The two loops are `def-shell` because only a `def-shell` takes a
;; `(decreases …)` clause; each one's body verifies and its measure
;; discharges, so both are body-faithful and total.

(import raster)
(open raster)
(import xform)
(open xform)

;; ─── Header and markers ─────────────────────────────────────────────────

;; Offset of the first LF (10) at or after i, or -1 when there is none.
;; Rejects a guard (<= i (bytes-length buf)), which reads past the end.
(def-shell find-lf [buf: bytes i: int] -> int
  (pre  (and (>= i 0) (<= i (bytes-length buf))))
  (post (or (= result -1) (and (>= result i) (< result (bytes-length buf)))))
  (decreases (- (bytes-length buf) i))
  (if (< i (bytes-length buf))
      (if (= (bytes-get buf i) 10) i (find-lf buf (+ i 1)))
      -1))

;; Walk a FRAME marker from offset i in marker state k (raster.marker-step).
;; The offset just after the marker's LF, -1 for a malformed marker, -2 when
;; the buffer ends inside the marker.
;; Rejects a walk that answers the offset of the LF itself.
(def-shell marker-end [buf: bytes i: int k: int] -> int
  (pre  (and (>= i 0) (and (<= i (bytes-length buf)) (or (and (>= k 0) (<= k 5)) (= k 7)))))
  (post (or (< result 0) (and (> result i) (<= result (bytes-length buf)))))
  (decreases (- (bytes-length buf) i))
  (if (>= i (bytes-length buf)) -2
    (let [(k2 (marker-step k (bytes-get buf i)))]
      (if (= k2 -1) -1 (if (= k2 6) (+ i 1) (marker-end buf (+ i 1) k2))))))

;; ─── Planes and rows ────────────────────────────────────────────────────

;; The luma plane of a frame payload: its first w*h bytes.
;; Rejects a plane one row short.
(def luma-plane [fr: bytes w: int h: int] -> bytes
  (pre  (and (>= w 1) (and (>= h 1) (>= (bytes-length fr) (* w h)))))
  (post (= (bytes-length result) (* w h)))
  (bytes-slice fr 0 (* w h)))

;; Columns x0 .. x0+cw-1 of the pw-wide row that starts at offset ro of a plane.
;; Rejects a window one column too wide, and one shifted right by a column.
(def crop-row [pl: bytes ro: int pw: int x0: int cw: int] -> bytes
  (pre  (and (>= ro 0) (and (>= pw 1) (and (<= (+ ro pw) (bytes-length pl))
        (and (>= x0 0) (and (>= cw 1) (<= (+ x0 cw) pw)))))))
  (post (= (bytes-length result) cw))
  (bytes-slice (bytes-slice pl ro (+ ro pw)) x0 (+ x0 cw)))

;; Output column ox of a mirrored row: the input byte at (xform.hflip-src).
;; Rejects the off-by-one index (- len ox).
(def hflip-at [row: bytes ox: int] -> int
  (pre  (and (>= (bytes-length row) 1) (and (>= ox 0) (< ox (bytes-length row)))))
  (post (and (>= result 0) (<= result 255)))
  (bytes-get row (hflip-src (bytes-length row) ox)))
