;; y4m — SHELL layer: the YUV4MPEG2 (4:2:0) codec over a byte buffer.
;; Depends on: raster, hdr, xform, ybuf. Verify those first.
;;
;; A file arrives as one `bytes` buffer (wasi.fs.read-bytes) and leaves as
;; one (wasi.fs.write-bytes). A frame payload is an O(1) slice of the input.
;;
;;   Hdr    = ((w, h), (rn, rd))          frame rate rn/rd
;;   Frame  = bytes                       the payload: Y rows, U rows, V rows
;;   Video  = (Hdr, (header line without its LF, list[Frame]))
;;
;; Every per-byte, per-index and per-header decision is a verified core def:
;;   header fields      hdr.num-step, hdr.param-tag, hdr.magic-byte,
;;                      hdr.chroma-420?, hdr.header-problem
;;   header end, marker ybuf.find-lf, ybuf.marker-end (raster.marker-step)
;;   payload layout     raster.frame-size, raster.chroma-dim
;;   transforms         ybuf.hflip-at (xform.hflip-src), ybuf.crop-row,
;;                      ybuf.luma-plane, xform.crop-ok?
;; Only the header line is turned into a list[int], for the token logic.
;; This module only walks lists and indexes and joins buffers.

(import raster)
(open raster)
(import hdr)
(open hdr)
(import xform)
(open xform)
(import ybuf)
(open ybuf)

(type Hdr   ((int, int), (int, int)))
(type Video (Hdr, (bytes, list[bytes])))

;; ─── Accessors ──────────────────────────────────────────────────────────

;; One-level projections verify; a nested one falls back in a def
;; (netpbm-swarm FRICTION F5), so the shell composes these.
(def hdr-size [h: Hdr] -> (int, int) (post (= result (first h))) (first h))
(def hdr-rate [h: Hdr] -> (int, int) (post (= result (second h))) (second h))
(def pair-a   [q: (int, int)] -> int (post (= result (first q))) (first q))
(def pair-b   [q: (int, int)] -> int (post (= result (second q))) (second q))

(def-shell hdr-w  [h: Hdr] -> int (pair-a (hdr-size h)))
(def-shell hdr-h  [h: Hdr] -> int (pair-b (hdr-size h)))
(def-shell hdr-rn [h: Hdr] -> int (pair-a (hdr-rate h)))
(def-shell hdr-rd [h: Hdr] -> int (pair-b (hdr-rate h)))

(def-shell vid-hdr    [v: Video] -> Hdr (first v))
(def-shell vid-line   [v: Video] -> bytes (first (second v)))
(def-shell vid-frames [v: Video] -> list[bytes] (second (second v)))

;; ─── Header line bytes ──────────────────────────────────────────────────

;; Split a byte list at every sep byte. Empty pieces are kept.
(def-shell split-on [sep: int bs: list[int]] -> list[list[int]]
  (let [(r (list-fold bs (pair (list-empty) (list-empty))
             (fn [acc: (list[int], list[list[int]]) b: int]
               (if (= b sep)
                   (pair (list-empty) (list-prepend (list-reverse (first acc)) (second acc)))
                   (pair (list-prepend b (first acc)) (second acc))))))]
    (list-reverse (list-prepend (list-reverse (first r)) (second r)))))

;; The bytes of the header line after "YUV4MPEG2 " (none when it is shorter).
(def-shell header-rest [hl: bytes] -> list[int]
  (let [(n (bytes-length hl))]
    (bytes-to-list (if (>= n 10) (bytes-slice hl 10 n) (bytes-slice hl n n)))))

;; The space-separated parameter tokens of the header line, empty ones dropped.
(def-shell header-tokens [hl: bytes] -> list[list[int]]
  (list-filter (split-on 32 (header-rest hl))
               (fn [t: list[int]] (>= (list-length t) 1))))

(def-shell byte-at [bs: list[int] i: int] -> int
  (unwrap-or (list-nth bs i) -1))

;; A token without its tag byte.
(def-shell token-value [t: list[int]] -> list[int]
  (unwrap-or (list-tail t) (list-empty)))

;; Decimal value of a field: -1 empty, -2 malformed (hdr.num-step).
(def-shell parse-num [bs: list[int]] -> int
  (list-fold bs -1 (fn [v: int b: int] (num-step v b))))

;; The first 9 bytes are "YUV4MPEG2" and the 10th is a space or absent.
(def-shell magic-ok? [hb: list[int]] -> bool
  (let [(r (list-fold hb (pair 0 true)
             (fn [acc: (int, bool) b: int]
               (let [(i (first acc))]
                 (pair (+ i 1)
                       (and (second acc)
                            (if (<= i 8) (= b (magic-byte i))
                                (if (= i 9) (= b 32) true))))))))]
    (and (second r) (>= (first r) 9))))

;; ─── Text of bytes (no char-code builtin: FRICTION F2) ───────────────────

(def-shell ascii-table [] -> string
  " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~")

(def-shell ascii-text [bs: list[int]] -> string
  (string-concat-many
    (list-map bs (fn [b: int]
      (if (and (>= b 32) (<= b 126)) (string-char-at (ascii-table) (- b 32)) "?")))))

;; ─── Header ─────────────────────────────────────────────────────────────

(def-shell problem-text [code: int tok: string] -> string
  (if (= code 1) "missing width (W)"
  (if (= code 2) "malformed width (W)"
  (if (= code 3) "missing height (H)"
  (if (= code 4) "malformed height (H)"
  (if (= code 5) "width must be in 1..16384"
  (if (= code 6) "height must be in 1..16384"
  (if (= code 7) "missing frame rate (F)"
  (if (= code 8) "malformed frame rate (F), expected F<n>:<d>"
  (if (= code 9) "frame rate terms must be at least 1"
      (string-concat-many ["colour space '" tok "' is not 4:2:0"])))))))))))

;; Header line (no LF) -> Hdr.
;; Fold state over the tokens: ((w, h), ((rn, rd), (c420, ctext))).
(def-shell parse-header [hl: bytes] -> Result[Hdr, string]
  (if (not (magic-ok? (bytes-to-list hl)))
      (err "not a YUV4MPEG2 stream (bad magic)")
      (let [(r (list-fold (header-tokens hl) (pair (pair -1 -1) (pair (pair -1 -1) (pair true "")))
                 (fn [acc: ((int, int), ((int, int), (bool, string))) t: list[int]]
                   (let [(tag (param-tag (byte-at t 0)))
                         (val (token-value t))
                         (w (first (first acc))) (h (second (first acc)))
                         (rate (first (second acc))) (cs (second (second acc)))]
                     (if (= tag 1) (pair (pair (parse-num val) h) (second acc))
                     (if (= tag 2) (pair (pair w (parse-num val)) (second acc))
                     (if (= tag 3)
                         (let [(parts (split-on 58 val))]
                           (pair (first acc)
                                 (pair (if (= (list-length parts) 2)
                                           (pair (parse-num (unwrap-or (list-nth parts 0) (list-empty)))
                                                 (parse-num (unwrap-or (list-nth parts 1) (list-empty))))
                                           (pair -2 -2))
                                       cs)))
                     (if (= tag 6)
                         (pair (first acc)
                               (pair rate
                                     (pair (chroma-420? (byte-at val 0) (byte-at val 1) (byte-at val 2))
                                           (ascii-text t))))
                         acc))))))))
            (w (first (first r))) (h (second (first r)))
            (rn (first (first (second r)))) (rd (second (first (second r))))
            (c420 (first (second (second r)))) (ctext (second (second (second r))))
            (code (header-problem w h rn rd c420))]
        (if (= code 0)
            (ok (pair (pair w h) (pair rn rd)))
            (err (problem-text code ctext))))))

;; ─── Frames ─────────────────────────────────────────────────────────────

(def-shell plane-name [p: int] -> string
  (if (= p 0) "Y" (if (= p 1) "U" "V")))

;; Where a payload of r < frame-size bytes ends: plane, row and column of
;; the first missing sample.
(def-shell truncated-text [w: int h: int nf: int r: int] -> string
  (pre  (and (>= w 1) (and (>= h 1) (>= r 0))))
  (let [(cw (chroma-dim w)) (ca (* (chroma-dim w) (chroma-dim h))) (la (* w h))
        (p (if (< r la) 0 (if (< r (+ la ca)) 1 2)))
        (o (if (= p 0) r (if (= p 1) (- r la) (- r (+ la ca)))))
        (pw (if (= p 0) w cw))]
    (string-concat-many ["frame " (int-to-string nf) " is truncated: the payload ends in the "
                         (plane-name p) " plane at row " (int-to-string (/ o pw))
                         ", column " (int-to-string (mod o pw))])))

;; The frame payloads from offset pos on, each fsz bytes after its FRAME
;; marker. acc holds the frames before pos, last first.
(def-shell frames-from [w: int h: int buf: bytes pos: int acc: list[bytes]] -> Result[list[bytes], string]
  (pre  (and (>= w 1) (and (>= h 1) (and (>= pos 0) (<= pos (bytes-length buf))))))
  (let [(n (bytes-length buf)) (nf (list-length acc))]
    (if (>= pos n)
        (ok (list-reverse acc))
        (let [(e (marker-end buf pos 0)) (fsz (frame-size w h))]
          (if (= e -1)
              (err (string-concat-many ["frame " (int-to-string nf) ": bad FRAME marker"]))
          (if (< e 0)
              (err (string-concat-many ["frame " (int-to-string nf) " is truncated inside its FRAME marker"]))
          (if (> (+ e fsz) n)
              (err (truncated-text w h nf (- n e)))
              (frames-from w h buf (+ e fsz) (list-prepend (bytes-slice buf e (+ e fsz)) acc)))))))))

;; Whole file -> Video.
(def-shell decode [buf: bytes] -> Result[Video, string]
  (let [(nl (find-lf buf 0))]
    (if (< nl 0)
        (err "no header line (no LF)")
        (let [(hl (bytes-slice buf 0 nl))]
          (match (parse-header hl)
            ((Error e) (err e))
            ((Success hd)
              (match (frames-from (hdr-w hd) (hdr-h hd) buf (+ nl 1) (list-empty))
                ((Error e) (err e))
                ((Success frames) (ok (pair hd (pair hl frames)))))))))))

;; ─── Transforms ─────────────────────────────────────────────────────────

;; Rows y0 .. y0+ch-1 of the pw-wide plane at offset off of fr, each passed
;; to f with its offset in fr; the results joined.
(def-shell plane-rows [fr: bytes off: int pw: int y0: int ch: int f: (fn [int] -> bytes)] -> bytes
  (bytes-concat-many (list-map (range y0 (+ y0 ch)) (fn [y: int] (f (+ off (* y pw)))))))

;; One mirrored row (ybuf.hflip-at per output column).
(def-shell hflip-row [row: bytes] -> bytes
  (let [(pw (bytes-length row))]
    (unwrap-or (bytes-from-list (list-map (range 0 pw) (fn [ox: int] (hflip-at row ox))))
               row)))

(def-shell hflip-frame [w: int h: int fr: bytes] -> bytes
  (pre  (and (>= w 1) (>= h 1)))
  (let [(cw (chroma-dim w)) (ch (chroma-dim h)) (la (* w h)) (ca (* (chroma-dim w) (chroma-dim h)))]
    (bytes-concat-many
      [(plane-rows fr 0 w 0 h (fn [ro: int] (hflip-row (bytes-slice fr ro (+ ro w)))))
       (plane-rows fr la cw 0 ch (fn [ro: int] (hflip-row (bytes-slice fr ro (+ ro cw)))))
       (plane-rows fr (+ la ca) cw 0 ch (fn [ro: int] (hflip-row (bytes-slice fr ro (+ ro cw)))))])))

;; The window (x0, y0, cw, ch) of the Y plane, and (x0/2, y0/2, ceil(cw/2),
;; ceil(ch/2)) of U and V (xform.crop-keep?), row by row with ybuf.crop-row.
(def-shell crop-frame [w: int h: int x0: int y0: int cw: int ch: int fr: bytes] -> bytes
  (pre  (and (>= w 1) (and (>= h 1) (and (>= x0 0) (and (>= y0 0) (and (>= cw 1) (>= ch 1)))))))
  (let [(pcw (chroma-dim w)) (la (* w h)) (ca (* (chroma-dim w) (chroma-dim h)))
        (cx (/ x0 2)) (cy (/ y0 2)) (ccw (chroma-dim cw)) (cch (chroma-dim ch))]
    (bytes-concat-many
      [(plane-rows fr 0 w y0 ch (fn [ro: int] (crop-row fr ro w x0 cw)))
       (plane-rows fr la pcw cy cch (fn [ro: int] (crop-row fr ro pcw cx ccw)))
       (plane-rows fr (+ la ca) pcw cy cch (fn [ro: int] (crop-row fr ro pcw cx ccw)))])))

;; ─── Bytes out ──────────────────────────────────────────────────────────

(def-shell ascii-bytes [s: string] -> bytes (bytes-from-string s))

;; A token's bytes, copied (each came from a byte of the input).
(def-shell token-bytes [t: list[int]] -> bytes
  (unwrap-or (bytes-from-list t) (bytes-from-string "")))

;; The header line with W and H replaced (the other tokens are copied).
(def-shell header-bytes [hl: bytes w: int h: int] -> bytes
  (pre  (and (>= w 1) (>= h 1)))
  (bytes-concat-many
    [(ascii-bytes "YUV4MPEG2")
     (bytes-concat-many
       (list-map (header-tokens hl) (fn [t: list[int]]
         (let [(tag (param-tag (byte-at t 0)))]
           (bytes-concat (ascii-bytes " ")
             (if (= tag 1) (ascii-bytes (string-concat "W" (int-to-string w)))
             (if (= tag 2) (ascii-bytes (string-concat "H" (int-to-string h)))
                 (token-bytes t))))))))
     (ascii-bytes "\n")]))

(def-shell encode-y4m [v: Video w: int h: int frames: list[bytes]] -> bytes
  (pre  (and (>= w 1) (>= h 1)))
  (bytes-concat (header-bytes (vid-line v) w h)
                (bytes-concat-many
                  (list-map frames (fn [fr: bytes] (bytes-concat (ascii-bytes "FRAME\n") fr))))))

;; Binary PGM (P5, maxval 255) of the luma plane of a frame payload.
(def-shell encode-pgm [w: int h: int fr: bytes] -> bytes
  (pre  (and (>= w 1) (>= h 1)))
  (bytes-concat
    (ascii-bytes (string-concat-many ["P5\n" (int-to-string w) " " (int-to-string h) "\n255\n"]))
    (luma-plane fr w h)))
