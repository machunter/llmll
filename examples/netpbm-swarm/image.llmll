;; image — SHELL layer (level 4): whole-image transforms.
;; Depends on: types, rules, sample, geom, kernel, blur, codec. Verify those first.
;;
;; Each transform only walks rows and indices. Every output sample is computed
;; by a verified core def:
;;   invert     sample.invert-sample        threshold  sample.threshold-sample
;;   hflip      kernel.hflip-sample         crop       geom.crop-row?, kernel.crop-sample
;;   grayscale  kernel.gray-sample          blur       blur.blur-sample (+ sample.clamp-coord)
;;   vflip      list-reverse on the rows (no per-sample work)
;; Index-based transforms read a row as map[int,int] with keys 0..L-1
;; (row-map), which is the convention kernel's posts are stated over.
;;
;; Contracts here are runtime-checked (def-shell): pre (image-ok? img) and a
;; post of image-ok? plus the header facts. The whole-image facts (the
;; involutions, identities) are `check` properties: no list producer has a
;; length fact and there are no quantifiers, so none of this can be proved.

(import types)
(open types)
(import rules)
(open rules)
(import sample)
(open sample)
(import geom)
(open geom)
(import kernel)
(open kernel)
(import blur)
(open blur)
(import codec)
(open codec)

;; A row as index -> sample.
(def-shell row-map [row: list[int]] -> map[int, int]
  (post (and (not (map-has result (list-length row)))
             (=> (>= (list-length row) 1)
                 (and (map-has result 0) (map-has result (- (list-length row) 1))))))
  (second
    (list-fold row (pair 0 (map-empty))
      (fn [acc: (int, map[int, int]) s: int]
        (pair (+ (first acc) 1) (map-put (second acc) (first acc) s))))))

;; Row y of an index -> row-map table, or the empty map.
(def-shell row-at [t: map[int, map[int, int]] y: int] -> map[int, int]
  (if (map-has t y) (map-get t y) (map-empty)))

(def-shell same-shape? [a: Image b: Image] -> bool
  (= (img-header a) (img-header b)))

(def-shell img-invert [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (same-shape? result img)))
  (let [(m (img-maxval img))]
    (mk-image (img-header img)
      (list-map (img-rows img)
        (fn [row: list[int]] (list-map row (fn [s: int] (invert-sample m s))))))))

(def-shell img-threshold [t: int img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (same-shape? result img)))
  (let [(m (img-maxval img))]
    (mk-image (img-header img)
      (list-map (img-rows img)
        (fn [row: list[int]] (list-map row (fn [s: int] (threshold-sample m t s))))))))

(def-shell img-vflip [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (same-shape? result img)))
  (mk-image (img-header img) (list-reverse (img-rows img))))

(def-shell img-hflip [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (same-shape? result img)))
  (let [(c (img-channels img))
        (m (img-maxval img))
        (w (img-width img))
        (len (row-len c w))]
    (mk-image (img-header img)
      (list-map (img-rows img)
        (fn [row: list[int]]
          (let [(rm (row-map row))]
            (list-map (range 0 len) (fn [i: int] (hflip-sample m c w rm i)))))))))

;; The cw x ch window whose top-left corner is (x, y).
(def-shell img-crop [x: int y: int cw: int ch: int img: Image] -> Image
  (pre  (and (image-ok? img) (crop-ok? (img-width img) (img-height img) x y cw ch)))
  (post (and (image-ok? result)
        (and (= (img-width result) cw)
        (and (= (img-height result) ch)
        (and (= (img-channels result) (img-channels img))
             (= (img-maxval result) (img-maxval img)))))))
  (let [(c (img-channels img))
        (m (img-maxval img))
        (w (img-width img))
        (len (row-len c cw))
        (sel (list-reverse
               (second
                 (list-fold (img-rows img) (pair 0 (list-empty))
                   (fn [acc: (int, list[list[int]]) row: list[int]]
                     (pair (+ (first acc) 1)
                           (if (crop-row? y ch (first acc))
                               (list-prepend row (second acc))
                               (second acc))))))))]
    (make-image c m cw ch
      (list-map sel
        (fn [row: list[int]]
          (let [(rm (row-map row))]
            (list-map (range 0 len) (fn [i: int] (crop-sample m c w x cw rm i)))))))))

;; P3 -> P2 with integer luma (77r + 150g + 29b) / 256; P2 is returned unchanged.
(def-shell img-grayscale [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result)
        (and (= (img-channels result) 1)
        (and (= (img-width result) (img-width img))
        (and (= (img-height result) (img-height img))
             (= (img-maxval result) (img-maxval img)))))))
  (let [(c (img-channels img))
        (m (img-maxval img))
        (w (img-width img))]
    (if (= c 1)
        img
        (make-image 1 m w (img-height img)
          (list-map (img-rows img)
            (fn [row: list[int]]
              (let [(rm (row-map row))]
                (list-map (range 0 w) (fn [x: int] (gray-sample m w rm x))))))))))

;; 3x3 box blur with edge replication. The rows are held in an index ->
;; row-map table, so finding the row above and below is O(log h).
(def-shell img-blur [img: Image] -> Image
  (pre  (image-ok? img))
  (post (and (image-ok? result) (same-shape? result img)))
  (let [(c (img-channels img))
        (m (img-maxval img))
        (w (img-width img))
        (h (img-height img))
        (len (row-len c w))
        (t (second
             (list-fold (img-rows img) (pair 0 (map-empty))
               (fn [acc: (int, map[int, map[int, int]]) row: list[int]]
                 (pair (+ (first acc) 1) (map-put (second acc) (first acc) (row-map row)))))))]
    (mk-image (img-header img)
      (list-map (range 0 h)
        (fn [y: int]
          (let [(above (row-at t (clamp-coord h (- y 1))))
                (cur   (row-at t y))
                (below (row-at t (clamp-coord h (+ y 1))))]
            (list-map (range 0 len)
              (fn [i: int] (blur-sample m c w above cur below i)))))))))

;; ─── Properties (whole-image facts no post can state) ───────────────────
;; Images are built with codec.make-image directly, not through decode: a
;; property that reaches lex's constructors through an imported callee does
;; not reduce in `llmll test` (see FRICTION.md).

(def-shell gen-image [cs: int ws: int hs: int ms: int vs: int] -> Image
  (post (image-ok? result))
  (let [(c (if (= (mod (abs cs) 2) 0) 1 3))
        (w (+ 1 (mod (abs ws) 4)))
        (h (+ 1 (mod (abs hs) 4)))
        (m (+ 1 (mod (abs ms) 255)))
        (len (row-len c w))]
    (make-image c m w h
      (list-map (range 0 h)
        (fn [y: int] (list-map (range 0 len)
                       (fn [i: int] (mod (+ (+ (* y 101) (* i 37)) (abs vs)) (+ m 1)))))))))

(check "invert is an involution" :subject img-invert
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (gen-image cs ws hs ms vs))]
      (= (img-invert (img-invert img)) img))))

(check "hflip is an involution" :subject img-hflip
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (gen-image cs ws hs ms vs))]
      (= (img-hflip (img-hflip img)) img))))

(check "vflip is an involution" :subject img-vflip
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (gen-image cs ws hs ms vs))]
      (= (img-vflip (img-vflip img)) img))))

(check "hflip keeps pixels whole (P3 channel order survives)" :subject img-hflip
  (for-all [g: int]
    (let [(img (make-image 3 255 2 1 [[1 2 3 4 5 6]]))]
      (= (img-rows (img-hflip img)) [[4 5 6 1 2 3]]))))

(check "full-size crop is the identity" :subject img-crop
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (gen-image cs ws hs ms vs))]
      (= (img-crop 0 0 (img-width img) (img-height img) img) img))))

(check "crop picks the right window" :subject img-crop
  (for-all [g: int]
    (let [(img (make-image 1 9 3 3 [[1 2 3] [4 5 6] [7 8 9]]))]
      (= (img-rows (img-crop 1 1 2 2 img)) [[5 6] [8 9]]))))

(check "grayscale of a gray P3 image keeps the gray levels" :subject img-grayscale
  (for-all [ws: int hs: int ms: int vs: int]
    (let [(p2 (gen-image 0 ws hs ms vs))
          (p3 (make-image 3 (img-maxval p2) (img-width p2) (img-height p2)
                (list-map (img-rows p2)
                  (fn [row: list[int]]
                    (list-reverse (list-fold row (list-empty)
                      (fn [a: list[int] s: int] (list-prepend s (list-prepend s (list-prepend s a))))))))))]
      (= (img-grayscale p3) p2))))

(check "threshold yields only 0 and maxval" :subject img-threshold
  (for-all [cs: int ws: int hs: int ms: int vs: int t: int]
    (let [(img (gen-image cs ws hs ms vs))
          (m (img-maxval img))]
      (list-fold (img-rows (img-threshold t img)) true
        (fn [a: bool row: list[int]]
          (list-fold row a (fn [b: bool s: int] (and b (or (= s 0) (= s m))))))))))

(check "blur of a constant image is the identity" :subject img-blur
  (for-all [cs: int ws: int hs: int ms: int v: int]
    (let [(img0 (gen-image cs ws hs ms 0))
          (m (img-maxval img0))
          (img (mk-image (img-header img0)
                 (list-map (img-rows img0)
                   (fn [row: list[int]] (list-map row (fn [s: int] (mod (abs v) (+ m 1))))))))]
      (= (img-blur img) img))))

(check "blur of a 3x3 P2 image" :subject img-blur
  (for-all [g: int]
    (let [(img (make-image 1 90 3 3 [[0 0 0] [0 90 0] [0 0 0]]))]
      (= (img-rows (img-blur img)) [[10 10 10] [10 10 10] [10 10 10]]))))
