;; codec — SHELL layer (level 2): decode and encode plain PGM (P2) / PPM (P3).
;; Depends on: types, lex, rules. Verify those first.
;;
;; Everything here walks a string or a list, which the verifier cannot reason
;; about, so it is def-shell. Every decision is delegated to the verified core:
;;   characters   lex.char-class / lex-emit / lex-step / lex-flush / sep-ok?
;;   header       rules.magic-channels / header-problem
;;   samples      rules.sample-problem, the (r, k) counter next-k / next-r,
;;                and count-problem at the end
;;   line layout  rules.sep-after
;; The few defs below are not shell: they are compositions of verified
;; accessors in types, and verify body-faithful.
;;
;; The Problem returned by the core is rendered by MATCHING on it; no contract
;; here compares a value with a Problem constructor (that crashes the solver
;; for an imported sum, see types.llmll).

(import types)
(open types)
(import lex)
(open lex)
(import rules)
(open rules)

;; ─── Verified header accessors (compositions of one-level projections) ──

(def img-channels [img: Image] -> int
  (post (= result (first (first (first img)))))
  (fmt-channels (hdr-fmt (img-header img))))

(def img-maxval [img: Image] -> int
  (post (= result (second (first (first img)))))
  (fmt-maxval (hdr-fmt (img-header img))))

(def img-width [img: Image] -> int
  (post (= result (first (second (first img)))))
  (dims-width (hdr-dims (img-header img))))

(def img-height [img: Image] -> int
  (post (= result (second (second (first img)))))
  (dims-height (hdr-dims (img-header img))))

;; Build an image from its fields. The pre is the header invariant, stated
;; explicitly because refinement aliases are erased (LLMLL.md 3.4.5).
(def make-image [c: int m: int w: int h: int rows: list[list[int]]] -> Image
  (pre  (and (or (= c 1) (= c 3))
        (and (and (>= m 1) (<= m 65535))
             (and (>= w 1) (>= h 1)))))
  (post (and (= (first (first (first result))) c)
        (and (= (second (first (first result))) m)
        (and (= (first (second (first result))) w)
        (and (= (second (second (first result))) h)
             (= (second result) rows))))))
  (mk-image (mk-header (mk-fmt c m) (mk-dims w h)) rows))

;; Magic number for a channel count.
(def magic-for [c: int] -> string
  (post (and (=> (= c 1) (= result "P2")) (=> (!= c 1) (= result "P3"))))
  (if (= c 1) "P2" "P3"))

;; ─── Well-formedness (the specification predicate of the shell) ─────────

(def-shell samples-in-range? [m: int rows: list[list[int]]] -> bool
  (list-fold rows true
    (fn [acc: bool row: list[int]]
      (and acc (list-fold row true
                 (fn [a: bool s: int] (and a (and (>= s 0) (<= s m)))))))))

(def-shell row-lengths-ok? [c: int w: int rows: list[list[int]]] -> bool
  (pre (and (or (= c 1) (= c 3)) (>= w 0)))
  (list-fold rows true
    (fn [acc: bool row: list[int]] (and acc (row-length-ok? c w row)))))

;; channels 1|3; 1 <= maxval <= 65535; w, h >= 1; exactly h rows; each row
;; (row-len c w) samples; every sample in 0..maxval.
(def-shell image-ok? [img: Image] -> bool
  (let [(c (img-channels img))
        (m (img-maxval img))
        (w (img-width img))
        (h (img-height img))
        (rows (img-rows img))]
    (if (header-ok? c w h m)
        (and (rows-count-ok? h rows)
        (and (row-lengths-ok? c w rows)
             (samples-in-range? m rows)))
        false)))

;; ─── Messages ───────────────────────────────────────────────────────────

;; n is the sample index (SampleOverMax) or the number of samples found
;; (TooFew / TooMany). The expected count w*h*c is nonlinear and only ever
;; computed here, for the message.
(def-shell problem-message [p: Problem c: int w: int h: int m: int n: int] -> string
  (post (not (= result "")))
  (match p
    ((NoProblem) "no problem")
    ((BadMagic) "bad magic number (expected P2 or P3 followed by whitespace)")
    ((BadChar) "unexpected character")
    ((MissingWidth) "missing width")
    ((MissingHeight) "missing height")
    ((MissingMaxval) "missing maxval")
    ((BadWidth v) (string-concat "width must be at least 1, got " (int-to-string v)))
    ((BadHeight v) (string-concat "height must be at least 1, got " (int-to-string v)))
    ((BadMaxval v) (string-concat "maxval must be in 1..65535, got " (int-to-string v)))
    ((SampleOverMax v)
      (string-concat-many ["sample " (int-to-string n) " (" (int-to-string v)
                           ") exceeds maxval " (int-to-string m)]))
    ((TooFewSamples) (count-message c w h n))
    ((TooManySamples) (count-message c w h n))))

(def-shell count-message [c: int w: int h: int n: int] -> string
  (string-concat-many ["wrong sample count: " (int-to-string w) "x" (int-to-string h)
                       "x" (int-to-string c) " needs " (int-to-string (* (* w h) c))
                       " samples, found " (int-to-string n)]))

;; ─── Scanner: drives the verified lex automaton ─────────────────────────
;; State: (lexer state, (numbers so far, reversed; offending character or "")).

(type ScanSt (LexState, (list[int], string)))

(def-shell scan-char [s: ScanSt ch: string] -> ScanSt
  (if (not (= (second (second s)) ""))
      s
      (let [(st   (first s))
            (toks (first (second s)))
            (cc   (char-class ch))]
        (match (lex-emit st cc)
          ((BadTok) (pair st (pair toks (if (= ch "") "?" ch))))
          ((NumTok n) (pair (lex-step st cc) (pair (list-prepend n toks) "")))
          ((NoTok) (pair (lex-step st cc) (pair toks "")))))))

;; The numbers in the text after the magic, or the first character that may
;; not appear there. Linear: lines by string-split, characters by
;; regex-find-all "." (never string-char-at over a range, which is O(n^2)).
(def-shell scan [body: string] -> Result[list[int], string]
  (post (match result
          ((Success xs) (list-fold xs true (fn [a: bool x: int] (and a (>= x 0)))))
          ((Error e) (not (= e "")))))
  (let [(s (list-fold (string-split "\n" body) (pair Gap (pair (list-empty) ""))
             (fn [acc: ScanSt line: string]
               (scan-char
                 (list-fold (regex-find-all "." line) acc
                   (fn [a: ScanSt g: list[string]] (scan-char a (unwrap-or (list-head g) ""))))
                 "\n"))))
        (bad  (second (second s)))
        (toks (first (second s)))]
    (if (not (= bad ""))
        (err (string-concat-many ["unexpected character '" bad "'"]))
        (match (lex-flush (first s))
          ((NumTok n) (ok (list-reverse (list-prepend n toks))))
          ((NoTok) (ok (list-reverse toks)))
          ((BadTok) (ok (list-reverse toks)))))))

;; ─── Decoder ────────────────────────────────────────────────────────────

(def-shell nth-or-0 [xs: list[int] i: int] -> int
  (post (=> (or (< i 0) (>= i (list-length xs))) (= result 0)))
  (unwrap-or (list-nth xs i) 0))

(def-shell drop3 [xs: list[int]] -> list[int]
  (post (= (list-length result) (max 0 (- (list-length xs) 3))))
  (let [(t1 (unwrap-or (list-tail xs) (list-empty)))
        (t2 (unwrap-or (list-tail t1) (list-empty)))]
    (unwrap-or (list-tail t2) (list-empty))))

;; Fold state: (error message or "", ((r, k), (current row reversed, rows reversed))).
(type DecSt (string, ((int, int), (list[int], list[list[int]]))))

(def-shell place-sample [c: int w: int m: int acc: DecSt v: int] -> DecSt
  (pre (and (or (= c 1) (= c 3)) (and (>= w 1) (>= m 1))))
  (if (not (= (first acc) ""))
      acc
      (let [(len  (row-len c w))
            (r    (first (first (second acc))))
            (k    (second (first (second acc))))
            (cur  (first (second (second acc))))
            (rows (second (second (second acc))))]
        (match (sample-problem m v)
          ((NoProblem)
            (let [(cur2 (list-prepend v cur))
                  (k2   (next-k len k))
                  (r2   (next-r len r k))]
              (if (= k2 0)
                  (pair "" (pair (pair r2 0) (pair (list-empty) (list-prepend (list-reverse cur2) rows))))
                  (pair "" (pair (pair r2 k2) (pair cur2 rows))))))
          (p (pair (problem-message p c w 0 m (+ (* r len) k)) (second acc)))))))

(def-shell decode-samples [c: int w: int h: int m: int vs: list[int]] -> Result[Image, string]
  (pre  (header-ok? c w h m))
  (post (match result
          ((Success img) (image-ok? img))
          ((Error e) (not (= e "")))))
  (let [(st (list-fold vs (pair "" (pair (pair 0 0) (pair (list-empty) (list-empty))))
              (fn [acc: DecSt v: int] (place-sample c w m acc v))))
        (r    (first (first (second st))))
        (k    (second (first (second st))))
        (rows (second (second (second st))))]
    (if (not (= (first st) ""))
        (err (first st))
        (match (count-problem h r k)
          ((NoProblem) (ok (make-image c m w h (list-reverse rows))))
          (p (err (problem-message p c w h m (+ (* r (row-len c w)) k))))))))

(def-shell decode-tokens [c: int sep: bool toks: list[int]] -> Result[Image, string]
  (post (match result
          ((Success img) (image-ok? img))
          ((Error e) (not (= e "")))))
  (let [(w (nth-or-0 toks 0))
        (h (nth-or-0 toks 1))
        (m (nth-or-0 toks 2))]
    (match (header-problem c sep (list-length toks) w h m)
      ((NoProblem) (decode-samples c w h m (drop3 toks)))
      (p (err (problem-message p c w h m 0))))))

;; Text of a P2/P3 file -> image, or an error naming the problem.
(def-shell decode [text: string] -> Result[Image, string]
  (post (match result
          ((Success img) (image-ok? img))
          ((Error e) (not (= e "")))))
  (let [(magic (string-slice text 0 2))
        (rest  (string-slice text 2 (string-length text)))
        (c     (magic-channels magic))
        (sep   (or (= rest "") (sep-ok? (char-class (string-slice rest 0 1)))))]
    (match (header-problem c sep 0 0 0 0)
      ((BadMagic)
        (err (string-concat-many ["bad magic number '" (if (= c 0) magic (string-slice text 0 3))
                                  "' (expected P2 or P3 followed by whitespace)"])))
      (p (match (scan rest)
           ((Error e) (err e))
           ((Success toks) (decode-tokens c sep toks)))))))

;; ─── Encoder ────────────────────────────────────────────────────────────

;; One row: each sample followed by (sep-after len k), so a newline every 10
;; samples and at the end of the row (verified layout; <= 59 chars a line).
(def-shell encode-row [len: int row: list[int]] -> string
  (pre (and (>= len 1) (= (list-length row) len)))
  (string-concat-many
    (list-reverse
      (second
        (list-fold row (pair 0 (list-empty))
          (fn [acc: (int, list[string]) s: int]
            (let [(k (first acc))]
              (pair (+ k 1)
                    (list-prepend (sep-after len k)
                                  (list-prepend (int-to-string s) (second acc)))))))))))

(def-shell encode [img: Image] -> string
  (pre  (image-ok? img))
  (post (match (decode result)
          ((Success back) (= back img))
          ((Error e) false)))
  (let [(c (img-channels img))
        (len (row-len c (img-width img)))]
    (string-concat-many
      (list-prepend
        (string-concat-many [(magic-for c) "\n"
                             (int-to-string (img-width img)) " " (int-to-string (img-height img)) "\n"
                             (int-to-string (img-maxval img)) "\n"])
        (list-map (img-rows img) (fn [row: list[int]] (encode-row len row)))))))

;; ─── Properties ─────────────────────────────────────────────────────────

;; A small well-formed image from arbitrary ints: P2 or P3, 1..4 x 1..4,
;; maxval 1..65535 (both ends of the range are reachable).
(def-shell test-image [cs: int ws: int hs: int ms: int vs: int] -> Image
  (post (image-ok? result))
  (let [(c (if (= (mod (abs cs) 2) 0) 1 3))
        (w (+ 1 (mod (abs ws) 4)))
        (h (+ 1 (mod (abs hs) 4)))
        (m (if (= (mod (abs ms) 3) 0) 65535 (+ 1 (mod (abs ms) 255))))
        (len (row-len c w))]
    (make-image c m w h
      (list-map (range 0 h)
        (fn [y: int] (list-map (range 0 len)
                       (fn [i: int] (mod (+ (+ (* y 101) (* i 37)) (abs vs)) (+ m 1)))))))))

(check "decode(encode img) = img" :subjects [encode decode]
  (for-all [cs: int ws: int hs: int ms: int vs: int]
    (let [(img (test-image cs ws hs ms vs))]
      (= (decode (encode img)) (ok img)))))

(check "decode skips comments anywhere and odd whitespace" :subject decode
  (for-all [n: int]
    (let [(v (mod (abs n) 11))]
      (= (decode (string-concat-many ["P2#c\n2# w\r\n1\t10 #m\n" (int-to-string v) "#x\n 3"]))
         (ok (make-image 1 10 2 1 [[v 3]]))))))

(check "decode rejects malformed input" :subject decode
  (for-all [n: int]
    (and (not (is-ok (decode "P5\n1 1\n255\n0\n")))
    (and (not (is-ok (decode "P23 1\n1\n0\n")))
    (and (not (is-ok (decode "P2\n2\n")))
    (and (not (is-ok (decode "P2\n1 1\n10\n11\n")))
    (and (not (is-ok (decode "P2\n2 2\n10\n1 2 3\n")))
    (and (not (is-ok (decode "P2\n2 1\n10\n1 2 3\n")))
    (and (not (is-ok (decode "P2\n0 2\n10\n")))
    (and (not (is-ok (decode "P2\n1 1\n65536\n0\n")))
    (and (not (is-ok (decode "P2\n1 1\n10\n-4\n")))
         (is-ok (decode "P3 1 1 65535 0 1 65535")))))))))))))

(check "encoded lines are at most 70 characters" :subject encode
  (for-all [cs: int ws: int hs: int vs: int]
    (let [(img (test-image cs ws hs 0 vs))]
      (list-fold (string-split "\n" (encode img)) true
        (fn [a: bool l: string] (and a (<= (string-length l) 70)))))))
