;; types — LEVEL 0 of the netpbm-swarm verified core. Imports nothing.
;;
;; Shared representation for the ASCII Netpbm codec (PGM P2, PPM P3).
;;
;;   Fmt    = (channels, maxval)      channels in {1, 3}; 1 <= maxval <= 65535
;;   Dims   = (width, height)         both >= 1
;;   Header = (Fmt, Dims)
;;   Row    = list[int]               ONE image row, channel-interleaved
;;                                    (r g b r g b ... for P3), length
;;                                    (row-len channels width)
;;   Image  = (Header, list[Row])     exactly `height` rows
;;   every sample s satisfies 0 <= s <= maxval
;;
;; Why this shape:
;; * Every accessor is a ONE-level pair projection, which verifies. A nested
;;   projection such as (first (second h)) falls back in a def (prior attempt,
;;   examples/netpbm/FRICTION.md F2). Callers in other modules compose the
;;   verified accessors: (fmt-channels (hdr-fmt (img-header img))) is
;;   body-faithful (probed).
;; * Rows keep every count linear: a row has (row-len c w) samples, where
;;   row-len multiplies by the constant 3 only, and the image has h rows.
;;   The sample count w*h*c (nonlinear) is never needed by a contract.
;; * No sum type lives here. A post that compares a value with a constructor
;;   of a sum IMPORTED from another module crashes liquid-fixpoint ("The sort
;;   Str is not numeric", constructor sorted func(Str -> int)); matching on an
;;   imported sum is fine. So each sum is declared by the module that
;;   produces it (lex: CharClass/LexState/Tok; rules: Problem).
;;
;; Refinement aliases erase at codegen and are NOT checked at runtime
;; (LLMLL.md 3.4.5). The shell that calls the core is unverified, so core
;; entry points state their requirements as explicit (pre ...) clauses, which
;; ARE runtime-asserted. The aliases below are for returns proved by a body
;; and for documentation of the shell's types.

(type Channels (where [c: int] (or (= c 1) (= c 3))))
(type MaxVal   (where [m: int] (and (>= m 1) (<= m 65535))))
(type Dim      (where [n: int] (>= n 1)))
(type Nat      (where [n: int] (>= n 0)))

(type Fmt    (int, int))
(type Dims   (int, int))
(type Header (Fmt, Dims))
(type Row    list[int])
(type Image  (Header, list[list[int]]))

;; ─── Constructors ───────────────────────────────────────────────────────
;; A swapped-argument body (pair m c) is refuted by each post.

(def mk-fmt [c: int m: int] -> Fmt
  (pre  (and (or (= c 1) (= c 3)) (and (>= m 1) (<= m 65535))))
  (post (and (= (first result) c) (= (second result) m)))
  (pair c m))

(def mk-dims [w: int h: int] -> Dims
  (pre  (and (>= w 1) (>= h 1)))
  (post (and (= (first result) w) (= (second result) h)))
  (pair w h))

(def mk-header [f: Fmt d: Dims] -> Header
  (post (and (= (first result) f) (= (second result) d)))
  (pair f d))

(def mk-image [hd: Header rows: list[list[int]]] -> Image
  (post (and (= (first result) hd) (= (second result) rows)))
  (pair hd rows))

;; ─── One-level accessors ────────────────────────────────────────────────
;; Each post pins the projection; (second x) for (first x) is refuted.

(def fmt-channels [f: Fmt] -> int
  (post (= result (first f)))
  (first f))

(def fmt-maxval [f: Fmt] -> int
  (post (= result (second f)))
  (second f))

(def dims-width [d: Dims] -> int
  (post (= result (first d)))
  (first d))

(def dims-height [d: Dims] -> int
  (post (= result (second d)))
  (second d))

(def hdr-fmt [hd: Header] -> Fmt
  (post (= result (first hd)))
  (first hd))

(def hdr-dims [hd: Header] -> Dims
  (post (= result (second hd)))
  (second hd))

(def img-header [img: Image] -> Header
  (post (= result (first img)))
  (first img))

(def img-rows [img: Image] -> list[list[int]]
  (post (= result (second img)))
  (second img))

;; ─── Row length ─────────────────────────────────────────────────────────
;; Samples per row: w for P2, 3w for P3. Written (if (= c 3) (* 3 w) w) so
;; the product has a constant operand and stays linear. Rejects (+ w 2),
;; (* 2 w), and a body that ignores c.

(def row-len [c: int w: int] -> Nat
  (pre  (and (or (= c 1) (= c 3)) (>= w 0)))
  (post (and (=> (= c 1) (= result w)) (=> (= c 3) (= result (* 3 w)))))
  (if (= c 3) (* 3 w) w))
