;; Apple "goto fail", N-ARM form: the signature-check status is a THREE-way sum
;; `Step3 = Continue | Abort int | Retry int` (not just two arms). The final
;; Verdict is Verified only if `sig` Continued — the post over the scrutinee's
;; constructor, discharged over a >2-arm payload-bearing match, which MATCH-WIDEN-2
;; (v0.14.26, Commit A) made body-faithful via the n-way int-tag chain. Before
;; v0.14.26 only two-arm sums discharged.
;;
;; Uses strict-core `def`: since v0.14.27 the strict-core grammar admits >2-arm
;; payload matches (it had lagged the verifier, which widened at v0.14.26), so the
;; three-arm body earns the strict tier directly — no `def-shell` escape hatch.
;;
;;   llmll verify examples/gotofail/nary.llmll   -> SAFE (body-faithful: finalize-n)
(type Step3   (| Continue) (| Abort int) (| Retry int))
(type Verdict (| Verified) (| Rejected int))

(def finalize-n [sig: Step3] -> Verdict
  (post (=> (= result Verified) (= sig Continue)))
  (match sig ((Continue) Verified)
             ((Abort c)  (Rejected c))
             ((Retry n)  (Rejected n))))
