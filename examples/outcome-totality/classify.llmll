;; COMP-4 (c) — payload-carrying outcome totality. A function maps EVERY input to
;; a real payload-bearing variant — Accepted(n) or Rejected(n) — and the compiler
;; PROVES the discrimination (legal -> Accepted, illegal -> Rejected), via native
;; FQData construction. This is what the COMP-3c int-tag and the d-elim skolem
;; could NOT express (a constructed, payload-bearing result), so demos like
;; tcp_rfc793 / session-pay had to fall back to an int sentinel (-1 = REJECTED);
;; COMP-4 (a)/(c) lifts that.
;;   llmll verify ./classify.llmll --strict-verified-core   -> SAFE
(type Outcome (| Accepted int) (| Rejected int))

(def classify [n: int] -> Outcome
  (post (and (or (not (>= n 0)) (= result (Accepted n)))     ;; legal   -> Accepted(n)
             (or (>= n 0)       (= result (Rejected n)))))    ;; illegal -> Rejected(n)
  (if (>= n 0) (Accepted n) (Rejected n)))
