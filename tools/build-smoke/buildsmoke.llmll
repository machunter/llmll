;; BUILD-GATE-1, the build smoke harness, in LLMLL. TOOL-RFC-006.
;;
;; The sixth and last port of the TOOL-LL campaign. Its subject is
;; scripts/build_smoke.sh, which is the harness that builds and runs the other
;; five ports. So this program is an LLMLL program that tests LLMLL programs.
;;
;; STATE OF THIS FILE: the spine and stages 1, 2, 2a, 3 and 4. Nine stages
;; remain, and TOOL-RFC-006 section 2 tables them with a code-line count each.
;; The RFC is the specification; this header does not restate it.
;;
;; SEVEN CONTROLS RUN AGAINST WHAT IS HERE, four of them negative:
;;
;;   --subject <abs path>              PASS compiler present
;;   --subject stack --root <repo>     PASS compiler anchored at <resolved>
;;   full run against the real fixture PASS fixture compiled through GHC
;;   --subject /nonexistent/llmll      FAIL no llmll binary answered
;;   --subject stack --root /nonexist  FAIL no llmll under stack path
;;   PATH=/usr/bin:/bin                FAIL neither stack nor ghc
;;   broken fixture, STALE good Lib.hs FAIL the fixture does not build
;;
;; Each negative uses a real environment or a real broken input rather than a
;; changed source, so each grades these stages as they ship.
;;
;; THE LAST CONTROL IS THE ONE THAT MATTERS. It reproduces the exact scenario
;; that defeated the RFC's first probe: a fixture that fails to compile, with a
;; complete 850-line src/Lib.hs left in the work directory by an earlier
;; successful run. A stage that reads the artifact without consulting the status
;; reports PASS here. This one reports the status.
;;
;; WHY THE STATE IS A RECORD AND A CONTROL TAG, and not an int. `:mode console`
;; hands each step one Response and takes one Command back, so anything a later
;; stage needs from an earlier one has to live in the state. sequencer.llmll and
;; pathlint.llmll both carry ((Record, Ctl), Command) and this port follows
;; them. The record is Json because the alternative is a positional tuple that
;; grows a field per stage and renumbers every call site when it does.
;;
;; THE ORDERING HAZARD THAT COST THE RFC ITS FIRST PROBE, restated here because
;; it is a property of the shape rather than of that probe. A command's status
;; arrives as the Response of the NEXT step. So "run the build" and "read what
;; the build produced" are two steps, and nothing in the language forces the
;; second to consult the first. The RFC's stage 4b printed PASS against a build
;; that had exited 1, by reading a stale artifact from the previous run. In
;; shell the check is structural, because `if ! llmll build ...; then fail; fi`
;; puts the status first. Here the order is a hand-written control state.
;; EVERY STAGE MUST BRANCH ON THE STATUS BEFORE IT READS AN ARTIFACT.
;;
;; WRITE THE NEGATIVE CONTROL FIRST. A stage that has never been seen to fail is
;; not known to decide anything. This is finding 14 in tool-ll-RESTART.md, and
;; the 004 and 003 covers each found defects that a passing live run could not.

(module buildsmoke
  (import wasi.io   (capability stdout :deterministic false))
  (import wasi.proc (capability exec :deterministic false))
  (import wasi.fs   (capability read-write "." :deterministic false))

  ;; ------------------------------------------------------------------ state --
  ;; Json carries the accumulated verdicts so a field added by stage 9 does not
  ;; renumber stage 1's call sites.
  (type Bs (| Bs Json))
  (def-shell bs-of [b: Bs] -> Json (match b ((Bs j) j)))
  (def-shell bs-mk [j: Json] -> Bs (Bs j))

  ;; `sets` and `get-s` do not exist as builtins and are written locally at
  ;; every port in this campaign. json-set answers a Result, so the unwrap
  ;; keeps the old value rather than dropping the write silently.
  (def-shell sets [v: Json k: string s: string] -> Json
    (unwrap-or (json-set v k (json-of-string s)) v))

  (def-shell with-s [b: Bs k: string s: string] -> Bs (bs-mk (sets (bs-of b) k s)))
  (def-shell get-s  [b: Bs k: string] -> string
    (unwrap-or (json-get-string (bs-of b) k) ""))

  ;; ------------------------------------------------------------------- argv --
  ;; THE ARGUMENT CONTRACT, and it exists because the subject reads an
  ;; ENVIRONMENT VARIABLE that no builtin can read.
  ;;
  ;;   --subject  the llmll compiler. Default "llmll", found on PATH.
  ;;   --root     the repository root. Default "."
  ;;   --work     a scratch directory for build outputs. Default "."
  ;;
  ;; The names follow refutecrux.llmll, which already takes exactly these three
  ;; and whose CI step passes an absolute --subject. Inventing a fourth spelling
  ;; for the same three ideas would make the campaign's ports differ for no
  ;; reason.
  ;;
  ;; WHAT THIS CONTRACT DOES NOT REACH, stated because the campaign's census
  ;; says it does. `scripts/build_smoke.sh:118` tries THREE sources for the
  ;; compiler in order: $LLMLL_BIN, then `command -v llmll`, then
  ;; $HOME/.local/bin/llmll. `--subject` reproduces the first and a bare
  ;; "llmll" reproduces the second. **The third is unreachable**, because it
  ;; needs $HOME and nothing here reads the environment. The census row "no env
  ;; access ... argv carries it" is dispositioned COSMETIC on the grounds that
  ;; nothing is lost. That holds for port 005 and it does NOT hold here: argv
  ;; carries what a caller passes, and $HOME is not passed. Reading it through
  ;; `sh -c 'echo $HOME'` would break D1's rule that this port hands no string
  ;; to a shell. So the branch is dropped deliberately, and the caller supplies
  ;; the path instead.
  (def-shell argv-of [x: Response] -> list[string]
    (match x
      ((RList as) as)
      ((RNone)    (list-empty))
      ((RText _)  (list-empty))
      ((RCode _)  (list-empty))
      ((RErr _)   (list-empty))))

  (def-shell flag-value [as: list[string] f: string] -> string
    (first (list-fold as (pair "" false)
             (fn [acc: (string, bool) a: string]
               (if (second acc)
                   (pair a false)
                   (if (= a f) (pair (first acc) true) acc))))))

  (def-shell flag-or [as: list[string] f: string d: string] -> string
    (let [(v (flag-value as f))] (if (string-empty? v) d v)))

  ;; One tag per stage, plus the two terminal phases. `:done?` is read on the
  ;; state a step RETURNS and that step's Command is DISCARDED, so a phase must
  ;; not both print and finish. Ending prints; Done finishes.
  (type Ctl
    (| Boot)
    (| Tool1)      ;; stage 1, toolchain present
    (| Tool1Ghc)   ;; stage 1, the ghc fallback the subject also accepts
    (| Comp2)      ;; stage 2, an llmll binary answers
    ;; Stage 2a takes FIVE phases and not two, and the reason is the shape
    ;; rather than the task. `wasi.proc.run` answers the child's EXIT STATUS as
    ;; RCode; the child's stdout went to the path the call named. So reading
    ;; what `stack path` printed is a SEPARATE step from learning whether it
    ;; succeeded, and each source needs both.
    (| Anchor2a)   ;; ran `stack path` in the working directory; status arrives
    (| Anchor2aR)  ;; read that root from its file
    (| Anchor2aC)  ;; ran `stack path` in <root>/compiler; status arrives
    (| Anchor2aCR) ;; read that root from its file
    ;; TWO execute-checks and not one, because the subject's fallback condition
    ;; is a DISJUNCTION: `[ -z "$_SIR" ] || [ ! -x "$_SIR/bin/llmll" ]`. A root
    ;; that resolves but holds no compiler must still fall through to
    ;; <root>/compiler. A single shared check cannot, because it does not know
    ;; which source it is checking, and collapsing them reported FAIL against a
    ;; tree whose compiler was built and present.
    (| Anchor2aX1) ;; first source's binary: on failure, try <root>/compiler
    (| Anchor2aX2) ;; second source's binary: on failure, the stage fails
    (| Build3)     ;; stage 3, `llmll build` on the fixture; status arrives
    (| Lib4)       ;; stage 4, read the emitted src/Lib.hs
    (| Log4)       ;; stage 4, read the build log for a GHC invocation
    (| Ending)
    (| Done))

  (def-shell go [b: Bs p: Ctl c: Command] -> ((Bs, Ctl), Command)
    (pair (pair b p) c))

  ;; Stage 2 and stage 2a both end by handing control to stage 3, from three
  ;; different phases. One entry point rather than three copies, because a
  ;; fourth path added later would otherwise be the one that forgets.
  (def-shell start-build [b: Bs] -> ((Bs, Ctl), Command)
    (go b Build3
        (wasi.proc.run (get-s b "subject")
                       ["build" (fixture-of (get-s b "root"))
                        "-o" (get-s b "work")]
                       (get-s b "root")
                       (log-of (get-s b "work")) (log-of (get-s b "work"))
                       900 "/dev/null")))

  ;; ------------------------------------------------------------- responses --
  ;; Every shape is rendered distinctly. Collapsing two shapes to "" is how
  ;; JSON-SCALAR-1 went unnoticed for a corpus run: the port reported 30 passed
  ;; and 50 failed, and 50 was the count of cases whose flags had been dropped.
  (def-shell bs-text [r: Response] -> string
    (match r
      ((RText t)  t)
      ((RErr e)   e)
      ((RNone)    "")
      ((RCode n)  (string-concat "code:" (int-to-string n)))
      ((RList xs) "")))

  ;; PROBED 2026-08-12 by scripts/build-smoke/d3_probe.llmll, against llmll
  ;; 0.14.99, and recorded in TOOL-RFC-006 D3. A failed exec answers RErr and
  ;; the step machine survives it. The two causes carry DIFFERENT text:
  ;;
  ;;   missing         "...: createProcess: execvp: does not exist (No such file
  ;;                    or directory)"
  ;;   not executable  "...: createProcess: execvp: permission denied
  ;;                    (Permission denied)"
  ;;
  ;; The subject's `command -v` and its `-perm -111` test each answer one bit
  ;; and cannot say which happened. Reproducing the reference does not require
  ;; discarding that, because the subject's exe_path prints two DIFFERENT notes
  ;; for its two causes and this is how the port earns them.
  (def-shell absent? [r: Response] -> bool
    (string-contains (bs-text r) "does not exist"))

  (def-shell denied? [r: Response] -> bool
    (string-contains (bs-text r) "permission denied"))

  ;; A child that exited 0. RCode carries the status; every other shape from a
  ;; `wasi.proc.run` is a failure to launch, which `absent?` and `denied?`
  ;; classify. Written as its own predicate because "the command succeeded" and
  ;; "the artifact says what I expect" are the two halves the RFC's first probe
  ;; conflated, and conflating them is how it printed PASS against exit 1.
  (def-shell ok? [r: Response] -> bool
    (match r
      ((RCode n)  (= n 0))
      ((RText _)  false)
      ((RErr _)   false)
      ((RNone)    false)
      ((RList _)  false)))

  ;; ---------------------------------------------------------------- report --
  ;; The subject's two verdict spellings, at scripts/build_smoke.sh:57 for FAIL
  ;; and at each stage's own echo for PASS. A report text must not end with a
  ;; line end; the harness adds one.
  (def-shell pass-line [what: string] -> string
    (string-concat "BUILD-GATE-1 PASS: " what))

  (def-shell fail-line [what: string] -> string
    (string-concat "BUILD-GATE-1 FAIL: " what))

  ;; ------------------------------------------------------- stage 1, toolchain --
  ;; scripts/build_smoke.sh:107. The subject fails closed when NEITHER stack nor
  ;; ghc is on PATH, and its comment says why a skip would be wrong: this gate
  ;; compiles generated Haskell, and runGhcCheck returns True when no toolchain
  ;; is present (compiler/app/Main.hs:940), so a skip would pass while observing
  ;; nothing. That is finding 6's class and the subject already refuses it.
  ;;
  ;; The port asks each binary for its version rather than asking PATH for its
  ;; presence, because no builtin answers "is this name on PATH". D3 established
  ;; that the failure is observable and non-fatal, which is what makes the
  ;; substitution sound.
  (def-shell tool-fail [] -> string
    (fail-line "neither 'stack' nor 'ghc' answers --version. This gate compiles generated Haskell; without a toolchain it would pass while observing nothing. Install Stack from https://haskellstack.org, or set PATH, and re-run."))

  ;; ---------------------------------------- stage 2, the compiler binary --
  ;; scripts/build_smoke.sh:118. A missing compiler is a FAILURE here and not a
  ;; skip, for the same reason stage 1 gives.
  (def-shell comp-fail [subj: string] -> string
    (string-concat-many
      ["BUILD-GATE-1 FAIL: no llmll binary answered '" subj
       " version'. Pass --subject with a path to the compiler, or put llmll on PATH. A missing binary is a failure here, not a skip."]))

  ;; ------------------------------- stage 2a, anchor to an ABSOLUTE path --
  ;; scripts/build_smoke.sh:126, and the subject's comment there is the reason
  ;; rather than a preference. Later stages run the compiler from a DIFFERENT
  ;; directory: the replay stage works inside the scratch tree and the
  ;; DRIVER-LL stage works inside tools/llmll-driver. A relative invocation
  ;; re-resolves against that new directory and dies there. The subject
  ;; measured it in CI run 30938236092, where stack took the temp output
  ;; directory for its project root because that is where it was standing.
  ;;
  ;; The port hits this through `--subject stack` rather than through
  ;; LLMLL_BIN="stack exec llmll --", because argv carries one word per member
  ;; and the trailing `--` only ever separated stack's flags from the
  ;; compiler's. Resolving once here, while the working directory is still the
  ;; caller's, makes every later invocation independent of the directory.
  (def-shell stack-shaped? [subj: string] -> bool
    (or (= subj "stack") (string-contains subj "/stack")))

  (def-shell bin-under [root: string] -> string
    (string-concat root "/bin/llmll"))

  (def-shell anchor-fail [] -> string
    (string-concat-many
      ["BUILD-GATE-1 FAIL: --subject names stack but no llmll binary exists under `stack path --local-install-root`, from either the working directory or <root>/compiler. Build it first: (cd compiler && stack build)."]))

  ;; `stack path` writes the root and a line end. A path with a line end inside
  ;; it is not a path, and the failure it causes names the wrong thing.
  ;; string-split takes the SEPARATOR FIRST; the reversed call type-checks and
  ;; returns a malformed result, which cost port 004 five call sites.
  (def-shell chomp [s: string] -> string
    (unwrap-or (list-head (string-split "\n" s)) s))

  ;; --------------------------------------------- stages 3 and 4, the build --
  ;; scripts/build_smoke.sh:175 and :186. Stage 3 builds the fixture. Stage 4
  ;; corroborates INDEPENDENTLY that something was compiled, and its comment
  ;; names the class it guards: a fail-open runGhcCheck reporting success on an
  ;; emitted file that never reached GHC.
  (def-shell fixture-of [root: string] -> string
    (string-concat root "/scripts/build-smoke/smoke.llmll"))

  (def-shell lib-of [work: string] -> string (string-concat work "/src/Lib.hs"))
  (def-shell log-of [work: string] -> string (string-concat work "/.build.log"))

  ;; The subject's list at line 195, verbatim and in its order. Each name must
  ;; carry a TOP-LEVEL definition in the emitted preamble, which the subject
  ;; tests as `^name ` and this tests as a line start followed by the name and
  ;; a space. A literal list is also what SPLIT-EMPTY-1 forces: `string-split ""`
  ;; does not terminate, so a scan is a fold over a written-out list.
  (def-shell preamble-names [] -> list[string]
    ["wasi_io_stdout" "wasi_io_stderr" "wasi_http_response"
     "wasi_fs_read" "wasi_fs_write" "wasi_fs_delete" "wasi_http_post"
     "wasi_fs_list" "wasi_fs_mkdir" "wasi_fs_sha256"
     "wasi_clock_monotonic" "wasi_proc_run" "wasi_proc_args"
     "seq_commands"
     "json_parse" "json_serialize" "json_get" "json_get_string" "json_get_int"
     "json_get_bool" "json_get_number" "json_array" "json_object" "json_set"
     "json_of_string" "json_of_int" "json_of_bool" "json_of_list"])

  (def-shell defines? [lib: string n: string] -> bool
    (string-contains lib (string-concat "\n" (string-concat n " "))))

  (def-shell missing-in [lib: string] -> list[string]
    (list-filter (preamble-names) (fn [n: string] (not (defines? lib n)))))

  ;; The subject accepts either spelling, because the two backends log
  ;; differently and a gate that knew only one would call a real GHC run a
  ;; fail-open path.
  (def-shell ghc-ran? [lg: string] -> bool
    (or (string-contains lg "stack build OK") (string-contains lg "ghc OK")))

  (def-shell bs-init [] -> ((Bs, Ctl), Command)
    (go (bs-mk json-object) Boot wasi.proc.args))

  (def-shell bs-step [s: (Bs, Ctl) input: string r: Response] -> ((Bs, Ctl), Command)
    (match s
      ((pair b p)
        (match p
          ;; argv arrived. Record the contract's three values, then stage 1.
          ((Boot)
            (let [(as (argv-of r))]
              (go (with-s (with-s (with-s b "subject" (flag-or as "--subject" "llmll"))
                                  "root" (flag-or as "--root" "."))
                          "work" (flag-or as "--work" "."))
                  Tool1
                  (wasi.proc.run "stack" ["--version"] "."
                                 "bs_stack.txt" "bs_stack.txt" 60 "/dev/null"))))
          ;; stack answered. If it is absent, the subject still accepts ghc, so
          ;; a missing stack is not yet a failure.
          ((Tool1)
            (if (absent? r)
                (go b Tool1Ghc
                    (wasi.proc.run "ghc" ["--version"] "."
                                   "bs_ghc.txt" "bs_ghc.txt" 60 "/dev/null"))
                (go b Comp2
                    (wasi.proc.run (get-s b "subject") ["version"] "."
                                   "bs_ver.txt" "bs_ver.txt" 60 "/dev/null"))))
          ;; ghc answered, and it is the last chance for stage 1.
          ((Tool1Ghc)
            (if (absent? r)
                (go b Ending (wasi.io.stdout (tool-fail)))
                (go b Comp2
                    (wasi.proc.run (get-s b "subject") ["version"] "."
                                   "bs_ver.txt" "bs_ver.txt" 60 "/dev/null"))))
          ;; stage 2. The compiler answered, or it did not exist.
          ((Comp2)
            (if (absent? r)
                (go b Ending (wasi.io.stdout (comp-fail (get-s b "subject"))))
                ;; stage 2a fires only for the stack-shaped subject. A subject
                ;; that is already a path is already absolute enough: it ran.
                (if (stack-shaped? (get-s b "subject"))
                    (go b Anchor2a
                        (wasi.proc.run "stack" ["path" "--local-install-root"] "."
                                       "bs_sir.txt" "bs_sir.txt" 120 "/dev/null"))
                    (start-build b))))
          ;; stage 2a, first source: an install root for the working directory.
          ;; BRANCH ON THE STATUS BEFORE READING THE ARTIFACT. This is the
          ;; header's ordering rule, and it is the defect the RFC's own first
          ;; probe shipped: reading bs_sir.txt without consulting the status
          ;; would take a STALE root from a previous run as this run's answer.
          ((Anchor2a)
            (if (ok? r)
                (go b Anchor2aR (wasi.fs.read "bs_sir.txt"))
                (go b Anchor2aC
                    (wasi.proc.run "stack" ["path" "--local-install-root"]
                                   (string-concat (get-s b "root") "/compiler")
                                   "bs_sir2.txt" "bs_sir2.txt" 120 "/dev/null"))))
          ((Anchor2aR)
            (let [(sir (chomp (bs-text r)))]
              (if (string-empty? sir)
                  (go b Anchor2aC
                      (wasi.proc.run "stack" ["path" "--local-install-root"]
                                     (string-concat (get-s b "root") "/compiler")
                                     "bs_sir2.txt" "bs_sir2.txt" 120 "/dev/null"))
                  (go (with-s b "subject" (bin-under sir)) Anchor2aX1
                      (wasi.proc.run (bin-under sir) ["version"] "."
                                     "bs_anc.txt" "bs_anc.txt" 60 "/dev/null")))))
          ;; stage 2a, second source: the repository's own compiler project.
          ((Anchor2aC)
            (if (ok? r)
                (go b Anchor2aCR (wasi.fs.read "bs_sir2.txt"))
                (go b Ending (wasi.io.stdout (anchor-fail)))))
          ((Anchor2aCR)
            (let [(sir (chomp (bs-text r)))]
              (if (string-empty? sir)
                  (go b Ending (wasi.io.stdout (anchor-fail)))
                  (go (with-s b "subject" (bin-under sir)) Anchor2aX2
                      (wasi.proc.run (bin-under sir) ["version"] "."
                                     "bs_anc.txt" "bs_anc.txt" 60 "/dev/null")))))
          ;; stage 2a, the checks that make the resolution a measurement. The
          ;; subject tests `-x` on the path; D3 established that attempting the
          ;; run answers the same question and says WHICH way it failed.
          ;;
          ;; The first source failing is NOT the stage failing. `stack path`
          ;; answers for whatever project the working directory belongs to, and
          ;; in CI that is the scratch tree, which has no compiler under its
          ;; root. The subject falls through to <root>/compiler for exactly
          ;; this case.
          ((Anchor2aX1)
            (if (or (absent? r) (denied? r))
                (go b Anchor2aC
                    (wasi.proc.run "stack" ["path" "--local-install-root"]
                                   (string-concat (get-s b "root") "/compiler")
                                   "bs_sir2.txt" "bs_sir2.txt" 120 "/dev/null"))
                (start-build b)))
          ((Anchor2aX2)
            (if (or (absent? r) (denied? r))
                (go b Ending (wasi.io.stdout (anchor-fail)))
                (start-build b)))
          ;; stage 3. THE STATUS IS CONSULTED HERE AND NOWHERE LATER. This is
          ;; the branch the RFC's first probe did not write, and without it the
          ;; stale src/Lib.hs from a previous run satisfies stage 4.
          ((Build3)
            (if (ok? r)
                (go b Lib4 (wasi.fs.read (lib-of (get-s b "work"))))
                (go b Ending
                    (wasi.io.stdout (fail-line
                      (string-concat-many
                        ["the fixture does not build (status "
                         (bs-text r)
                         "). This is the defect class the gate exists for: it passes 'llmll check' and fails at GHC. Log: "
                         (log-of (get-s b "work"))]))))))
          ;; stage 4, first half: the emitted preamble must DEFINE every name
          ;; the fixture can call. A read error is the subject's "no src/Lib.hs
          ;; emitted" branch.
          ((Lib4)
            (let [(lib (bs-text r))]
              (if (string-empty? lib)
                  (go b Ending
                      (wasi.io.stdout (fail-line
                        (string-concat "no src/Lib.hs emitted at " (lib-of (get-s b "work"))))))
                  (let [(miss (missing-in lib))]
                    (if (= (list-length miss) 0)
                        (go b Log4 (wasi.fs.read (log-of (get-s b "work"))))
                        (go b Ending
                            (wasi.io.stdout (fail-line
                              (string-concat-many
                                ["src/Lib.hs is missing a definition for: "
                                 (string-concat-many (list-map miss (fn [n: string] (string-concat n " "))))
                                 ". The build reported success, which means it did not reach GHC (runGhcCheck's fail-open path) or the preamble drifted from builtinEnv."])))))))))
          ;; stage 4, second half: a success with no GHC invocation in the log
          ;; is the fail-open path, and the subject refuses to report green on
          ;; it. Two spellings are accepted because the two backends differ.
          ((Log4)
            (if (ghc-ran? (bs-text r))
                (go b Ending
                    (wasi.io.stdout (pass-line "fixture compiled through GHC; 0 missing preamble definitions")))
                (go b Ending
                    (wasi.io.stdout (fail-line
                      "build reported success but the log shows no GHC invocation. Fail-open path taken; the gate refuses to report green on an uncompiled fixture.")))))
          ((Ending) (go b Done   (wasi.io.stdout "")))
          ((Done)   (go b Done   (wasi.io.stdout "")))))))

  ;; RC-4: the step that trips :done? has its Command discarded, so Done sits
  ;; one past the last emitting phase rather than on it.
  (def-shell bs-done? [s: (Bs, Ctl)] -> bool
    (match s ((pair b p) (match p ((Done) true) ((Boot) false) ((Tool1) false)
                                 ((Tool1Ghc) false) ((Comp2) false)
                                 ((Anchor2a) false) ((Anchor2aR) false) ((Anchor2aC) false) ((Anchor2aCR) false)
                                 ((Anchor2aX1) false) ((Anchor2aX2) false) ((Build3) false) ((Lib4) false) ((Log4) false) ((Ending) false)))))

  (def-main
    :mode    console
    :init    (bs-init)
    :step    bs-step
    :done?   bs-done?))
