;; DRIVER-LL Phase 4, sub-phases 4a and 4b: the sequencer.
;;
;; The stage loop of scripts/rfc_to_implementation.py:1915-2015 ported as
;; def-shell orchestration around three proved cores: skip.may-skip decides
;; resumption, stage.record-outcome classifies a halt, and (4b)
;; validate.verdict-of / validate.verdict-outcome decide and classify a
;; delegated output. None of the three is re-implemented here, which is Phase
;; 3's standing rule (spine.llmll:12-16).
;;
;; SEVEN OF THE SIXTEEN STAGES HAVE NO BODY HERE. Proposal section 9's 4a row
;; held all sixteen at a stub; the 4b row lands B, C and I, the 4c row D, F
;; and G, and the 4d row H, K and N. M is the wave's (wave.llmll, 4e) and
;; stays a stub in THIS program until unification. A stage that is not ported
;; writes a stub byte-string to each artifact it declares and nothing else;
;; the eleven resume and outcome transitions of section 2.3 are decided over
;; those stubs exactly as they would be over real artifacts, because the
;; resume gate reads digests and a completion record and never the content.
;; registry.stage-ported? is the switch and carries the retirement schedule.
;;
;; ------------------------------------------------------------------
;; SECTION 7 STATEMENT 3 OF 3 [DISCLOSURE validate.verdict-of], NEW AT 4b
;;
;; verdict-of is proved over `present: bool`, `size: int` and `floor: int`.
;; The floor is a registry constant a reader can check against the reference's
;; require() call. The other two are computed HERE, in unproved shell code,
;; from ONE wasi.fs.read of the declared output, and three decisions inside
;; that computation are invisible at the proved boundary:
;;
;;   1. PRESENCE AND DECODABILITY ARE COLLAPSED. wasi.fs.read opens with a
;;      UTF-8 encoding and yields RErr both for a path that does not exist and
;;      for one whose bytes are not valid UTF-8 (CodegenHs.hs wasi_fs_read).
;;      Every RErr is read as `present = false`, so an output that exists and
;;      cannot be decoded records the reference's "wrote no <file>" detail
;;      rather than a decoding one. The DECISION is the same under both -- the
;;      stage records `failed` either way, and section 7:283-286 wants exactly
;;      that of an output not meeting its declared shape -- so this costs the
;;      reason string and not the status. Distinguishing them needs a second
;;      command (wasi.fs.sha256 reads bytes and would answer RText), and that
;;      arm is not spent here.
;;
;;   2. `size` IS CODE POINTS, NOT BYTES. The reference tests
;;      `out.stat().st_size`, which is bytes; the port tests string-length of
;;      the decoded text. They agree on ASCII and disagree on any multi-byte
;;      character, in the direction of the port measuring SMALLER, so a
;;      non-ASCII scope.md of 201 bytes can fail a floor the reference passes.
;;      There is no wasi.fs.stat and FS-STAT-1 is filed for the mtime half of
;;      the same gap; a size accessor would close this one.
;;
;;   3. A RESPONSE ARM THAT IS NEITHER RText NOR RErr is read as absent, on
;;      the same reasoning as the 4a statement's item 4: no wasi.fs.read
;;      produces those arms, so the branch is unreachable rather than untaken,
;;      and it fails in the direction that forces a re-run.
;;
;; The three AgentRunner conditions (:221 timeout, :227 non-zero exit, :230
;; declared output absent) do NOT go through verdict-of. A budget overrun is
;; not a fact about an output's shape, and forcing it into a Verdict would be
;; a category error; those two construct Errored directly and reach
;; stage.record-outcome, whose [S4-FAILED] and [S4-NOT-STOPPED] are the proved
;; mapping. The THIRD of them, an absent declared output, does go through
;; verdict-of as `Absent`, because it is a fact about the output.
;;
;; ------------------------------------------------------------------
;; SECTION 7 STATEMENT [DISCLOSURE oracle.*], NEW AT 4d
;;
;; oracle.llmll's four decisions and shape.probe-rows-conform? are proved
;; over booleans and counts. The booleans `probe-safe`, `probe-body-faithful`
;; and `verified-safe` are computed HERE, from the stdout transcript of one
;; `llmll verify FILE --strict-verified-core` per probe, per mutant and per
;; mutant file, by verify-safe? and body-faithful-all? below. Three decisions
;; inside that computation are invisible at the proved boundary:
;;
;;   1. THE EXIT STATUS IS NOT READ. The reference's `safe` is
;;      `"SAFE" in o and returncode == 0`; the port folds the run and the
;;      read into one command (RC-2 is discard-left) and keys on the SAFE line
;;      alone. Measured at v0.21.0: a SAFE run exits 0, a refuted run prints
;;      no SAFE line and exits 1, a fallen-back strict run prints no SAFE
;;      line and exits 1. No transcript the compiler produces decides
;;      differently under the two conjunctions.
;;
;;   2. THE FILE STEM IS NOT COMPARED. The reference's `body_faithful` is
;;      `"body-faithful" in o and f.stem not in _fallbacks(o)`, which compares
;;      a FILE stem against FUNCTION names and so scores a probe faithful
;;      whenever its file is not named after its function. The port asks for a
;;      `body-faithful:` line and NO `body-fallback:` line: every function in
;;      the file emitted a body-faithful VC. Stronger; and under
;;      --strict-verified-core a fallback prints no SAFE line, so the SAFE
;;      conjunct already implies it and no decision moves.
;;
;;   3. THE LEXEMES ARE THE COMPILER'S. `SAFE`, `body-faithful:` and
;;      `body-fallback:` are what compiler/app/Main.hs prints (the two lists at
;;      its emit site) and every line the port keys on is on STDOUT, measured.
;;      If the wording changes, every proof in oracle.llmll stays green and
;;      each one means something else; scripts/tests/test_driver_ll_4d.py pins
;;      the three literals against the compiler source for that reason.
;;
;; ------------------------------------------------------------------
;; SECTION 7 STATEMENT [DISCLOSURE report.omission-free?], NEW AT 4f
;;
;; report.omission-free? is proved over four counts. All four are computed
;; HERE, by o-named-count and o-survivors-unnamed below, over the rows of
;; stage N's kill-matrix.json and the text of stage O's REPORT.md. Three
;; decisions inside that computation are invisible at the proved boundary:
;;
;;   1. THE MEMBERSHIP TEST IS A SUBSTRING TEST. `named?` is
;;      string-contains of the row's `name` in the report text, so a row named
;;      `x` counts as named by a report that says `xyz`, and the error
;;      direction is TOWARD PASSING. LLMLL has regex-match, and POSIX ERE
;;      carries no word boundary, so no in-language tightening exists today.
;;      Disclosed rather than repaired.
;;
;;   2. THE IDENTIFIERS ARE NOT A CLOSED VOCABULARY. The names are authored
;;      by an agent per run, so interning them as a nullary enum to move the
;;      check into QF-LIA is not available. Proposal Rev 5 forbids that route
;;      by name, and this statement is the one it says is owed at 4f.
;;
;;   3. `survivor?` IS THE REFERENCE'S PREDICATE AND IT IS SHARED. The same
;;      def decides stage N's SURVIVORS log line and stage O's survivor count,
;;      so the two cannot disagree about what survived. That is a property of
;;      this module and not of the proof.
;;
;; ------------------------------------------------------------------
;; THREE UNGUARDED READS IN THE REFERENCE, PORTED AS DECISIONS.
;;
;; Proposal section 9.1 item 1 settles two: read_json on PROVENANCE.json in
;; stage B (:573) and read_text on stage B's scope.md in stage I (:1062).
;; Both traceback out at exit 1 in the reference. The port HAS NO HOST
;; EXCEPTION TO FALL THROUGH, so it could not reproduce that even if that were
;; wanted; both are guarded and record `failed`/`Errored` at exit 3. Neither
;; is a MUST over artifact content identifiable by clause, so section 3.5's
;; rule gives `failed` directly. read_manifest set the precedent at 4a.
;;
;; A THIRD, WHICH THE CENSUS BEHIND SECTION 9.1 DID NOT NAME:
;; `(PROMPTS / name).read_text(encoding="utf-8")` in Ctx.prompt (:536). It is
;; shared by every delegated stage rather than owned by one, which is likely
;; why a per-stage census missed it. Same disposition, same reasoning, and it
;; is recorded here as a finding against section 9.1's enumeration rather than
;; folded in silently. A fourth sits at :625, `f.read_text(errors="replace")`
;; inside _sources_text; that one cannot raise on a decode error because of
;; the replace, so it is unguarded and also unreachable in the reference,
;; while the port's read of the same file yields RErr on undecodable bytes and
;; records `failed`. Divergence, disclosed, and it fails toward re-running.
;;
;; ------------------------------------------------------------------
;; 4b CONSTRUCTS NO `stopped` SITE. Proposal section 9.1 item 3. Every
;; reachable halt in B, C and I records `failed`/`Errored`, and validate's
;; [V7-NO-STOP], [V7-NO-PARTIAL] and [V7-ONLY-TWO] make that a proof rather
;; than a convention over the delegated-output path. The 4a fault injector
;; still constructs ConditionUnmet and PartialThenHalt on the --halt-kind
;; flag; that is 4a scaffolding with a retirement schedule and is not a 4b
;; stage-body site.
;;
;; ------------------------------------------------------------------
;; SECTION 7 STATEMENT 1 OF 2 [DISCLOSURE skip.may-skip]
;;
;; may-skip is proved over four booleans. Three of the four are computed HERE,
;; in unproved shell code, and the proof says nothing about whether they are
;; the right booleans. Four shell-side decisions, one more than proposal Rev 7
;; lists:
;;
;;   1. A recorded digest of None arrives as "" (manifest.recorded-digest) and
;;      compares unequal to every hex string, so an artifact whose integrity
;;      was never recorded is a MISMATCH. Mirrors the reference at :1941.
;;
;;   2. An unknown `status` string parses to manifest-complete = false. That is
;;      conformant with driver-spec section 5:189-191 and it is a shell reading
;;      of a spec sentence, not a proved mapping.
;;
;;   3. artifacts-present and digests-match are BOTH derived from one
;;      wasi.fs.sha256 per declared artifact. MEASURED at v0.14.84: sha256 on a
;;      missing path yields RErr and on a present one RText hex, so presence and
;;      digest collapse into one command distinguished by CONSTRUCTOR. Every
;;      RErr is read as "absent", so an unreadable but present artifact is
;;      indistinguishable from a missing one at the proved boundary. The
;;      collapse is conservative: it can only force a re-run, never permit a
;;      skip, so it cannot violate [S5-SKIP]. It violates no clause and can
;;      still be wrong, which is why it is disclosed rather than argued away.
;;
;;   4. A response arm that is neither RText nor RErr (RNone, RCode, RList)
;;      is also read as "absent". No wasi.fs.sha256 produces those arms, so the
;;      branch is unreachable rather than merely untaken, and it fails in the
;;      same safe direction.
;;
;; ------------------------------------------------------------------
;; SECTION 7 STATEMENT 2 OF 2 [DISCLOSURE stage.record-outcome]
;;
;; record-outcome proves Outcome -> Status over all four constructors. WHICH
;; constructor a site builds is chosen here, in unproved shell code, and it is
;; the discrimination the Python driver lost (proposal section 3.4).
;;
;; At 4a the choice is FULLY ENUMERABLE and narrower than what 4b onward will
;; owe: two flags, --halt-at naming a stage key and --halt-kind naming a
;; constructor, and nothing else in this module constructs a halt. There is no
;; 46-site table to audit yet because there are no stage bodies. When the
;; bodies land, this statement widens to proposal section 3.5's rule plus
;; section 3.6's artifact-state axis, and the gap inventory must not read as
;; though 4a had closed something it deferred.
;;
;; ------------------------------------------------------------------
;; THE FAULT INJECTOR, AND WHY 4a NEEDS ONE.
;;
;; Section 9 demands all four Outcome arms with no stage bodies. With no
;; bodies only Finished has a producer, so ConditionUnmet, Errored and
;; PartialThenHalt need a declared injector, which is this port's counterpart
;; to the rig's STUB_MODE. It is 4a-ONLY SCAFFOLDING and its retirement is
;; scheduled: 4b retires Errored (a delegated output absent or malformed), 4c
;; through 4e retire ConditionUnmet at the gates, and 4f retires
;; PartialThenHalt at stage O's perturbation-omission check per section 6.2.
;;
;; CORRECTED AT 4f. The last clause was already wrong when 4f read it: stage
;; H's probe-polarity bar constructs a real PartialThenHalt at 4d (hwrote-step
;; below, and the comment above it says so), so the schedule had been
;; discharged one sub-phase early. 4f adds the SECOND real site rather than the
;; first. EVERY stopped constructor now has a real producer and the injector is
;; redundant for its stated purpose. It is kept, not deleted: cover cell T4 and
;; the --halt-kind flag both read it, and what deleting it breaks is measured
;; before it is deleted rather than after.
;; The injected halt's `clause` is "4a-injector" and is NOT a driver-spec
;; clause; a real clause identifier arrives with the stage that owns it.
;;
;; ------------------------------------------------------------------
;; THE PROCESS BOUNDARY (PROC-BOUNDARY-1, shipped v0.14.84).
;;
;; argv arrives as :init's command on the RList arm through RC-3, and the exit
;; status is the :status projection. Both halves are used as specified. One
;; measured LIMIT, and it is a finding against the proposal's section 4.4
;; rather than a defect:
;;
;;   the range refinement {v : int | 0 <= v <= 255} is proved only where the
;;   function :status names is BODY-FAITHFUL, and a projection out of a
;;   structured state is not. MEASURED at v0.14.84: a def whose body applies
;;   `first` to a pair falls back, for (int, int) as much as for this state
;;   type, so drv-status is contract-checked rather than proved. The
;;   proc_boundary.llmll fixture takes `[s: int]` and is the provable case; no
;;   driver with a product state is.
;;
;; What carries the weight instead is exit-code below, which IS body-faithful
;; and whose [EXIT-NOVACUOUS] post is the eliminative one: a run that did not
;; complete cannot exit 0. drv-status then clamps, so a state carrying 256
;; exits 255 rather than exiting 0 and reporting success.
;;
;; ------------------------------------------------------------------
;; TWO OUT-OF-STAGE HALTS CARRY NO STAGE STATUS.
;;
;; A corrupt MANIFEST.json (proposal section 10 cases 16 to 18) is decided
;; before any stage exists, so no Status attaches to it and record-outcome is
;; not called. The exit code is the literal 2, mirroring the reference's
;; top-level `except Halt` handler (rfc_to_implementation.py:2027-2032), and
;; the manifest is NOT written. Calling exit-code with a manufactured Stopped
;; would assert a stage disposition that driver-spec section 4 does not reach.

(module sequencer
  (import wasi.io   (capability stdout :deterministic false))
  ;; CAP-1-REAL: the verb and the path are documentation, not a bound.
  (import wasi.fs   (capability read-write "/"))
  ;; wasi.proc.args shares the wasi.proc namespace with wasi.proc.run
  ;; (extractWasiNamespace takes the first two segments), so this clause grants
  ;; the argument vector.
  (import wasi.proc (capability exec :deterministic false))
  ;; Stage A (wasi.http.get, v0.21.0). CAP-1-REAL: the verb and URL are
  ;; documentation, not a bound; the check matches the namespace. The URL the
  ;; operator passes with --rfc-url is what is fetched.
  (import wasi.http (capability get "https://www.rfc-editor.org/"))

  (import stage)    (open stage)
  (import skip)     (open skip)
  (import registry) (open registry)
  (import manifest) (open manifest)
  (import validate) (open validate)
  (import shape)    (open shape)
  (import oracle)   (open oracle)
  (import report)   (open report)
  (import common)   (open common)
  (import spine)    (open spine)

  ;; ------------------------------------------------------------------
  ;; The proved centre this module adds
  ;; ------------------------------------------------------------------

  ;; The process exit status of a run whose disposition is `s`. Body-faithful,
  ;; so the range and the three mappings are proved rather than asserted.
  ;;
  ;; 0 / 2 / 3 mirror the reference's three return paths (:1978, :1994, :2015
  ;; and the final :2019). Pending is 1 and is unreachable: nothing here builds
  ;; Pending, and [S4-ATTEMPTED] forbids record-outcome from returning it.
  (def exit-code [s: Status] -> int

    (post (and (>= result 0) (<= result 255))
      :source "[EXIT-RANGE] PROC-BOUNDARY-1 sec 4.4 - a status outside 0..255 is truncated by POSIX, so 256 would exit 0 and report success")

    (post (=> (= s Complete) (= result 0))
      :source "[EXIT-COMPLETE] a run whose stages all completed exits 0")

    (post (=> (= s Stopped) (= result 2))
      :source "[EXIT-STOPPED] driver-spec.txt sec 4 - a stage that halted on a defined condition exits 2, as rfc_to_implementation.py:1978 does")

    (post (=> (= s Failed) (= result 3))
      :source "[EXIT-FAILED] driver-spec.txt sec 4 - a stage that halted for any other reason exits 3, as rfc_to_implementation.py:1994 does")

    ;; The eliminative one. A body that returned 0 for a halted run passes
    ;; every implication above that does not mention it and is refuted here.
    (post (=> (not (= s Complete)) (> result 0))
      :source "[EXIT-NOVACUOUS] a run that did not complete MUST NOT report success")

    (match s
      ((Complete) 0)
      ((Stopped)  2)
      ((Failed)   3)
      ((Pending)  1)))

  ;; ------------------------------------------------------------------
  ;; State
  ;; ------------------------------------------------------------------

  ;; The agent-invocation contract of proposal section 5, settled there as
  ;; "--agent-exe plus repeatable --agent-arg, with {prompt}/{out}/{workdir}
  ;; substituted per argument". exe, (args, (prompts-dir, timeout-seconds)).
  ;;
  ;; NOT a shell template. wasi.proc.run takes an executable and an argument
  ;; vector and does no shell interpretation, and passing the operator's
  ;; string to /bin/sh -c would restore shell semantics through a granted
  ;; binary and void the auditability the split delivers (section 5 item 1).
  ;;
  ;; NO ENV CHANNEL. wasi.proc.run has no env parameter, so LLMLL_CMD,
  ;; RFC_PIPELINE_PROMPT and RFC_PIPELINE_OUT are not exported; the two paths
  ;; reach the agent through argv (section 5 item 2, PROC-ENV-1).
  ;;
  ;; --prompts-dir has NO reference counterpart: PROMPTS is a module constant
  ;; the reference derives from __file__ (:81) and a compiled binary has no
  ;; __file__. It is required for the same reason --agent-cmd is, and the
  ;; added flag is disclosed rather than defaulted to a guess about the tree.
  (type AgentCfg (| AgentCfg (string, (list[string], (string, int)))))

  ;; workdir, (only-selection, (halt-at, (halt-kind, (forced, agent)))). The
  ;; selection travels as the raw comma-separated string rather than as a
  ;; list, because an empty string has to mean "every stage" and an empty list
  ;; would mean "no stage": string-split with an empty subject yields [""],
  ;; measured.
  ;; Sub-phase 4d WIDENS THIS AT THE TAIL, not in the middle, TWICE. The
  ;; innermost pair went from `AgentCfg` to `(AgentCfg, string)` for the
  ;; compiler command stages H, K and N invoke, and then to
  ;; `(AgentCfg, (string, string))` for --reference-dir, the directory the
  ;; language reference is provisioned from. Appending is what keeps each change
  ;; to ONE existing projection: every cfg-* accessor above the tail reaches its
  ;; field through the same chain it did before, and only the previous tail
  ;; accessor gains a `first`. Inserting the field anywhere else would reproject
  ;; all of them, and proposal section 13 risk 6 is that a wrong projection over
  ;; a pair chain TYPECHECKS.
  ;; The stage A port widens the tail a THIRD time: `(string, string)` becomes
  ;; `(string, (string, (string, list[string])))`, the last two being
  ;; --rfc-url and the repeatable --amend-url (rfc_to_implementation.py's
  ;; `--rfc-url` and `--amend-url`, action="append").
  (type Cfg (| Cfg (string, (string, (string, (string, (bool, (AgentCfg, (string, (string, (string, list[string])))))))))))

  ;; The run-common record of proposal section 4: config, the live manifest,
  ;; and the selected stage indices in registry order.
  (type Run (| Run (Cfg, (Json, list[int]))))

  ;; Proposal section 4's sum over phases. Each arm names the RESPONSE it is
  ;; about to receive, since the console loop delivers the response to the
  ;; command issued on entry to the arm.
  ;;
  ;;   Boot 0     r is the argument vector
  ;;   Boot 1     r is the MANIFEST.json read
  ;;   Digest     r is wasi.fs.sha256 of declared artifact j, on the resume probe
  ;;   Started    r is the clock reading taken when the stage started
  ;;   Made       r is the write of artifact j
  ;;   Summed     r is wasi.fs.sha256 of artifact j, for the outputs map
  ;;   Stamped    r is the clock reading taken at record time
  ;;   Recorded   r is the manifest write
  ;;   Ending     r is the last report; the next state is terminal
  ;;   Done       terminal; :status reads the code out of this arm
  ;;
  ;; Ending exists because of RC-4: done? is evaluated on the state a step
  ;; RETURNS and the terminating step's command is DROPPED, so a state that
  ;; must still say something cannot be terminal. Recorded needs no such arm,
  ;; the manifest write having already been performed on entry to it.
  ;;
  ;; The six 4b arms are the ported stage body, and they all carry the SAME
  ;; payload type. Six arms with six differently-shaped tuples is six
  ;; projection sites where proposal section 13 risk 6 bites (a wrong
  ;; projection over a pair chain TYPECHECKS); one Body type is one accessor
  ;; set to get right.
  ;;
  ;;   Pre        r is the read of the stage's precondition artifact
  ;;   Srcs       r is the listing of 00-source
  ;;   Src        r is the read of pinned source `idx`
  ;;   Tmpl       r is the read of the prompt template
  ;;   Delegate   r is wasi.proc.run's exit status
  ;;   Outp       r is the read of the declared output
  ;;
  ;; The two 4c arms provision stage D's isolated input set:
  ;;
  ;;   Prov       r is the UNFILTERED listing of 00-source
  ;;   Copy       r is the copy of provisioned file `idx`
  ;;
  ;; The ten 4d arms are the compiler-oracle loops that follow a passing
  ;; delegated output (registry.stage-oracle); see their own section.
  ;;
  ;;   HGood      r is sha256 of probe idx's file
  ;;   HMut       r is sha256 of probe idx's mutant file
  ;;   HOutG      r is the read of the probe's verify transcript
  ;;   HOutM      r is the read of the mutant's verify transcript
  ;;   HWrote     r is the write of feasibility.json
  ;;   KCheck     r is `llmll check`'s exit status over the authored roots
  ;;   NRow       r is sha256 of mutant idx's file
  ;;   NSkip      r is the log line for an unwritable row
  ;;   NOut       r is the read of the mutant's verify transcript
  ;;   NWrote     r is the write of kill-matrix.json
  ;;
  ;; The five stage A arms reuse Loop: `rows` is the URL list, `idx` the source
  ;; being pinned, `acc` the pins so far and `note` the current file's digest.
  ;;
  ;;   AProbe     r is sha256 of the destination, the `dest.exists()` probe
  ;;   AFetch     r is wasi.http.get's arm: RNone, the whole body is at dest
  ;;   ADigest    r is sha256 of the fetched file
  ;;   ALines     r is the read of the file, for the newline count
  ;;   AWrote     r is the write of PROVENANCE.json
  ;;
  ;; k, (start, (pre-values, (idx, (names, (accumulated-source-text, tag))))).
  ;;
  ;; TWO 4c CHANGES, and both are smaller than they look.
  ;;
  ;; `pre-text: string` becomes `pre-values: list[string]`, so the arity grows by
  ;; the tag alone rather than by two fields. Stage G reads THREE precondition
  ;; artifacts where 4b's three stages read one, and no separate precondition
  ;; index is needed either: the number read so far is (list-length pre-values).
  ;;
  ;; `tag` is the invocation index. Only stage D has more than one (:645-659).
  ;; The Copy loop REUSES `names` and `idx`, which is sound because it runs after
  ;; the Src loop has finished with them and left its result in the accumulator;
  ;; `acc` and `pre-values` are what survive into rendering.
  (type Body (| Body (int, (int, (list[string], (int, (list[string], (string, int))))))))

  ;; The 4d loop payload: k, (start, (idx, (rows, (acc, note)))). `rows` is the
  ;; agent's catalogue as a JSON array, `acc` the rows the driver has scored so
  ;; far, `note` a per-row scratch string (H keeps the probe's transcript in it
  ;; between the probe's read and the mutant's). One payload type for the ten
  ;; 4d arms, on the reasoning that gave the 4b arms one Body. Named Loop and
  ;; nothing an opened module names, for the reason Ctl is not Phase.
  (type Loop (| Loop (int, (int, (int, (Json, (Json, string)))))))

  ;; Named Ctl and not Phase: token.llmll declares a DIFFERENT type named
  ;; Phase (a three-arm nullary lifecycle sum) and 4e's wave imports both.
  ;; Measured at v0.14.87, the type checker does NOT distinguish two
  ;; same-named sum types from two opened modules: a payload-carrying value
  ;; of one satisfies an annotation resolved to the other, with only an
  ;; open-shadow warning, while an `int` in the same position is correctly
  ;; rejected. So the collision would not have been caught here; the rename
  ;; is what prevents it, not the type system.
  (type Ctl
    (| Boot     int)
    (| Digest   (int, (int, (bool, (bool, string)))))
    (| Started  int)
    (| Made     (int, (int, int)))
    (| Pre      Body)
    (| Srcs     Body)
    (| Src      Body)
    (| Prov     Body)
    (| Copy     Body)
    (| Tmpl     Body)
    (| Delegate Body)
    (| Outp     Body)
    (| Summed   (int, (int, (int, Json))))
    (| Stamped  (int, (int, Json)))
    (| Recorded (int, int))
    (| Ending   int)
    (| Done     int)
    (| HGood    Loop)
    (| HMut     Loop)
    (| HOutG    Loop)
    (| HOutM    Loop)
    (| HWrote   Loop)
    (| KCheck   (int, (int, (int, int))))
    (| NRow     Loop)
    (| NSkip    Loop)
    (| NOut     Loop)
    (| NWrote   Loop)
    (| AProbe   Loop)
    (| AFetch   Loop)
    (| ADigest  Loop)
    (| ALines   Loop)
    (| AWrote   Loop)
    (| OWrote   Loop)
    (| OSkip    Loop))

  ;; ---- accessors, written once ---------------------------------------
  ;;
  ;; Proposal section 13 risk 6: a wrong projection over a pair chain
  ;; TYPECHECKS. Every projection in this module is in one of the functions
  ;; below and no use site writes a bare (first (second ...)).

  (def-shell cfg-workdir [c: Cfg] -> string
    (match c ((Cfg p) (first p))))
  (def-shell cfg-only [c: Cfg] -> string
    (match c ((Cfg p) (first (second p)))))
  (def-shell cfg-halt-at [c: Cfg] -> string
    (match c ((Cfg p) (first (second (second p))))))
  (def-shell cfg-halt-kind [c: Cfg] -> string
    (match c ((Cfg p) (first (second (second (second p)))))))
  (def-shell cfg-forced [c: Cfg] -> bool
    (match c ((Cfg p) (first (second (second (second (second p))))))))
  (def-shell cfg-agent [c: Cfg] -> AgentCfg
    (match c ((Cfg p) (first (second (second (second (second (second p)))))))))

  ;; The compiler command, for the stages whose acceptance oracle IS the
  ;; compiler: K runs `llmll check` on the authored roots and halts on its exit
  ;; code, H and N run `llmll verify` per probe and per mutant. Added at 4d
  ;; with the --llmll-cmd flag; see parse-cfg for why it is a flag and not a
  ;; default.
  (def-shell cfg-llmll [c: Cfg] -> string
    (match c ((Cfg p) (first (second (second (second (second (second (second p))))))))))

  ;; The repository root the language reference is copied from, or "". The
  ;; two files are LLMLL.md and docs/llmll-ast.schema.json relative to it,
  ;; the reference's `REPO / ...` (_provision_reference). Optional, because the
  ;; reference silently skips a file that is not there.
  (def-shell cfg-refdir [c: Cfg] -> string
    (match c ((Cfg p) (first (second (second (second (second (second (second (second p)))))))))))

  ;; The RFC stage A fetches as verbatim text, and the amending RFCs after it,
  ;; in argv order. The reference pins `[ctx.rfc_url, *ctx.amend_urls]`.
  (def-shell cfg-rfc-url [c: Cfg] -> string
    (match c ((Cfg p) (first (second (second (second (second (second (second (second (second p))))))))))))
  (def-shell cfg-amend-urls [c: Cfg] -> list[string]
    (match c ((Cfg p) (second (second (second (second (second (second (second (second (second p))))))))))))

  (def-shell ag-exe [a: AgentCfg] -> string
    (match a ((AgentCfg q) (first q))))
  (def-shell ag-args [a: AgentCfg] -> list[string]
    (match a ((AgentCfg q) (first (second q)))))
  (def-shell ag-prompts [a: AgentCfg] -> string
    (match a ((AgentCfg q) (first (second (second q))))))
  (def-shell ag-timeout [a: AgentCfg] -> int
    (match a ((AgentCfg q) (second (second (second q))))))

  (def-shell cfg-of [rn: Run] -> Cfg
    (match rn ((Run p) (first p))))
  (def-shell man-of [rn: Run] -> Json
    (match rn ((Run p) (first (second p)))))
  (def-shell sel-of [rn: Run] -> list[int]
    (match rn ((Run p) (second (second p)))))

  (def-shell with-cfg [rn: Run c: Cfg] -> Run
    (Run (pair c (pair (man-of rn) (sel-of rn)))))
  (def-shell with-man [rn: Run m: Json] -> Run
    (Run (pair (cfg-of rn) (pair m (sel-of rn)))))
  (def-shell with-sel [rn: Run xs: list[int]] -> Run
    (Run (pair (cfg-of rn) (pair (man-of rn) xs))))

  (def-shell dg-k [d: (int, (int, (bool, (bool, string))))] -> int
    (first d))
  (def-shell dg-j [d: (int, (int, (bool, (bool, string))))] -> int
    (first (second d)))
  (def-shell dg-present [d: (int, (int, (bool, (bool, string))))] -> bool
    (first (second (second d))))
  (def-shell dg-match [d: (int, (int, (bool, (bool, string))))] -> bool
    (first (second (second (second d)))))
  (def-shell dg-names [d: (int, (int, (bool, (bool, string))))] -> string
    (second (second (second (second d)))))
  (def-shell mk-dg [k: int j: int present: bool matched: bool names: string] -> Ctl
    (Digest (pair k (pair j (pair present (pair matched names))))))

  ;; The body payload. Written once, per the note on the Ctl type.
  (def-shell b-k [b: Body] -> int
    (match b ((Body p) (first p))))
  (def-shell b-start [b: Body] -> int
    (match b ((Body p) (first (second p)))))
  (def-shell b-pvals [b: Body] -> list[string]
    (match b ((Body p) (first (second (second p))))))
  (def-shell b-idx [b: Body] -> int
    (match b ((Body p) (first (second (second (second p)))))))
  (def-shell b-names [b: Body] -> list[string]
    (match b ((Body p) (first (second (second (second (second p))))))))
  (def-shell b-acc [b: Body] -> string
    (match b ((Body p) (first (second (second (second (second (second p)))))))))
  (def-shell b-tag [b: Body] -> int
    (match b ((Body p) (second (second (second (second (second (second p)))))))))

  (def-shell mk-body [k: int start: int pvals: list[string] idx: int
                      names: list[string] acc: string tag: int] -> Body
    (Body (pair k (pair start (pair pvals (pair idx (pair names (pair acc tag))))))))

  ;; How many precondition artifacts this body has read. The Pre loop's index.
  (def-shell b-pcount [b: Body] -> int
    (list-length (b-pvals b)))

  (def-shell b-add-pval [b: Body v: string] -> Body
    (mk-body (b-k b) (b-start b) (list-append (b-pvals b) v)
             (b-idx b) (b-names b) (b-acc b) (b-tag b)))
  (def-shell b-with-names [b: Body names: list[string]] -> Body
    (mk-body (b-k b) (b-start b) (b-pvals b) 0 names (b-acc b) (b-tag b)))
  (def-shell b-advance [b: Body acc: string] -> Body
    (mk-body (b-k b) (b-start b) (b-pvals b) (+ (b-idx b) 1) (b-names b) acc (b-tag b)))

  ;; The next invocation of the same stage. Stage D only. `acc` and the
  ;; precondition values are KEPT: the reference reads the pinned sources and the
  ;; rubric once, before the loop (:642-643), and re-reads only the prompt
  ;; template per tag, which is what re-entering Tmpl does.
  (def-shell b-next-tag [b: Body] -> Body
    (mk-body (b-k b) (b-start b) (b-pvals b) 0 (b-names b) (b-acc b) (+ (b-tag b) 1)))

  ;; The 4d loop payload. Written once, per the note on the Ctl type.
  (def-shell lp-k [l: Loop] -> int
    (match l ((Loop p) (first p))))
  (def-shell lp-start [l: Loop] -> int
    (match l ((Loop p) (first (second p)))))
  (def-shell lp-idx [l: Loop] -> int
    (match l ((Loop p) (first (second (second p))))))
  (def-shell lp-rows [l: Loop] -> Json
    (match l ((Loop p) (first (second (second (second p)))))))
  (def-shell lp-acc [l: Loop] -> Json
    (match l ((Loop p) (first (second (second (second (second p))))))))
  (def-shell lp-note [l: Loop] -> string
    (match l ((Loop p) (second (second (second (second (second p))))))))
  (def-shell mk-loop [k: int start: int idx: int rows: Json acc: Json note: string] -> Loop
    (Loop (pair k (pair start (pair idx (pair rows (pair acc note)))))))

  (def-shell lp-row-list [l: Loop] -> list[Json]
    (unwrap-or (json-array (lp-rows l)) (list-empty)))
  (def-shell lp-count [l: Loop] -> int
    (list-length (lp-row-list l)))
  (def-shell lp-row [l: Loop] -> Json
    (unwrap-or (list-nth (lp-row-list l) (lp-idx l)) json-object))
  (def-shell lp-acc-list [l: Loop] -> list[Json]
    (unwrap-or (json-array (lp-acc l)) (list-empty)))
  (def-shell lp-with-note [l: Loop s: string] -> Loop
    (mk-loop (lp-k l) (lp-start l) (lp-idx l) (lp-rows l) (lp-acc l) s))
  ;; Append one scored row and move to the next input row.
  (def-shell lp-scored [l: Loop row: Json] -> Loop
    (mk-loop (lp-k l) (lp-start l) (+ (lp-idx l) 1) (lp-rows l)
             (json-of-list (list-append (lp-acc-list l) row)) ""))

  ;; Stage K's payload: k, (start, (encoded-count, hole-count)).
  (def-shell kc-k [d: (int, (int, (int, int)))] -> int (first d))
  (def-shell kc-start [d: (int, (int, (int, int)))] -> int (first (second d)))
  (def-shell kc-enc [d: (int, (int, (int, int)))] -> int (first (second (second d))))
  (def-shell kc-holes [d: (int, (int, (int, int)))] -> int (second (second (second d))))
  (def-shell mk-kc [k: int start: int enc: int holes: int] -> Ctl
    (KCheck (pair k (pair start (pair enc holes)))))

  (def-shell md-k [d: (int, (int, int))] -> int (first d))
  (def-shell md-j [d: (int, (int, int))] -> int (first (second d)))
  (def-shell md-start [d: (int, (int, int))] -> int (second (second d)))
  (def-shell mk-md [k: int j: int start: int] -> Ctl
    (Made (pair k (pair j start))))

  (def-shell sm-k [d: (int, (int, (int, Json)))] -> int (first d))
  (def-shell sm-j [d: (int, (int, (int, Json)))] -> int (first (second d)))
  (def-shell sm-start [d: (int, (int, (int, Json)))] -> int (first (second (second d))))
  (def-shell sm-outs [d: (int, (int, (int, Json)))] -> Json (second (second (second d))))
  (def-shell mk-sm [k: int j: int start: int outs: Json] -> Ctl
    (Summed (pair k (pair j (pair start outs)))))

  (def-shell st-k [d: (int, (int, Json))] -> int (first d))
  (def-shell st-start [d: (int, (int, Json))] -> int (first (second d)))
  (def-shell st-outs [d: (int, (int, Json))] -> Json (second (second d)))
  (def-shell mk-st [k: int start: int outs: Json] -> Ctl
    (Stamped (pair k (pair start outs))))

  (def-shell rc-k [d: (int, int)] -> int (first d))
  (def-shell rc-code [d: (int, int)] -> int (second d))
  (def-shell mk-rc [k: int code: int] -> Ctl
    (Recorded (pair k code)))

  (def-shell run-of [s: (Run, Ctl)] -> Run (first s))
  (def-shell phase-of [s: (Run, Ctl)] -> Ctl (second s))
  (def-shell go [rn: Run p: Ctl c: Command] -> ((Run, Ctl), Command)
    (pair (pair rn p) c))

  ;; ---- argv ----------------------------------------------------------

  (def-shell parse-agent [as: list[string]] -> AgentCfg
    (AgentCfg (pair (flag-value as "--agent-exe")
                    (pair (flag-values as "--agent-arg")
                          (pair (flag-value as "--prompts-dir")
                                (int-flag as "--timeout" 1800))))))

  ;; --llmll-cmd is REQUIRED and is NOT defaulted to "llmll", on the precedent
  ;; --prompts-dir set. The reference defaults it from the LLMLL_CMD
  ;; environment variable and falls back to the bare name
  ;; (rfc_to_implementation.py:1859), and neither half of that is available
  ;; here: wasi.proc.run has no env parameter (PROC-ENV-1), and defaulting to a
  ;; bare name is a guess about the operator's PATH of exactly the kind
  ;; --prompts-dir refuses to make about the tree. A driver whose verification
  ;; oracle silently resolved to whichever llmll came first on PATH could
  ;; report a probe SAFE against a different compiler than the one under test,
  ;; which is the stale-binary failure this project has already paid for once.
  (def-shell parse-cfg [as: list[string]] -> Cfg
    (Cfg (pair (dflt (flag-value as "--workdir") ".")
               (pair (flag-value as "--only")
                     (pair (flag-value as "--halt-at")
                           (pair (flag-value as "--halt-kind")
                                 (pair (list-contains as "--force")
                                       (pair (parse-agent as)
                                             (pair (flag-value as "--llmll-cmd")
                                                   (pair (flag-value as "--reference-dir")
                                                         (pair (flag-value as "--rfc-url")
                                                               (flag-values as "--amend-url"))))))))))))

  ;; "" when the required flags are present. The reference makes --agent-cmd
  ;; required at argparse (:1888-1891) and exits 2 through ap.error, BEFORE
  ;; any stage exists, so no stage status attaches; the same is true here and
  ;; the exit code is the literal 2 on the corrupt-manifest path's reasoning.
  ;; Required unconditionally, as the reference requires --agent-cmd
  ;; unconditionally, and not only when a delegated stage is selected.
  (def-shell missing-flags [c: Cfg] -> string
    (if (string-empty? (ag-exe (cfg-agent c)))
        "--agent-exe is required (the executable each delegated stage runs)"
        (if (string-empty? (ag-prompts (cfg-agent c)))
            "--prompts-dir is required (the directory holding the stage prompt templates)"
            (if (string-empty? (cfg-llmll c))
                "--llmll-cmd is required (the compiler stages H, K and N run as their oracle)"
                ;; The reference requires --rfc-url unconditionally too (its
                ;; `missing` list, main). Checked LAST so that the earlier
                ;; three keep the message they had; the reference names every
                ;; missing flag at once and the port names the first, a
                ;; divergence 4a disclosed and this row inherits.
                (if (string-empty? (cfg-rfc-url c))
                    "--rfc-url is required (the RFC stage A fetches as verbatim text)"
                    "")))))

  (def-shell key-selected? [c: Cfg i: int] -> bool
    (if (string-empty? (cfg-only c))
        true
        (list-contains (split-on "," (cfg-only c)) (stage-key i))))

  (def-shell sel-indices [c: Cfg] -> list[int]
    (list-filter (range 0 (stage-count)) (fn [i: int] (key-selected? c i))))

  (def-shell idx-at [rn: Run k: int] -> int
    (unwrap-or (list-nth (sel-of rn) k) 0))

  ;; ---- paths and stub bodies -----------------------------------------

  (def-shell manifest-path [c: Cfg] -> string
    (string-concat (cfg-workdir c) "/MANIFEST.json"))

  (def-shell art-path [c: Cfg i: int j: int] -> string
    (string-concat-many [(cfg-workdir c) "/" (stage-out i j)]))

  (def-shell art-dir [c: Cfg i: int j: int] -> string
    (string-concat-many [(cfg-workdir c) "/" (stage-out-dir i j)]))

  ;; No body for the thirteen stages 4b does not port. The content is
  ;; per-artifact so that two stubs never share a digest, which would make a
  ;; cross-stage digest confusion invisible.
  ;;
  ;; A `.json` artifact gets a JSON stub, NEW AT 4b and for a reason 4a could
  ;; not have. Stage B is now real and reads stage A's PROVENANCE.json through
  ;; json-parse; stage A is not ported (it needs HTTP-GET-1) and is not listed
  ;; in any of proposal section 9's sub-phase rows, so its stub is what a run
  ;; selecting A,B hands to stage B. With the flat text stub every such run
  ;; halted at B on "does not parse as JSON", which is a correct decision over
  ;; a wrong input rather than a decision about the pipeline. The distinctness
  ;; property is unchanged: the stage key and the artifact path are both still
  ;; in the body, so no two stubs share a digest.
  (def-shell json-artifact? [p: string] -> bool
    (let [(k (string-length p))]
      (and (> k 5) (= (string-slice p (- k 5) k) ".json"))))

  (def-shell stub-body [i: int j: int] -> string
    (if (json-artifact? (stage-out i j))
        (string-concat-many
          ["{\n \"driver-ll\": \"4a stub\",\n \"stage\": \"" (stage-key i)
           "\",\n \"artifact\": \"" (stage-out i j) "\"\n}\n"])
        (string-concat-many
          ["driver-ll 4a stub\nstage=" (stage-key i)
           "\nartifact=" (stage-out i j) "\n"])))

  ;; ---- 4b paths and string helpers -----------------------------------

  (def-shell wd-path [c: Cfg rel: string] -> string
    (string-concat-many [(cfg-workdir c) "/" rel]))

  ;; The agent's directory IS the directory of the stage's first declared
  ;; output, measured against the reference at every ported stage: B writes
  ;; 01-scope/scope.md and delegates in 01-scope (:575-578), C 02-rubric
  ;; (:590-592), I 08-prereg (:1060-1065).
  ;; Takes the invocation index for stage D, whose two extractors delegate in
  ;; 03-extraction/a and 03-extraction/b (:646).
  ;;
  ;; 4f: it is registry.stage-agent-dir and no longer art-dir, because stage O
  ;; is the one stage where the two differ. Its declared output is the
  ;; workdir-root REPORT.md and its agent works in 14-report; art-dir would put
  ;; the agent in the workdir root. Every other stage's row is stage-out-dir
  ;; and nothing moves.
  (def-shell agent-dir [c: Cfg i: int j: int] -> string
    (wd-path c (stage-agent-dir i j)))

  ;; The file the agent is told to write and the one Outp then reads:
  ;; registry.stage-agent-out, which is the declared output for every stage
  ;; but H and N (the inverted artifact flow; see the registry's note).
  (def-shell agent-out-path [c: Cfg i: int j: int] -> string
    (string-concat-many [(cfg-workdir c) "/" (stage-agent-out i j)]))

  (def-shell prompt-file [c: Cfg i: int j: int] -> string
    (string-concat (agent-dir c i j) "/PROMPT.md"))

  (def-shell tmpl-file [c: Cfg i: int] -> string
    (string-concat-many [(ag-prompts (cfg-agent c)) "/" (stage-prompt i)]))

  ;; The last path segment. `stage-out` is workdir-relative and the reference's
  ;; messages name the BASENAME ("wrote no scope.md", :333).
  (def-shell base-of [p: string] -> string
    (let [(ps (split-on "/" p))]
      (unwrap-or (list-nth ps (- (list-length ps) 1)) p)))

  ;; Every occurrence of `needle` replaced by `repl`. There is no
  ;; string-replace builtin, so this is split-then-rejoin: the fold emits the
  ;; first part bare and every later part preceded by the replacement, which
  ;; is exactly `repl.join(parts)`.
  (def-shell replace-all [s: string needle: string repl: string] -> string
    (second (list-fold (split-on needle s) (pair true "")
              (fn [acc: (bool, string) p: string]
                (pair false
                      (if (first acc) p
                          (string-concat-many [(second acc) repl p])))))))

  ;; Python's f"{n:5d}", built by cases rather than by string-slice so the
  ;; half-open convention of one more builtin is not on the critical path.
  (def-shell pad5 [n: int] -> string
    (let [(s (int-to-string n))]
      (let [(k (string-length s))]
        (string-concat
          (if (>= k 5) ""
          (if (= k 4) " "
          (if (= k 3) "  "
          (if (= k 2) "   "
          (if (= k 1) "    " "")))))
          s))))

  ;; _sources_text's numbering (:626-627), and the reason it exists is quoted
  ;; there: extraction rows cite line spans and reconciliation matches on them,
  ;; so asking an agent to count lines itself is a silent source of mismatched
  ;; spans. Lines split on newline ONLY, `wc -l` semantics, because RFC page
  ;; breaks are form feeds and Python's splitlines() would break on them too.
  ;;
  ;; list-nth is O(i), so this is quadratic in the LINE COUNT (not in
  ;; characters). Measured cost is a list traversal per line; the alternative
  ;; is a fold that concatenates a growing string, which is quadratic in
  ;; CHARACTERS and materially worse on an RFC-sized input.
  (def-shell numbered-lines [raw: string] -> string
    (let [(ls (split-on "\n" raw))]
      (string-concat-many
        (list-map (range 0 (list-length ls))
          (fn [i: int]
            (string-concat-many
              [(if (= i 0) "" "\n") (pad5 (+ i 1)) "| "
               (unwrap-or (list-nth ls i) "")]))))))

  ;; `sorted((ctx.workdir / "00-source").glob("*.txt"))` (:624). wasi.fs.list
  ;; already sorts (CodegenHs.hs wasi_fs_list, and the sort is there so the
  ;; event log is machine-independent), so only the suffix test is owed.
  (def-shell txt? [n: string] -> bool
    (let [(k (string-length n))]
      (and (> k 4) (= (string-slice n (- k 4) k) ".txt"))))

  ;; BARRIERS (:87-96) rendered as `json.dumps(BARRIERS, indent=1)` produces.
  ;; Embedded as the rendered constant rather than rebuilt through
  ;; json-serialize: the reference's dict is a module constant in insertion
  ;; order and LLMLL's serializer neither guarantees that order nor writes
  ;; indent=1, so re-serializing would hand the agent a different string for
  ;; no gain. It reaches only the prompt and no abstraction-function field.
  (def-shell barriers-json [] -> string
    "{\n \"B1\": \"timing / liveness\",\n \"B2\": \"transport binding\",\n \"B3\": \"trace-level property\",\n \"B4\": \"opaque transform\",\n \"B5\": \"string structure\",\n \"B6\": \"superseded / deprecated\",\n \"B7\": \"entailed by the model or by a named sibling row\",\n \"B8\": \"outside any tool\"\n}")

  ;; AgentRunner's template expansion (:301-303), applied per ARGUMENT rather
  ;; than to one shell string (proposal section 5 item 1). {workdir} is the
  ;; AGENT's directory, which is what the reference passes: `workdir` there is
  ;; the first parameter of AgentRunner.run, i.e. ctx.d("01-scope").
  (def-shell subst-arg [a: string prompt: string out: string wd: string] -> string
    (replace-all (replace-all (replace-all a "{prompt}" prompt) "{out}" out)
                 "{workdir}" wd))

  ;; ---- response projections ------------------------------------------

  ;; "" for every arm but RText. wasi.fs.sha256 answers RText on a present path
  ;; and RErr on a missing one, measured; the other three arms are unreachable
  ;; and land on the same safe side. See [DISCLOSURE skip.may-skip] item 4.
  (def-shell hex-of [r: Response] -> string
    (match r
      ((RText t)  t)
      ((RErr _)   "")
      ((RNone)    "")
      ((RCode _)  "")
      ((RList _)  "")))

  ;; The same projection as hex-of, named for what the 4d arms read out of
  ;; it: a transcript or a file, present when the read answered text.
  (def-shell text-of [r: Response] -> string
    (hex-of r))

  (def-shell present? [r: Response] -> bool
    (not (string-empty? (hex-of r))))

  (def-shell ns-of [r: Response] -> int
    (match r
      ((RCode n)  n)
      ((RText _)  0)
      ((RErr _)   0)
      ((RNone)    0)
      ((RList _)  0)))

  ;; Whole seconds. json-of-int is the only numeric injection, so the field
  ;; cannot carry the reference's one-decimal float; see manifest.llmll's
  ;; header. Negative is impossible from a monotonic clock and is clamped
  ;; anyway, since a negative duration in an artifact is worse than a zero.
  (def-shell secs-between [start: int end: int] -> int
    (if (< end start) 0 (/ (- end start) 1000000000)))

  ;; ---- the injector --------------------------------------------------

  (def-shell injected-kind [rn: Run k: int] -> string
    (if (= (cfg-halt-at (cfg-of rn)) (stage-key (idx-at rn k)))
        (cfg-halt-kind (cfg-of rn))
        ""))

  (def-shell halts-pre? [rn: Run k: int] -> bool
    (or (= (injected-kind rn k) "ConditionUnmet")
        (= (injected-kind rn k) "Errored")))

  (def-shell halts-post? [rn: Run k: int] -> bool
    (= (injected-kind rn k) "PartialThenHalt"))

  (def-shell injected-outcome [rn: Run k: int] -> Outcome
    (if (= (injected-kind rn k) "ConditionUnmet") ConditionUnmet
    (if (= (injected-kind rn k) "PartialThenHalt") PartialThenHalt
        Errored)))

  (def-shell halt-detail [rn: Run k: int] -> string
    (string-concat-many
      ["injected halt at stage " (stage-key (idx-at rn k))
       " (--halt-kind " (injected-kind rn k) ")"]))

  ;; ConditionUnmet and PartialThenHalt are the stopped path and carry a
  ;; clause; Errored is the failed path and carries none, mirroring the
  ;; reference's two halt-row shapes.
  (def-shell halt-clause [o: Outcome] -> string
    (match o
      ((ConditionUnmet)  "4a-injector")
      ((PartialThenHalt) "4a-injector")
      ((Errored)         "")
      ((Finished)        "")))

  ;; ---- report lines --------------------------------------------------

  (def-shell skip-line [i: int] -> string
    (string-concat-many
      ["[driver-ll] stage " (stage-key i) " (" (stage-name i)
       "): already complete, skipping"]))

  ;; The reference computes `mismatched` under `if recorded and artifacts`
  ;; (:1934), so a stage with a missing declared artifact reports NOTHING and
  ;; re-runs silently. That is transition T7, it is conformant (section 5
  ;; attaches a MUST-report to T6 and a SHOULD to T8 and is silent here), and
  ;; the same gate is written here rather than inherited by accident.
  (def-shell reason-line [i: int recorded: bool present: bool names: string] -> string
    (if (and recorded (and present (not (string-empty? names))))
        (string-concat-many
          ["[driver-ll] stage " (stage-key i)
           ": artifact(s) changed since this stage recorded completion ("
           names "); re-running. An artifact modified outside the protocol is "
           "not that stage's output.\n"])
        (if (and present (not recorded))
            (string-concat-many
              ["[driver-ll] stage " (stage-key i)
               ": artifacts present but no completion record (interrupted, or "
               "a previous attempt failed); re-running\n"])
            "")))

  (def-shell run-lines [i: int recorded: bool present: bool names: string] -> string
    (string-concat-many
      [(reason-line i recorded present names)
       "[driver-ll] stage " (stage-key i) " [" (stage-kind i) "] " (stage-name i)]))

  (def-shell halt-line [st: Status i: int detail: string] -> string
    (string-concat-many
      ["[driver-ll] " (if (= st Failed) "FAILED" "STOP") " at stage "
       (stage-key i) ": " detail]))

  ;; ------------------------------------------------------------------
  ;; The step machine
  ;; ------------------------------------------------------------------

  ;; Issue stage k's first digest probe, or finish the run. Every site that
  ;; would advance to the next stage calls this, so "past the last stage" is
  ;; decided in one place.
  (def-shell enter [rn: Run k: int] -> ((Run, Ctl), Command)
    (if (>= k (list-length (sel-of rn)))
        (go rn (Ending 0)
            (wasi.io.stdout
              (string-concat "[driver-ll] done. manifest: " (manifest-path (cfg-of rn)))))
        (go rn (mk-dg k 0 true true "")
            (wasi.fs.sha256 (art-path (cfg-of rn) (idx-at rn k) 0)))))

  (def-shell start-run [rn: Run] -> ((Run, Ctl), Command)
    (enter (with-sel rn (sel-indices (cfg-of rn))) 0))

  ;; An ABSENT manifest is an empty one, not a fault: the reference returns
  ;; {"stages": {}} when the path does not exist (:246-247). Only a manifest
  ;; that IS there and cannot be used halts.
  (def-shell boot-read [rn: Run r: Response] -> ((Run, Ctl), Command)
    (match r
      ((RText body)
        (if (string-empty? (manifest-fault body))
            (start-run (with-man rn (manifest-of body)))
            (go rn (Ending 2)
                (wasi.io.stdout
                  (string-concat "[driver-ll] STOP: " (manifest-fault body))))))
      ((RErr _)   (start-run (with-man rn (empty-manifest))))
      ((RNone)    (start-run (with-man rn (empty-manifest))))
      ((RCode _)  (start-run (with-man rn (empty-manifest))))
      ((RList _)  (start-run (with-man rn (empty-manifest))))))

  (def-shell boot-step [rn: Run n: int r: Response] -> ((Run, Ctl), Command)
    (if (= n 0)
        (let [(c (parse-cfg (argv-of r)))]
          (if (string-empty? (missing-flags c))
              (go (with-cfg rn c) (Boot 1)
                  (seq-commands (wasi.fs.mkdir (cfg-workdir c))
                                (wasi.fs.read (manifest-path c))))
              ;; Before any stage exists, so no Status attaches and
              ;; record-outcome is not called: the same reasoning the
              ;; corrupt-manifest path carries, and the same literal 2.
              (go (with-cfg rn c) (Ending 2)
                  (wasi.io.stdout
                    (string-concat "[driver-ll] STOP: " (missing-flags c))))))
        (boot-read rn r)))

  ;; The resume decision. Nothing here re-implements it: the four booleans go
  ;; to skip.may-skip and its answer is the branch.
  ;;
  ;; `digests-match` IS THE REFERENCE'S `not mismatched`, AND THE GATE ON IT IS
  ;; NOT DECORATION. The reference computes `mismatched` under
  ;; `if recorded and artifacts` (:1934), so when a declared artifact is absent
  ;; the list is EMPTY and the skip is prevented by condition (b) alone. The
  ;; accumulated `matched` below cannot say that on its own: an absent artifact
  ;; answers RErr, hex is "", and "" differs from the recorded digest, so
  ;; presence and match fail TOGETHER and (c) masks (b).
  ;;
  ;; MEASURED, and this is why the gate is here rather than left implicit. With
  ;; the raw `matched`, passing a hardcoded `true` for artifacts-present left
  ;; ALL FIFTEEN cover scenarios green, T7 included: the cell proposal section
  ;; 2.3 defines as "condition (b) alone" was being decided by (c). With the
  ;; gate, the same perturbation turns T7 red. The decision is unchanged either
  ;; way, [S5-SKIP] holding in both, so this is about what the cover can
  ;; OBSERVE rather than about what the driver does.
  (def-shell decide [rn: Run k: int present: bool matched: bool names: string]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn k))]
      (let [(recorded (= (row-status (man-of rn) (stage-key i)) "complete"))]
        (if (may-skip recorded present
                      (if (and recorded present) matched true)
                      (cfg-forced (cfg-of rn)))
            (let [(e (enter rn (+ k 1)))]
              (pair (first e)
                    (seq-commands (wasi.io.stdout (skip-line i)) (second e))))
            (go rn (Started k)
                (seq-commands
                  (wasi.io.stdout (run-lines i recorded present names))
                  wasi.clock.monotonic))))))

  (def-shell digest-step [rn: Run d: (int, (int, (bool, (bool, string)))) r: Response]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (dg-k d)))]
      (let [(hex (hex-of r))]
        (let [(want (recorded-digest (man-of rn) (stage-key i) (stage-out i (dg-j d))))]
          (let [(here (not (string-empty? hex)))]
            (let [(same (and here (= hex want)))]
              (let [(names (if same
                               (dg-names d)
                               (if here
                                   (string-concat-many
                                     [(dg-names d)
                                      (if (string-empty? (dg-names d)) "" ", ")
                                      (stage-out i (dg-j d))])
                                   (dg-names d))))]
                (if (< (+ (dg-j d) 1) (stage-out-count i))
                    (go rn (mk-dg (dg-k d) (+ (dg-j d) 1)
                                  (and (dg-present d) here)
                                  (and (dg-match d) same)
                                  names)
                        (wasi.fs.sha256 (art-path (cfg-of rn) i (+ (dg-j d) 1))))
                    (decide rn (dg-k d)
                            (and (dg-present d) here)
                            (and (dg-match d) same)
                            names)))))))))

  ;; The manifest write and the halt report leave in one seq-commands, so the
  ;; response the next arm receives is the WRITE's. RC-2 is discard-left.
  ;;
  ;; ONE HALT SITE. Every halt in this module reaches record-outcome here and
  ;; nowhere else, so the Outcome-to-Status mapping is proved once for the 4a
  ;; injector and for all nine 4b stage-body conditions alike.
  (def-shell halt-with [rn: Run k: int o: Outcome detail: string clause: string]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn k))]
      (let [(st (record-outcome o))]
        (let [(m2 (put-row (man-of rn) (stage-key i)
                           (halt-row st o detail clause)))]
          (go (with-man rn m2) (mk-rc k (exit-code st))
              (seq-commands
                (wasi.io.stdout (halt-line st i detail))
                (wasi.fs.write (manifest-path (cfg-of rn)) (json-serialize m2))))))))

  (def-shell halt-now [rn: Run k: int o: Outcome start: int] -> ((Run, Ctl), Command)
    (halt-with rn k o (halt-detail rn k) (halt-clause o)))

  ;; THE 4b HALT CHANNEL, and the reason validate.llmll is a module rather
  ;; than three copies of an if. A Verdict goes to verdict-outcome and the
  ;; Outcome it returns goes to record-outcome; the clause is "" because
  ;; [V7-NO-STOP] and [V7-NO-PARTIAL] PROVE the result is not a stopped
  ;; constructor, so there is no clause to cite and nothing here decides that.
  (def-shell halt-verdict [rn: Run k: int v: Verdict detail: string]
      -> ((Run, Ctl), Command)
    (halt-with rn k (verdict-outcome v) detail ""))

  ;; The two AgentRunner conditions that are NOT facts about an output's
  ;; shape: a budget overrun and a non-zero exit. See the header's statement 3
  ;; for why they do not go through a Verdict.
  (def-shell halt-errored [rn: Run k: int detail: string] -> ((Run, Ctl), Command)
    (halt-with rn k Errored detail ""))

  (def-shell write-cmd [rn: Run k: int j: int] -> Command
    (seq-commands (wasi.fs.mkdir (art-dir (cfg-of rn) (idx-at rn k) j))
                  (wasi.fs.write (art-path (cfg-of rn) (idx-at rn k) j)
                                 (stub-body (idx-at rn k) j))))

  ;; ------------------------------------------------------------------
  ;; 4b: the ported body of a delegated stage.
  ;;
  ;; The ORDER reproduces the reference's, and the order is what decides
  ;; WHICH condition a broken workdir reports. Stage B reads PROVENANCE.json
  ;; (:573) before it reads the pinned sources (:574), so a workdir missing
  ;; both names the provenance; reversing them would still record `failed` and
  ;; would name the wrong cause, which is the difference section 4:129-131's
  ;; detail requirement is there to keep.
  ;;
  ;;   B   Pre(PROVENANCE.json, must parse) -> Srcs -> Src* -> Tmpl
  ;;         -> Delegate -> Outp(floor 200)
  ;;   C   Srcs -> Src* -> Tmpl -> Delegate -> Outp(floor 400)
  ;;   I   Pre(01-scope/scope.md, presence only) -> Tmpl -> Delegate
  ;;         -> Outp(floor -1, which passes every present output)
  ;; ------------------------------------------------------------------

  (def-shell to-srcs [rn: Run b: Body] -> ((Run, Ctl), Command)
    (go rn (Srcs b) (wasi.fs.list (wd-path (cfg-of rn) "00-source"))))

  (def-shell to-tmpl [rn: Run b: Body] -> ((Run, Ctl), Command)
    (go rn (Tmpl b)
        (wasi.fs.read (tmpl-file (cfg-of rn) (idx-at rn (b-k b))))))

  ;; Stage D provisions its extractor's isolated input set before delegating
  ;; (:648-651). Every other stage goes straight to the template.
  ;; THE MKDIR IS NOT OPTIONAL AND ITS ABSENCE IS SILENT. The reference creates
  ;; the extractor's directory with ctx.dir (:646) BEFORE copying into it. The
  ;; copies and the rubric write are unchecked here, as shutil.copy2 is there, so
  ;; a missing directory does not halt: it leaves the agent an empty working
  ;; directory and the run continues. Measured at v0.14.87 -- without this mkdir
  ;; both extractor directories held only PROMPT.md and the two logs, because
  ;; delegate-cmd's own mkdir runs after the provisioning rather than before it.
  ;; mkdir creates parents and is RNone on an existing directory, both measured,
  ;; so it is a no-op on the second tag's re-entry.
  (def-shell prov-cmd [rn: Run i: int j: int] -> Command
    (seq-commands
      (wasi.fs.mkdir (agent-dir (cfg-of rn) i j))
      (wasi.fs.list (wd-path (cfg-of rn) "00-source"))))

  (def-shell to-prov [rn: Run b: Body] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (if (stage-provision? i)
          (go rn (Prov b) (prov-cmd rn i (b-tag b)))
          (to-tmpl rn b))))

  (def-shell after-pre [rn: Run b: Body] -> ((Run, Ctl), Command)
    (if (stage-needs-src? (idx-at rn (b-k b)))
        (to-srcs rn b)
        (to-prov rn b)))

  (def-shell fresh-body [k: int start: int] -> Body
    (mk-body k start (list-empty) 0 (list-empty) "" 0))

  ;; A stage with no precondition artifact goes straight past Pre. One with
  ;; several re-enters Pre until it has read them all; see pre-step.
  (def-shell to-pre [rn: Run b: Body] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (if (>= (b-pcount b) (stage-pre-count i))
          (after-pre rn b)
          (go rn (Pre b)
              (wasi.fs.read (wd-path (cfg-of rn)
                                     (stage-pre-path i (b-pcount b))))))))

  (def-shell begin-body [rn: Run k: int start: int] -> ((Run, Ctl), Command)
    (to-pre rn (fresh-body k start)))

  ;; A ported MECHANICAL stage has no agent and no Body; stage A is the only
  ;; one so far (E's port waits on a reconcile.py invocation).
  (def-shell started-step [rn: Run k: int r: Response] -> ((Run, Ctl), Command)
    (if (halts-pre? rn k)
        (halt-now rn k (injected-outcome rn k) (ns-of r))
        (if (stage-ported? (idx-at rn k))
            (if (= (stage-kind (idx-at rn k)) "mechanical")
                (a-enter rn k (ns-of r))
                (begin-body rn k (ns-of r)))
            (go rn (mk-md k 0 (ns-of r)) (write-cmd rn k 0)))))

  ;; ---- Pre -------------------------------------------------------------
  ;;
  ;; The two guarded reads of proposal section 9.1 item 1. Absent covers a
  ;; path that is not there and one whose bytes do not decode; Malformed is
  ;; stage B's parse, which the reference performs with read_json and which
  ;; therefore fails there too, as a traceback rather than as a decision.

  (def-shell pre-detail [i: int j: int what: string] -> string
    (string-concat-many
      ["stage " (stage-key i) ": " (stage-pre-path i j) " " what
       ". The stage cannot be delegated without it; run the stage that "
       "produces it, or delete its manifest row to re-run."]))

  ;; What the artifact contributes to the prompt, per stage-pre-mode. RAW is the
  ;; text; PARSE re-serializes the whole document, which is what the reference's
  ;; json.dumps(prov) does (:577); PROJECT re-serializes one named member, which
  ;; is what read_json(...)["normative"] and ["core_ids"] do (:710, :731-732).
  ;;
  ;; An empty result means REJECTED, and no legitimate projection is empty: a
  ;; serialized JSON value is at minimum two characters, and mode RAW is only
  ;; reached for artifacts whose absence is already a separate condition.
  ;; Mode 3 (4d): the projected member must be an array, and the rows whose
  ;; filter key equals the filter value are re-serialized as an array. Stage
  ;; K's `[r for r in rows if r["disposition"] == "Encoded"]`. An empty
  ;; selection is "[]" and is NOT a rejection.
  (def-shell filtered-rows [i: int j: int m: Json] -> string
    (match (json-array m)
      ((Success rows)
        (json-serialize
          (json-of-list
            (list-filter rows
              (fn [r: Json]
                (= (unwrap-or (json-get-string r (stage-pre-filter-key i j)) "")
                   (stage-pre-filter-val i j)))))))
      ((Error _) "")))

  (def-shell pre-project [i: int j: int t: string] -> string
    (if (= (stage-pre-mode i j) 0)
        t
        (match (json-parse t)
          ((Success v)
            (if (= (stage-pre-mode i j) 1)
                (json-serialize v)
                (match (json-get v (stage-pre-proj i j))
                  ((Success m)
                    (if (= (stage-pre-mode i j) 3)
                        (filtered-rows i j m)
                        (json-serialize m)))
                  ((Error _)   ""))))
          ((Error _) ""))))

  (def-shell pre-why [i: int j: int] -> string
    (if (= (stage-pre-mode i j) 1)
        "does not parse as JSON"
        (if (= (stage-pre-mode i j) 3)
            (string-concat-many
              ["does not parse as JSON, or carries no \"" (stage-pre-proj i j)
               "\" array"])
            (string-concat-many
              ["does not parse as JSON, or carries no \"" (stage-pre-proj i j)
               "\" member"]))))

  ;; Mode 4 OPTIONAL, new at 4f and stage O's five inputs are the only users.
  ;;
  ;; The reference reads each of them through `maybe()` inside stage_O_writeup,
  ;; which substitutes the literal below for a file that is not there. Every
  ;; other precondition read in the reference is UNGUARDED and tracebacks on an
  ;; absent file, which is why every other mode halts here. Stage O's are
  ;; guarded there, so halting would be the port inventing a halt where the
  ;; subject has none, which section 12 forbids.
  ;;
  ;; The projection is skipped as well as the halt. An OPTIONAL input reaches
  ;; the prompt verbatim, including an EMPTY file: the reference passes
  ;; `p.read_text()` through untouched, and the empty-means-malformed rule the
  ;; other modes share would turn a zero-byte gate.json into a halt.
  (def-shell optional-pre? [i: int j: int] -> bool
    (= (stage-pre-mode i j) 4))

  (def-shell not-run [] -> string "(stage not run)")

  (def-shell pre-absent [rn: Run b: Body i: int j: int why: string]
      -> ((Run, Ctl), Command)
    (if (optional-pre? i j)
        (to-pre rn (b-add-pval b (not-run)))
        (halt-verdict rn (b-k b) Absent (pre-detail i j why))))

  (def-shell pre-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (let [(j (b-pcount b))]
        (match r
          ((RText t)
            (if (optional-pre? i j)
                (to-pre rn (b-add-pval b t))
                (let [(v (pre-project i j t))]
                  (if (string-empty? v)
                      (halt-verdict rn (b-k b) Malformed (pre-detail i j (pre-why i j)))
                      (to-pre rn (b-add-pval b v))))))
          ((RErr _)  (pre-absent rn b i j "is absent or is not readable text"))
          ((RNone)   (pre-absent rn b i j "was not readable"))
          ((RCode _) (pre-absent rn b i j "was not readable"))
          ((RList _) (pre-absent rn b i j "was not readable"))))))

  ;; ---- Srcs and Src ----------------------------------------------------

  (def-shell names-of [r: Response] -> list[string]
    (match r
      ((RList xs) (list-filter xs (fn [n: string] (txt? n))))
      ((RText _)  (list-empty))
      ((RErr _)   (list-empty))
      ((RNone)    (list-empty))
      ((RCode _)  (list-empty))))

  (def-shell src-path [c: Cfg n: string] -> string
    (wd-path c (string-concat "00-source/" n)))

  ;; `require(parts, "no pinned RFC text found; run stage A first")` (:629),
  ;; verbatim. An RErr from the listing (no 00-source directory at all) lands
  ;; on the same condition, which is what the reference's empty glob does.
  (def-shell srcs-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (let [(ns (names-of r))]
      (if (= (list-length ns) 0)
          (halt-verdict rn (b-k b) Absent
                        "no pinned RFC text found; run stage A first")
          (go rn (Src (b-with-names b ns))
              (wasi.fs.read (src-path (cfg-of rn) (unwrap-or (list-nth ns 0) "")))))))

  (def-shell src-piece [name: string raw: string leading: string] -> string
    (string-concat-many
      [leading "===== " name " =====\n" (numbered-lines raw)]))

  (def-shell src-name [b: Body] -> string
    (unwrap-or (list-nth (b-names b) (b-idx b)) ""))

  (def-shell src-next [rn: Run b2: Body] -> ((Run, Ctl), Command)
    (if (< (b-idx b2) (list-length (b-names b2)))
        (go rn (Src b2) (wasi.fs.read (src-path (cfg-of rn) (src-name b2))))
        (to-prov rn b2)))

  (def-shell src-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (match r
      ((RText t)
        (src-next rn (b-advance b (string-concat (b-acc b)
                       (src-piece (src-name b) t
                                  (if (= (b-idx b) 0) "" "\n\n"))))))
      ((RErr e)  (halt-verdict rn (b-k b) Absent
                   (string-concat-many
                     ["pinned source " (src-name b) " is not readable text ("
                      e "). The reference reads it with errors=\"replace\" and "
                      "cannot reach this; the port has no such channel and "
                      "records the stage failed rather than substituting bytes "
                      "no agent can cite."])))
      ((RNone)   (halt-verdict rn (b-k b) Absent "pinned source unreadable"))
      ((RCode _) (halt-verdict rn (b-k b) Absent "pinned source unreadable"))
      ((RList _) (halt-verdict rn (b-k b) Absent "pinned source unreadable"))))

  ;; ---- Prov and Copy ---------------------------------------------------
  ;;
  ;; Stage D's isolated input set (:648-651): the pinned bytes and the rubric
  ;; and nothing else, per extractor. Its docstring calls blindness STRUCTURAL,
  ;; and this is the structure.
  ;;
  ;; THE LISTING IS UNFILTERED, and reusing names-of here would be a defect.
  ;; That function keeps only `.txt` (:970) because _sources_text globs `*.txt`
  ;; (:624). The reference's provisioning loop globs `*` and copies every FILE
  ;; (:648-650), and audit_blindness's allowed set (:1836-1837) lists
  ;; PROVENANCE.json among the legitimate inputs, so filtering would drop an
  ;; input the blindness audit expects to find.
  ;;
  ;; The copy is unchecked, like the reference's shutil.copy2. A failure surfaces
  ;; at the agent, which cannot cite bytes that are not there, and then at the
  ;; stage's own output validation. Guarding it would invent a halt the reference
  ;; does not have.
  ;;
  ;; audit_blindness itself is NOT ported: FS-ISOLATION-1, disclosed in
  ;; proposal section 14, so nothing here re-checks that the copy was faithful.

  (def-shell prov-names [r: Response] -> list[string]
    (match r
      ((RList xs) xs)
      ((RText _)  (list-empty))
      ((RErr _)   (list-empty))
      ((RNone)    (list-empty))
      ((RCode _)  (list-empty))))

  ;; The rubric write that closes the provisioning (:651). Stage D's single
  ;; precondition value IS the rubric text, mode RAW.
  (def-shell rubric-cmd [rn: Run b: Body] -> Command
    (let [(i (idx-at rn (b-k b)))]
      (wasi.fs.write
        (string-concat (agent-dir (cfg-of rn) i (b-tag b)) "/rubric.md")
        (unwrap-or (list-nth (b-pvals b) 0) ""))))

  (def-shell copy-next [rn: Run b: Body] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (if (< (b-idx b) (list-length (b-names b)))
          (go rn (Copy b)
              (wasi.fs.copy
                (src-path (cfg-of rn) (src-name b))
                (string-concat-many [(agent-dir (cfg-of rn) i (b-tag b)) "/"
                                     (src-name b)])))
          ;; The rubric write closes the provisioning and the template read is
          ;; what the Tmpl arm is waiting for. seq-commands is discard-left, so
          ;; the response delivered is the READ's and the write's is dropped,
          ;; exactly as delegate-cmd pairs the prompt write with the agent run.
          (go rn (Tmpl b)
              (seq-commands (rubric-cmd rn b)
                            (wasi.fs.read (tmpl-file (cfg-of rn) i)))))))

  ;; The directory has to exist before anything is copied into it. mkdir creates
  ;; parents and is RNone on an existing directory, both measured, so this is a
  ;; no-op on the second tag's re-entry.
  (def-shell prov-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (copy-next rn (b-with-names b (prov-names r))))

  (def-shell copy-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (copy-next rn (b-advance b (b-acc b))))

  ;; ---- Tmpl ------------------------------------------------------------
  ;;
  ;; Ctx.prompt (:535-541): substitute each keyword, then reject any
  ;; placeholder left behind. The substitution ORDER is the reference's
  ;; keyword order, because a value carrying a later placeholder would be
  ;; expanded by it: rfc_text then provenance for B (:576-577), rfc_text for C
  ;; (:591), scope then barriers for I (:1062-1064).
  ;;
  ;; 4c: the barriers CONSTANT is substituted before the precondition values
  ;; rather than fourth of five as stage G's keyword order has it (:735-742).
  ;; That cannot change a result: barriers-json is a compile-time constant
  ;; carrying no placeholder, so no ordering of it against the artifact values
  ;; can expand one of them. Strictly safer than the reference's order, and
  ;; disclosed rather than silent.

  ;; 4d: {{llmll}} is the compiler command, substituted before the
  ;; precondition values on the same argument as the barriers constant: a
  ;; path carries no placeholder, so its position against the artifact values
  ;; cannot expand one of them.
  (def-shell render [i: int j: int tpl: string src: string
                     pvals: list[string] llmll: string] -> string
    (let [(t1 (if (stage-needs-src? i) (replace-all tpl "{{rfc_text}}" src) tpl))]
      (let [(t2 (if (stage-needs-barriers? i)
                    (replace-all t1 "{{barriers}}" (barriers-json))
                    t1))]
        (let [(t3 (if (string-empty? (stage-tag-upper i j))
                      t2
                      (replace-all t2 "{{extractor}}" (stage-tag-upper i j))))]
          (let [(t4 (if (stage-needs-llmll? i) (replace-all t3 "{{llmll}}" llmll) t3))]
            (list-fold (range 0 (stage-pre-count i)) t4
              (fn [acc: string n: int]
                (replace-all acc (stage-pre-key i n)
                             (unwrap-or (list-nth pvals n) "")))))))))

  ;; The prompt write, then the agent, in one seq-commands. RC-2 is
  ;; discard-left, so the response the Delegate arm receives is the RUN's and
  ;; the write's is dropped -- which mirrors the reference, whose
  ;; prompt_path.write_text (:299) is likewise unchecked.
  ;; _provision_reference: LLMLL.md and docs/llmll-ast.schema.json into the
  ;; agent's directory, for the stages that ask an agent to write LLMLL
  ;; (registry.stage-provision-ref?). Unchecked copies, as shutil.copy2 is
  ;; there: seq-commands performs both effects whatever the left one answered,
  ;; so a missing --reference-dir or a missing file leaves the agent without
  ;; the manual and does not halt, which is the reference's `if src.exists()`
  ;; tolerance reproduced rather than a halt invented.
  (def-shell ref-copies [c: Cfg i: int j: int tail: Command] -> Command
    (if (or (not (stage-provision-ref? i)) (string-empty? (cfg-refdir c)))
        tail
        (seq-commands
          (wasi.fs.copy (string-concat (cfg-refdir c) "/LLMLL.md")
                        (string-concat (agent-dir c i j) "/LLMLL.md"))
          (seq-commands
            (wasi.fs.copy (string-concat (cfg-refdir c) "/docs/llmll-ast.schema.json")
                          (string-concat (agent-dir c i j) "/llmll-ast.schema.json"))
            tail))))

  (def-shell delegate-cmd [rn: Run i: int j: int rendered: string] -> Command
    (let [(c (cfg-of rn))]
      (let [(dir (agent-dir c i j))]
        (seq-commands
          (wasi.fs.mkdir dir)
          (ref-copies c i j
           (seq-commands
            (wasi.fs.write (prompt-file c i j) rendered)
            (wasi.proc.run
              (ag-exe (cfg-agent c))
              (list-map (ag-args (cfg-agent c))
                (fn [a: string] (subst-arg a (prompt-file c i j)
                                             (agent-out-path c i j) dir)))
              dir
              (string-concat dir "/agent.stdout.log")
              (string-concat dir "/agent.stderr.log")
              (ag-timeout (cfg-agent c))
              "/dev/null")))))))

  (def-shell tmpl-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (match r
        ((RText tpl)
          (let [(rendered (render i (b-tag b) tpl (b-acc b) (b-pvals b)
                                  (cfg-llmll (cfg-of rn))))]
            (if (string-contains rendered "{{")
                (halt-verdict rn (b-k b) Malformed
                  (string-concat-many
                    ["prompt " (stage-prompt i) ": unfilled placeholders remain "
                     "after substitution"]))
                (go rn (Delegate b) (delegate-cmd rn i (b-tag b) rendered)))))
        ((RErr _)  (halt-verdict rn (b-k b) Absent
                     (string-concat-many
                       ["prompt " (stage-prompt i) ": not readable under "
                        "--prompts-dir " (ag-prompts (cfg-agent (cfg-of rn)))])))
        ((RNone)   (halt-verdict rn (b-k b) Absent "prompt template unreadable"))
        ((RCode _) (halt-verdict rn (b-k b) Absent "prompt template unreadable"))
        ((RList _) (halt-verdict rn (b-k b) Absent "prompt template unreadable")))))

  ;; ---- Delegate --------------------------------------------------------
  ;;
  ;; AgentRunner.run's two non-output conditions. RErr carries BOTH the budget
  ;; overrun (:317-326) and a spawn that never started, which the reference
  ;; would see as exit 127 from the shell; the port cannot tell them apart at
  ;; the response and says so in the detail rather than picking one.
  ;;
  ;; Rev 9 settles what section 3.1's row 3 and section 10 case 4 do not say:
  ;; the non-zero-exit raise at :328-330 runs BEFORE the output-existence
  ;; check at :331-334, so a stage that produced a valid declared output and
  ;; exited non-zero records `failed`, not `complete`. Measured; see the 4b
  ;; plan. This arm reproduces the reference and not the proposal's table.

  (def-shell delegate-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (match r
        ((RCode c)
          (if (= c 0)
              (go rn (Outp b) (wasi.fs.read (agent-out-path (cfg-of rn) i (b-tag b))))
              (halt-errored rn (b-k b)
                (string-concat-many
                  ["agent[" (stage-agent-label i (b-tag b)) "] exited "
                   (int-to-string c)
                   "; see " (agent-dir (cfg-of rn) i (b-tag b))
                   "/agent.stderr.log"]))))
        ((RErr e)
          (halt-errored rn (b-k b)
            (string-concat-many
              ["agent[" (stage-agent-label i (b-tag b))
               "] did not complete within its "
               (int-to-string (ag-timeout (cfg-agent (cfg-of rn))))
               "s budget, or could not be started (" e "). Its partial work is "
               "in " (agent-dir (cfg-of rn) i (b-tag b))
               ". Re-run this stage with a "
               "larger --timeout, or treat the overrun as a finding."])))
        ((RText _) (halt-errored rn (b-k b) "agent produced no exit status"))
        ((RNone)   (halt-errored rn (b-k b) "agent produced no exit status"))
        ((RList _) (halt-errored rn (b-k b) "agent produced no exit status")))))

  ;; ---- content-shape extraction (4c) -----------------------------------
  ;;
  ;; The shell half of shape.llmll. Everything that touches a string or a Json
  ;; is here; the four proved decisions take only bool and int. That split is
  ;; what keeps the regexes out of the proved core, which LLMLL.md:326 and :356
  ;; require: regex-match is outside Sigma_auto, so a proved def calling it
  ;; would fall to erBodyFallback and forfeit the body-faithful claim.
  ;;
  ;; THE TWO PATTERN CHECKS ARE HAND-ROLLED, AND NOT BY CHOICE. `regex-match` is
  ;; a documented builtin (LLMLL.md:326), is in the type environment
  ;; (TypeCheck.hs:143), and its preamble implementation is emitted
  ;; (CodegenHs.hs:395-396) -- and a program calling it DOES NOT BUILD. Measured
  ;; at v0.14.87: `llmll check` and `llmll verify` both pass, then GHC fails with
  ;; "Variable not in scope: regex". Parser.hs:943 lists regex-match among the
  ;; OPERATORS beside and/or/=>, so it is parsed as an operator and emitted
  ;; infix with its hyphen unmangled, and unlike and/or it has no infix
  ;; lowering. Its in-tree firing population was ZERO before this module, which
  ;; is why a typed, documented, preamble-backed builtin was never code-generated
  ;; once. Filed as `REGEX-LOWER-1`; 4c does not work around it silently.
  ;;
  ;; Both replacements are EXACTLY equivalent on their domains, not
  ;; approximations. `^C[1-6]$` is a six-element membership test, which is the
  ;; pattern's extension. `^N\d+$` is the letter N followed by at least one
  ;; digit, checked position by position; `\d` and `[0-9]` agree on every rule
  ;; identifier stage C authors, and the scan uses only Sigma_auto-safe builtins,
  ;; so these predicates could move into a proved def where a regex could not.

  (def-shell arr-of [v: Json k: string] -> list[Json]
    (match (json-get v k)
      ((Success a) (unwrap-or (json-array a) (list-empty)))
      ((Error _)   (list-empty))))

  (def-shell has-arr? [v: Json k: string] -> bool
    (match (json-get v k)
      ((Success a) (is-ok (json-array a)))
      ((Error _)   false)))

  (def-shell key-there? [r: Json k: string] -> bool
    (is-ok (json-get r k)))

  (def-shell str-at [r: Json k: string] -> string
    (unwrap-or (json-get-string r k) ""))

  (def-shell nonempty-str? [r: Json k: string] -> bool
    (not (string-empty? (str-at r k))))

  (def-shell bool-at [r: Json k: string] -> bool
    (unwrap-or (json-get-bool r k) false))

  ;; A probe row indexes `p["file"]` and `p["mutant_file"]` unguarded in the
  ;; reference (stage_H_feasibility); [H7-ROWS] is the guarded form.
  (def-shell probe-row-ok? [r: Json] -> bool
    (and (key-there? r "file") (key-there? r "mutant_file")))

  ;; `^N\d+$` (:422), position by position. The length guard is the `+`: a bare
  ;; "N" has no digits and the fold over an empty range would otherwise answer
  ;; true.
  (def-shell digit-at? [s: string n: int] -> bool
    (string-contains "0123456789" (string-char-at s n)))

  (def-shell rule-ok? [s: string] -> bool
    (and (> (string-length s) 1)
         (and (= (string-char-at s 0) "N")
              (list-fold (range 1 (string-length s)) true
                (fn [acc: bool n: int] (and acc (digit-at? s n)))))))

  ;; `^C[1-6]$` (:490) as its extension, which is six strings.
  (def-shell class-ok? [s: string] -> bool
    (list-contains
      (list-prepend "C1" (list-prepend "C2" (list-prepend "C3"
        (list-prepend "C4" (list-prepend "C5" (list-prepend "C6" (list-empty)))))))
      s))

  ;; check_extraction's five per-row clauses (:403-424) as one predicate. The
  ;; seven required keys, integer line bounds, the bounds in order, and the rule
  ;; pattern. A non-string `rule` is rejected here where the reference would
  ;; str() it first (:422); disclosed, and no producer in the tree emits one.
  (def-shell extr-row-ok? [r: Json] -> bool
    (and (key-there? r "id")
    (and (key-there? r "source")
    (and (key-there? r "quote")
    (and (key-there? r "obligation")
    (and (is-ok (json-get-int r "line_start"))
    (and (is-ok (json-get-int r "line_end"))
    (and (<= (unwrap-or (json-get-int r "line_start") 0)
             (unwrap-or (json-get-int r "line_end") 0))
         (rule-ok? (str-at r "rule"))))))))))

  ;; DISPOSITIONS (:98), the closed four.
  (def-shell dispositions [] -> list[string]
    (list-prepend "Encoded"
      (list-prepend "Deployment-modeled"
        (list-prepend "Vectored"
          (list-prepend "Dispositioned out" (list-empty))))))

  ;; BARRIERS' keys (:87-96), the closed eight.
  (def-shell barrier-keys [] -> list[string]
    (list-prepend "B1" (list-prepend "B2" (list-prepend "B3"
      (list-prepend "B4" (list-prepend "B5" (list-prepend "B6"
        (list-prepend "B7" (list-prepend "B8" (list-empty))))))))))

  (def-shell row-cid [r: Json] -> string
    (if (nonempty-str? r "cid") (str-at r "cid") (str-at r "id")))

  ;; check_dispositioned's five `require` clauses (:486-499). NOT its
  ;; require_spec (:493), which is the barrier condition and records `stopped`.
  (def-shell disp-row-ok? [r: Json] -> bool
    (and (not (string-empty? (row-cid r)))
    (and (list-contains (dispositions) (str-at r "disposition"))
    (and (class-ok? (str-at r "class"))
         (nonempty-str? r "reason")))))

  (def-shell excluded? [r: Json] -> bool
    (= (str-at r "disposition") "Dispositioned out"))

  (def-shell cites-listed-barrier? [r: Json] -> bool
    (list-contains (barrier-keys) (str-at r "barrier")))

  (def-shell is-passed [v: Verdict] -> bool
    (match v ((Passed) true) ((Absent) false) ((Malformed) false)))

  ;; The stage's content-shape verdict, per registry.stage-shape. Passed when the
  ;; stage declares no shape, which is every stage 4b ported.
  (def-shell shape-verdict [i: int t: string] -> Verdict
    (if (= (stage-shape i) 0)
        Passed
        (match (json-parse t)
          ((Error _) Malformed)
          ((Success v)
            (if (= (stage-shape i) 1)
                (let [(rows (arr-of v "normative"))]
                  (if (extraction-conforms? (is-ok (json-get v "normative"))
                                            (has-arr? v "normative")
                                            (has-arr? v "excluded")
                                            (list-length rows)
                                            (list-length (list-filter rows (fn [r: Json] (extr-row-ok? r)))))
                      Passed Malformed))
            (if (= (stage-shape i) 2)
                (if (core-conforms? (has-arr? v "core_ids")
                                    (list-length (arr-of v "core_ids")))
                    Passed Malformed)
            (if (= (stage-shape i) 4)
                (let [(rows (unwrap-or (json-array v) (list-empty)))]
                  (if (probe-rows-conform? (is-ok (json-array v))
                                           (list-length rows)
                                           (list-length (list-filter rows (fn [r: Json] (probe-row-ok? r)))))
                      Passed Malformed))
                (let [(rows (arr-of v "rows"))]
                  (if (dispositions-conform? (has-arr? v "rows")
                                             (list-length rows)
                                             (list-length (list-filter rows (fn [r: Json] (disp-row-ok? r)))))
                      Passed Malformed)))))))))

  ;; Stage G's ONE spec-defined condition (:493), driver-spec sec 6:229-231.
  ;; Separate from shape-verdict because its disposition is `stopped`, and it
  ;; therefore does NOT go through validate.verdict-outcome, whose [V7-NO-STOP]
  ;; forbids ConditionUnmet. Proposal section 9.2 item 1 does not record that 4c
  ;; constructs this arm; shape.llmll's header does.
  (def-shell barrier-met? [i: int t: string] -> bool
    (if (not (= (stage-shape i) 3))
        true
        (match (json-parse t)
          ((Error _) true)
          ((Success v)
            (let [(ex (list-filter (arr-of v "rows") (fn [r: Json] (excluded? r))))]
              (barrier-condition-met?
                (list-length ex)
                (list-length (list-filter ex (fn [r: Json] (cites-listed-barrier? r))))))))))

  ;; ---- Outp ------------------------------------------------------------
  ;;
  ;; THE ACCEPTANCE CLAUSE OF SUB-PHASE 4b LANDS HERE. `present` and `size`
  ;; are handed to validate.verdict-of together with the floor the STAGE
  ;; CONTRACT declares, and the Verdict is handed to verdict-outcome. Nothing
  ;; in this function decides what a failing output does; it decides what the
  ;; operator is told it was.
  ;;
  ;; 4c adds the content-shape verdict beside the floor verdict and the barrier
  ;; condition beside both. The three combine here rather than inside any of
  ;; them: a stage fails validation if EITHER verdict rejects, and stops if the
  ;; barrier condition is unmet.

  (def-shell shape-detail [i: int] -> string
    (if (= (stage-shape i) 1)
        (string-concat-many
          ["stage " (stage-key i) ": " (base-of (stage-out i 0))
           " does not meet the shape reconcile.py consumes: it must be an object "
           "carrying non-empty `normative` and `excluded` lists, and every "
           "normative row must carry the seven required keys with integer line "
           "bounds in order and a rule matching N followed by digits"])
    (if (= (stage-shape i) 2)
        (string-concat-many
          ["stage " (stage-key i) ": expected a non-empty core_ids list"])
    (if (= (stage-shape i) 4)
        (string-concat-many
          ["stage " (stage-key i) ": expected a list of probes, each naming a "
           "file and a mutant_file"])
        (string-concat-many
          ["stage " (stage-key i) ": dispositions: expected rows, each carrying a "
           "cid, a disposition from the closed four, a class C1 through C6, and "
           "a reason"])))))

  (def-shell floor-detail [i: int] -> string
    (if (= i 1)
        "stage B: scope.md is too short to state a boundary"
        (if (= i 2)
            "stage C: rubric.md is too short"
            (if (> (stage-shape i) 0)
                (shape-detail i)
                (string-concat-many
                  ["stage " (stage-key i) ": " (base-of (stage-out i 0))
                   " is below the floor its stage contract declares"])))))

  (def-shell absent-detail [c: Cfg i: int j: int] -> string
    (string-concat-many
      ["agent[" (stage-agent-label i j) "] exited 0 but wrote no "
       (base-of (stage-agent-out i j)) "; the stage contract was not met (see "
       (agent-dir c i j) "/agent.stdout.log)"]))

  (def-shell outp-detail [c: Cfg i: int j: int v: Verdict] -> string
    (match v
      ((Absent)    (absent-detail c i j))
      ((Malformed) (floor-detail i))
      ((Passed)    "")))

  ;; The barrier condition's detail, which must name its clause: `stopped` rows
  ;; carry the driver-spec sentence that authorised them (section 4:126).
  (def-shell barrier-detail [i: int] -> string
    (string-concat-many
      ["stage " (stage-key i) ": a row dispositioned out cites a barrier that is "
       "not in the closed list. An exclusion outside the list is a STOP "
       "(playbook stage J)."]))

  ;; check_extraction mutates its argument (:425-427) and stage D then stamps the
  ;; extractor and rewrites its own declared output (:657-658); its log line reads
  ;; the counts that mutation produced (:660-661). The committed extraction-a.json
  ;; carries counts {normative: 119, excluded: 85}, so the write-back is
  ;; observable in the artifact and is not optional.
  (def-shell stamped-doc [i: int j: int t: string] -> string
    (match (json-parse t)
      ((Error _) t)
      ((Success v)
        (json-serialize
          (jset
            (jset v "extractor" (json-of-string (stage-tag-upper i j)))
            "counts"
            (jset
              (jset json-object "normative"
                    (json-of-int (list-length (arr-of v "normative"))))
              "excluded"
              (json-of-int (list-length (arr-of v "excluded")))))))))

  ;; Whether this stage rewrites its own output after validating it. Stage D only.
  (def-shell restamps? [i: int] -> bool
    (= (stage-shape i) 1))

  ;; What follows a passing output: the next invocation if the stage has one, and
  ;; otherwise the digest sweep over its declared outputs. Stage D's write-back
  ;; rides in front of either command with seq-commands, which is discard-left, so
  ;; the response delivered is the one the next arm expects.
  ;; The staging copies of registry.stage-stage-dest, in front of `tail`.
  ;; seq-commands is discard-left, so tail's response is what the next arm
  ;; receives however many copies precede it. The destination directory is
  ;; created first: mkdir creates parents and is RNone on an existing directory,
  ;; both measured.
  (def-shell stage-copies [rn: Run i: int tail: Command] -> Command
    (if (string-empty? (stage-stage-dir i))
        tail
        (seq-commands
          (wasi.fs.mkdir (wd-path (cfg-of rn) (stage-stage-dir i)))
          (list-fold (range 0 (stage-out-count i)) tail
            (fn [acc: Command j: int]
              (if (string-empty? (stage-stage-dest i j))
                  acc
                  (seq-commands
                    (wasi.fs.copy (art-path (cfg-of rn) i j)
                                  (wd-path (cfg-of rn) (stage-stage-dest i j)))
                    acc)))))))

  (def-shell outp-next [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (let [(c (cfg-of rn))]
        (let [(last? (>= (+ (b-tag b) 1) (stage-tag-count i)))]
          ;; The next invocation re-enters at PROVISIONING, not at Tmpl: each
          ;; extractor gets its own isolated input set, so tag b needs the same
          ;; mkdir, copies and rubric write tag a got. Measured at v0.14.87 --
          ;; re-entering Tmpl left extractor B's directory holding only PROMPT.md
          ;; and the logs, which is precisely the blindness stage D exists to
          ;; make structural, defeated by a phase transition.
          (let [(nxt (if last?
                         (pair (mk-sm (b-k b) 0 (b-start b) json-object)
                               (stage-copies rn i (wasi.fs.sha256 (art-path c i 0))))
                         (pair (Prov (b-next-tag b))
                               (prov-cmd rn i (+ (b-tag b) 1)))))]
            (go rn (first nxt)
                (if (restamps? i)
                    (seq-commands
                      (wasi.fs.write (art-path c i (b-tag b))
                                     (stamped-doc i (b-tag b) t))
                      (second nxt))
                    (second nxt))))))))


  ;; DUPLICATED WITH wave.llmll ON PURPOSE, and program unification does NOT
  ;; retire it. The comment that used to sit here said the opposite: it called
  ;; the duplication a thing that "retires at program unification", on the
  ;; precedent of the 4c barrier. That was written before anyone measured what
  ;; the two copies are for. They are pinned by two different covers for two
  ;; different reasons: this copy by test_driver_ll_4d.py, which pins the "SAFE"
  ;; lexeme against the compiler that prints it, and the wave's copy by
  ;; test_driver_ll_4e.py, which lists it in SEAM as a function that reads
  ;; another process's stdout and proves nothing about it. A body-equality
  ;; census puts it in the collapse set and the census is wrong here. The move
  ;; was TRIED at the unification job (a) pass and both covers failed.
  ;;
  ;; body-faithful-all? is NOT the duplicated one, despite sitting beside it.
  ;; The wave's sibling is body-faithful?, which takes two arguments and checks
  ;; that a target name appears; this one takes one and excludes body-fallback:.
  ;; Different functions with similar names, which is why the older comment's
  ;; phrase "duplicated with one strengthening" reads as describing both.
  (def-shell verify-safe? [out: string] -> bool
    (string-contains out "SAFE"))

  (def-shell body-faithful-all? [out: string] -> bool
    (and (string-contains out "body-faithful:")
         (not (string-contains out "body-fallback:"))))

  ;; The transition every stage takes once its declared output is accepted:
  ;; the digest sweep over its outputs. The 4d loops reach it after their own
  ;; work, so it is a function rather than a line inside outp-next.
  (def-shell to-summed [rn: Run k: int start: int] -> ((Run, Ctl), Command)
    (go rn (mk-sm k 0 start json-object)
        (wasi.fs.sha256 (art-path (cfg-of rn) (idx-at rn k) 0))))

  ;; Where the stage's agent worked, and so where its files are: `wd / p["file"]`
  ;; with wd = 07-feasibility for H and 13-kill-matrix for N.
  (def-shell in-agent-dir [rn: Run k: int name: string] -> string
    (string-concat-many [(agent-dir (cfg-of rn) (idx-at rn k) 0) "/" name]))

  ;; `llmll verify FILE --strict-verified-core`, run then read. One transcript
  ;; pair per (row, half), so an absent transcript is distinguishable from a
  ;; stale one, the wave's per-attempt reasoning. The budget is the agent's:
  ;; the reference's _verify has none at all, and PROC-TIMEOUT-1 means this one
  ;; does not fire either, so no cell may claim it.
  (def-shell verify-cmd [rn: Run k: int file: string tag: string] -> Command
    (let [(c (cfg-of rn))]
      (let [(dir (agent-dir c (idx-at rn k) 0))]
        (let [(out (string-concat-many [dir "/verify-" tag ".stdout.log"]))]
          (seq-commands
            (wasi.proc.run (cfg-llmll c)
                           ["verify" file "--strict-verified-core"]
                           dir
                           out
                           (string-concat-many [dir "/verify-" tag ".stderr.log"])
                           (ag-timeout (cfg-agent c))
                           "/dev/null")
            (wasi.fs.read out))))))

  ;; A quoted, comma-separated list in brackets: the reference logs and
  ;; reports Python list reprs, `['probe-2']`.
  (def-shell quoted-list [names: list[string]] -> string
    (string-concat-many
      ["["
       (list-fold names ""
         (fn [acc: string n: string]
           (string-concat-many [acc (if (string-empty? acc) "" ", ") "'" n "'"])))
       "]"]))

  ;; ---- H ---------------------------------------------------------------
  ;;
  ;;   HGood   r is sha256 of probe idx's file, the `good.exists()` half
  ;;   HMut    r is sha256 of its mutant file, the `mutant.exists()` half
  ;;   HOutG   r is the read of the probe's verify transcript
  ;;   HOutM   r is the read of the mutant's verify transcript; the row is scored
  ;;   HWrote  r is the write of feasibility.json; the stage bar is decided
  ;;
  ;; THE WRITE PRECEDES THE DECISION BY ONE STEP AND THAT IS THE POINT. The
  ;; reference writes feasibility.json and only then halts on the bar
  ;; (require_written, its only call site), so driver-spec sec 4:146-147
  ;; applies and the disposition is `stopped`, not `failed`. stage.record-outcome
  ;; proves PartialThenHalt -> Stopped and cannot see the ordering; a port that
  ;; decided in the arm that ISSUES the write would record the right status
  ;; with the artifact not yet on disk when the manifest row lands. HWrote
  ;; receives the write's response, so the file exists before the halt is
  ;; constructed. Cover cell H1 asserts the file beside the disposition.
  ;;
  ;; This is the FIRST PartialThenHalt a ported stage constructs; the 4a
  ;; injector's is scaffolding. 4b built two Outcome arms, 4c three, and this
  ;; site completes all four (proposal section 9.3 item 2).

  (def-shell h-probe-name [row: Json] -> string
    (str-at row "name"))

  (def-shell h-probe-file [rn: Run l: Loop key: string] -> string
    (in-agent-dir rn (lp-k l) (str-at (lp-row l) key)))

  (def-shell h-missing [rn: Run l: Loop] -> ((Run, Ctl), Command)
    (halt-errored rn (lp-k l)
      (string-concat-many ["stage H: probe " (h-probe-name (lp-row l))
                           " names files that do not exist"])))

  ;; A port-only condition: the reference captures the transcript in-process
  ;; and cannot fail to read it. Fails toward a re-run.
  (def-shell h-unreadable [rn: Run l: Loop half: string] -> ((Run, Ctl), Command)
    (halt-errored rn (lp-k l)
      (string-concat-many ["stage H: the compiler's transcript for probe "
                           (h-probe-name (lp-row l)) " (" half
                           ") could not be read; see "
                           (agent-dir (cfg-of rn) (idx-at rn (lp-k l)) 0)])))

  ;; Enter at row idx: probe its file's presence, or, past the last row, write
  ;; the declared output.
  (def-shell h-next [rn: Run l: Loop] -> ((Run, Ctl), Command)
    (if (< (lp-idx l) (lp-count l))
        (go rn (HGood l) (wasi.fs.sha256 (h-probe-file rn l "file")))
        (go rn (HWrote l)
            (wasi.fs.write (art-path (cfg-of rn) (idx-at rn (lp-k l)) 0)
                           (json-serialize (lp-acc l))))))

  ;; Outp has already passed the catalogue through shape.probe-rows-conform?
  ;; (stage-shape 4), so it parses and is a non-empty array whose rows carry
  ;; both file keys; the Error arm is unreachable and fails toward a re-run.
  (def-shell h-enter [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (match (json-parse t)
      ((Success v)
        (h-next rn (mk-loop (b-k b) (b-start b) 0 v (json-of-list (list-empty)) "")))
      ((Error _)
        (halt-verdict rn (b-k b) Malformed "stage H: expected a list of probes"))))

  (def-shell hgood-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (go rn (HMut l) (wasi.fs.sha256 (h-probe-file rn l "mutant_file")))
        (h-missing rn l)))

  (def-shell hmut-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (go rn (HOutG l)
            (verify-cmd rn (lp-k l) (h-probe-file rn l "file")
                        (string-concat (int-to-string (lp-idx l)) "-probe")))
        (h-missing rn l)))

  (def-shell houtg-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (go rn (HOutM (lp-with-note l (text-of r)))
            (verify-cmd rn (lp-k l) (h-probe-file rn l "mutant_file")
                        (string-concat (int-to-string (lp-idx l)) "-mutant")))
        (h-unreadable rn l "probe")))

  ;; The reference's row: {name, probe: {file, safe, body_faithful}, mutant:
  ;; {file, safe}, pass}. `returncode` and the 4000-byte `output` tail are NOT
  ;; carried: the fold never sees the code, and the whole transcript is in the
  ;; agent directory as verify-<idx>-<half>.stdout.log. Disclosed.
  (def-shell h-row [row: Json ps: bool pbf: bool ms: bool ok: bool] -> Json
    (jset (jset (jset (jset json-object
                            "name" (json-of-string (h-probe-name row)))
                      "probe" (jset (jset (jset json-object
                                                "file" (json-of-string (str-at row "file")))
                                          "safe" (json-of-bool ps))
                                    "body_faithful" (json-of-bool pbf)))
                "mutant" (jset (jset json-object
                                     "file" (json-of-string (str-at row "mutant_file")))
                               "safe" (json-of-bool ms)))
          "pass" (json-of-bool ok)))

  (def-shell h-line [row: Json ps: bool ms: bool ok: bool] -> string
    (string-concat-many
      ["  probe " (h-probe-name row) ": probe=" (if ps "SAFE" "not-SAFE")
       " mutant=" (if ms "SURVIVED" "refuted") " -> " (if ok "ok" "FAIL")]))

  ;; oracle.probe-established?, the per-probe bar of stage H.
  (def-shell probe-ok? [ps: bool pbf: bool ms: bool] -> bool
    (probe-established? ps pbf ms))

  (def-shell houtm-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (let [(ps (verify-safe? (lp-note l)))]
          (let [(pbf (body-faithful-all? (lp-note l)))]
            (let [(ms (verify-safe? (text-of r)))]
              (let [(ok (probe-ok? ps pbf ms))]
                (let [(nxt (h-next rn (lp-scored l (h-row (lp-row l) ps pbf ms ok))))]
                  (pair (first nxt)
                        (seq-commands (wasi.io.stdout (h-line (lp-row l) ps ms ok))
                                      (second nxt))))))))
        (h-unreadable rn l "mutant")))

  (def-shell h-passing [l: Loop] -> int
    (list-length (list-filter (lp-acc-list l) (fn [r: Json] (bool-at r "pass")))))

  (def-shell h-bad-names [l: Loop] -> string
    (quoted-list
      (list-map (list-filter (lp-acc-list l) (fn [r: Json] (not (bool-at r "pass"))))
                (fn [r: Json] (h-probe-name r)))))

  ;; oracle.feasibility-established?, the stage bar. Its pre holds by
  ;; construction: the passing rows are counted among the scored rows.
  (def-shell feasible? [n: int passing: int] -> bool
    (feasibility-established? n passing))

  (def-shell hwrote-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (feasible? (list-length (lp-acc-list l)) (h-passing l))
        (to-summed rn (lp-k l) (lp-start l))
        (halt-with rn (lp-k l) PartialThenHalt
          (string-concat-many
            ["stage H: feasibility not established for " (h-bad-names l)
             ". A probe must verify body-faithfully AND its mutant must refute; "
             "otherwise the contract shape is decorative and the target should "
             "be re-scoped, not re-graded."])
          "driver-spec sec 4:146-147")))

  ;; ---- K ---------------------------------------------------------------
  ;;
  ;;   KCheck  r is `llmll check`'s exit status over the authored roots
  ;;
  ;; Stage K's validator IS the compiler (proposal section 9.3 item 3): the
  ;; halt reads an exit code rather than an artifact, so K needs no clause in
  ;; validate.llmll or shape.llmll and no proved decision of its own. Two
  ;; figures ride in the payload for the log line only: the Encoded row count
  ;; the prompt carried and the `count("?")` over the roots text. THE HOLE
  ;; COUNT IS NOT A GATE and must not become one: it is false the moment a `?`
  ;; appears inside a string literal, which is why the reference prints it
  ;; with a `~` and decides nothing on it.

  (def-shell hole-count [t: string] -> int
    (- (list-length (split-on "?" t)) 1))

  ;; The Encoded rows the prompt carried: precondition value 0 is mode 3's
  ;; serialized array. 0 when it does not parse, which cannot happen past Pre.
  (def-shell encoded-count [b: Body] -> int
    (match (json-parse (unwrap-or (list-nth (b-pvals b) 0) ""))
      ((Success v) (list-length (unwrap-or (json-array v) (list-empty))))
      ((Error _)   0)))

  (def-shell k-enter [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (let [(c (cfg-of rn))]
      (let [(i (idx-at rn (b-k b)))]
        (let [(dir (agent-dir c i 0))]
          (go rn (mk-kc (b-k b) (b-start b) (encoded-count b) (hole-count t))
              (wasi.proc.run (cfg-llmll c)
                             ["check" (art-path c i 0)]
                             dir
                             (string-concat dir "/check.stdout.log")
                             (string-concat dir "/check.stderr.log")
                             (ag-timeout (cfg-agent c))
                             "/dev/null"))))))

  (def-shell k-line [i: int d: (int, (int, (int, int)))] -> string
    (string-concat-many
      ["  authored " (int-to-string (kc-enc d)) " Encoded rows into "
       (base-of (stage-out i 0)) " (typechecks; ~"
       (int-to-string (kc-holes d)) " holes)"]))

  ;; The reference embeds the first 3000 bytes of the compiler's output in the
  ;; detail; the port names the transcript instead, as delegate-step names
  ;; agent.stderr.log. Same disposition, shorter row. Disclosed.
  (def-shell kcheck-step [rn: Run d: (int, (int, (int, int))) r: Response]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (kc-k d)))]
      (let [(dir (agent-dir (cfg-of rn) i 0))]
        (match r
          ((RCode c)
            (if (= c 0)
                (let [(nxt (to-summed rn (kc-k d) (kc-start d)))]
                  (pair (first nxt)
                        (seq-commands (wasi.io.stdout (k-line i d)) (second nxt))))
                (halt-errored rn (kc-k d)
                  (string-concat-many
                    ["stage K: authored roots do not typecheck; see " dir
                     "/check.stdout.log"]))))
          ((RErr e)
            (halt-errored rn (kc-k d)
              (string-concat-many
                ["stage K: llmll check did not complete within its "
                 (int-to-string (ag-timeout (cfg-agent (cfg-of rn))))
                 "s budget, or could not be started (" e ")"])))
          ((RText _) (halt-errored rn (kc-k d) "stage K: llmll check produced no exit status"))
          ((RNone)   (halt-errored rn (kc-k d) "stage K: llmll check produced no exit status"))
          ((RList _) (halt-errored rn (kc-k d) "stage K: llmll check produced no exit status"))))))

  ;; ---- N ---------------------------------------------------------------
  ;;
  ;;   NRow    r is sha256 of mutant idx's file, the `f.exists()` require
  ;;   NSkip   r is the log line for an UNWRITABLE row, which has no file
  ;;   NOut    r is the read of the mutant's verify transcript; the row is scored
  ;;   NWrote  r is the write of kill-matrix.json
  ;;
  ;; The catalogue must be a JSON array. The reference iterates read_json(out)
  ;; directly, and an object there tracebacks on `m.get` (AttributeError); the
  ;; port has no exception to fall through and records `failed`, section 9.1
  ;; item 1's disposition for a guarded read.
  ;;
  ;; oracle.matrix-complete? decides BEFORE the write: a matrix with fewer
  ;; scored rows than input rows is never written. Its false branch is
  ;; unreachable by construction (every row reaches NOut or NSkip and each
  ;; appends exactly one entry) and fails toward a re-run rather than toward a
  ;; short matrix, on the same reasoning as the response arms no command
  ;; produces. The reference has no halt after its loop and none is invented:
  ;; survivors are printed and kept.

  (def-shell m-name [row: Json] -> string
    (str-at row "name"))

  (def-shell unwritable? [row: Json] -> bool
    (or (bool-at row "unwritable") (string-empty? (str-at row "file"))))

  ;; `"reason": m.get("reason") or m.get("note")`; "" where the reference
  ;; would carry null.
  (def-shell unwritable-row [row: Json] -> Json
    (jset (jset (jset (jset (jset json-object
                                  "name" (json-of-string (m-name row)))
                            "good_twin" (json-of-bool (bool-at row "good_twin")))
                      "verdict" (json-of-string "unwritable"))
                "as_expected" (json-of-bool true))
          "reason" (json-of-string (if (string-empty? (str-at row "reason"))
                                       (str-at row "note")
                                       (str-at row "reason")))))

  ;; oracle.outcome-as-expected?, the per-mutant polarity.
  (def-shell as-expected? [vs: bool twin: bool] -> bool
    (outcome-as-expected? vs twin))

  (def-shell scored-row [row: Json vs: bool] -> Json
    (jset (jset (jset (jset (jset json-object
                                  "name" (json-of-string (m-name row)))
                            "good_twin" (json-of-bool (bool-at row "good_twin")))
                      "killed" (json-of-bool (not vs)))
                "verdict" (json-of-string (if vs "SAFE" "refuted")))
          "as_expected" (json-of-bool (as-expected? vs (bool-at row "good_twin")))))

  (def-shell n-line [row: Json vs: bool] -> string
    (string-concat-many
      ["  " (m-name row) ": " (if vs "SAFE" "refuted")
       (if (bool-at row "good_twin") " (good twin)" "")
       (if (as-expected? vs (bool-at row "good_twin")) "" "   <-- UNEXPECTED")]))

  (def-shell survivor? [r: Json] -> bool
    (and (not (bool-at r "good_twin"))
         (and (not (= (str-at r "verdict") "refuted"))
              (not (= (str-at r "verdict") "unwritable")))))

  (def-shell survivors-line [l: Loop] -> string
    (let [(names (list-map (list-filter (lp-acc-list l) (fn [r: Json] (survivor? r)))
                           (fn [r: Json] (m-name r))))]
      (if (= (list-length names) 0)
          ""
          (string-concat "  SURVIVORS (reported, not dropped): " (quoted-list names)))))

  ;; oracle.matrix-complete?, the denominator.
  (def-shell complete-matrix? [rows: int scored: int] -> bool
    (matrix-complete? rows scored))

  (def-shell n-advance [rn: Run l: Loop] -> ((Run, Ctl), Command)
    (if (< (lp-idx l) (lp-count l))
        (if (unwritable? (lp-row l))
            (go rn (NSkip l)
                (wasi.io.stdout
                  (string-concat-many ["  " (m-name (lp-row l))
                                       ": unwritable (kept in the denominator)"])))
            (go rn (NRow l)
                (wasi.fs.sha256 (in-agent-dir rn (lp-k l) (str-at (lp-row l) "file")))))
        (if (complete-matrix? (lp-count l) (list-length (lp-acc-list l)))
            (go rn (NWrote l)
                (wasi.fs.write (art-path (cfg-of rn) (idx-at rn (lp-k l)) 0)
                               (json-serialize (lp-acc l))))
            (halt-errored rn (lp-k l)
              (string-concat-many
                ["stage N: a mutant row reached neither a verdict nor the "
                 "unwritable branch (unreachable by construction; recorded so a "
                 "short matrix is never written)"])))))

  (def-shell n-enter [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (match (json-parse t)
      ((Success v)
        (if (is-ok (json-array v))
            (n-advance rn (mk-loop (b-k b) (b-start b) 0 v (json-of-list (list-empty)) ""))
            (halt-verdict rn (b-k b) Malformed
              "stage N: mutants.json must be a JSON array of mutant entries")))
      ((Error _)
        (halt-verdict rn (b-k b) Malformed
          "stage N: mutants.json must be a JSON array of mutant entries"))))

  (def-shell nskip-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (n-advance rn (lp-scored l (unwritable-row (lp-row l)))))

  (def-shell nrow-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (go rn (NOut l)
            (verify-cmd rn (lp-k l)
                        (in-agent-dir rn (lp-k l) (str-at (lp-row l) "file"))
                        (string-concat "mutant-" (int-to-string (lp-idx l)))))
        (halt-errored rn (lp-k l)
          (string-concat-many ["stage N: mutant file " (str-at (lp-row l) "file")
                               " not written"]))))

  (def-shell nout-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (let [(vs (verify-safe? (text-of r)))]
          (let [(nxt (n-advance rn (lp-scored l (scored-row (lp-row l) vs))))]
            (pair (first nxt)
                  (seq-commands (wasi.io.stdout (n-line (lp-row l) vs)) (second nxt)))))
        (halt-errored rn (lp-k l)
          (string-concat-many ["stage N: the compiler's transcript for mutant "
                               (m-name (lp-row l)) " could not be read; see "
                               (agent-dir (cfg-of rn) (idx-at rn (lp-k l)) 0)]))))

  (def-shell nwrote-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (let [(nxt (to-summed rn (lp-k l) (lp-start l)))]
      (if (string-empty? (survivors-line l))
          nxt
          (pair (first nxt)
                (seq-commands (wasi.io.stdout (survivors-line l)) (second nxt))))))

  ;; ---- 4f: O -------------------------------------------------------------
  ;;
  ;;   OWrote  r is the copy of the agent's report onto the DECLARED output,
  ;;           after which the omission check decides
  ;;   OSkip   the same copy, with no kill matrix to check against
  ;;
  ;; THE COPY IS THE DECLARED WRITE. `stage_O_writeup` ends in
  ;; `shutil.copy2(workdir/"14-report"/"REPORT.md", workdir/"REPORT.md")`, and
  ;; the registry's declared output for stage O is that root copy. So the
  ;; validator runs AFTER the stage has written its declared artifact, which
  ;; puts its halt on section 3.6's axis and makes it `stopped`
  ;; (PartialThenHalt) rather than `failed`. This is the second real
  ;; PartialThenHalt site, after stage H's probe-polarity bar at 4d.
  ;;
  ;; It does NOT qualify under section 3.5's rule: driver-spec sec 13 mandates
  ;; RESOLUTION, not halting, and section 13 is not a section 6 gate, so the
  ;; second conjunct of that rule fails. The disposition comes from the artifact
  ;; state alone.
  ;;
  ;; wasi.fs.copy is byte-faithful and shutil.copy2 also copies mtime and mode.
  ;; No section 13 obligation mentions either, so the divergence is disclosed
  ;; and decides nothing.
  ;;
  ;; THREE DISPOSITIONS AND THE MIDDLE ONE IS THE ONE TO GET RIGHT:
  ;;
  ;;   the matrix parses      the check runs, and passing is the only way to
  ;;                          reach `complete`
  ;;   the matrix is absent   the Pre loop already substituted "(stage not
  ;;                          run)", so there is no reference set and the check
  ;;                          decides NOTHING. The stage records `complete` and
  ;;                          SAYS SO ON STDOUT. A run with no kill matrix must
  ;;                          not read as a checked run, which is the vacuity
  ;;                          the phase has now lost a clause to three times.
  ;;   the matrix is present
  ;;   and does not parse     a guarded read over an input, decided BEFORE the
  ;;                          copy, so `failed`/Errored per proposal section
  ;;                          9.1 item 1. The reference never parses this file
  ;;                          and cannot reach the condition.

  ;; The kill matrix arrives as precondition value 2 (registry.stage-pre-path
  ;; 15 2), which the Pre loop has already read. No second read of the file.
  (def-shell o-matrix-text [b: Body] -> string
    (unwrap-or (list-nth (b-pvals b) 2) ""))

  (def-shell named? [rep: string row: Json] -> bool
    (string-contains rep (m-name row)))

  (def-shell o-named-count [rep: string rows: list[Json]] -> int
    (list-length (list-filter rows (fn [r: Json] (named? rep r)))))

  ;; survivor? is stage N's predicate, shared rather than re-derived, so the
  ;; SURVIVORS line and this count cannot disagree about what survived.
  (def-shell o-survivor-count [rows: list[Json]] -> int
    (list-length (list-filter rows (fn [r: Json] (survivor? r)))))

  (def-shell o-survivors-unnamed [rep: string rows: list[Json]] -> int
    (list-length (list-filter rows
                              (fn [r: Json] (and (survivor? r)
                                                 (not (named? rep r)))))))

  (def-shell o-missing-names [l: Loop] -> list[string]
    (list-map (list-filter (lp-row-list l)
                           (fn [r: Json] (not (named? (lp-note l) r))))
              (fn [r: Json] (m-name r))))

  ;; report.omission-free?. Its pre holds by construction: every count is over
  ;; the same row list, the named rows are among the rows, and an unnamed
  ;; survivor is one of the unnamed rows.
  (def-shell omission-ok? [rows: int named: int surv: int unnamed: int] -> bool
    (omission-free? rows named surv unnamed))

  (def-shell o-copy-cmd [rn: Run b: Body] -> Command
    (let [(i (idx-at rn (b-k b)))]
      (wasi.fs.copy (agent-out-path (cfg-of rn) i (b-tag b))
                    (art-path (cfg-of rn) i 0))))

  (def-shell o-malformed-detail [] -> string
    (string-concat-many
      ["stage O: 13-kill-matrix/kill-matrix.json is present and is not a JSON "
       "array, so the perturbation-omission check of driver-spec sec 13 has no "
       "reference set to difference against. The reference never parses this "
       "file and cannot reach this condition; the port reads it and records "
       "the stage failed rather than reporting a check it did not run."]))

  (def-shell o-enter [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (if (= (o-matrix-text b) (not-run))
        (go rn (OSkip (mk-loop (b-k b) (b-start b) 0 json-object json-object t))
            (o-copy-cmd rn b))
        (match (json-parse (o-matrix-text b))
          ((Success v)
            (if (is-ok (json-array v))
                (go rn (OWrote (mk-loop (b-k b) (b-start b) 0 v json-object t))
                    (o-copy-cmd rn b))
                (halt-errored rn (b-k b) (o-malformed-detail))))
          ((Error _) (halt-errored rn (b-k b) (o-malformed-detail))))))

  ;; Only the RErr arm is a failure. Every wasi command delivers its failure
  ;; there, and a successful copy carries nothing this step reads.
  (def-shell copy-failed? [r: Response] -> bool
    (match r
      ((RErr _)  true)
      ((RText _) false)
      ((RNone)   false)
      ((RCode _) false)
      ((RList _) false)))

  (def-shell o-copy-detail [rn: Run l: Loop] -> string
    (string-concat-many
      ["stage O: the report could not be copied to "
       (art-path (cfg-of rn) (idx-at rn (lp-k l)) 0)
       ", so the stage wrote no declared output."]))

  (def-shell o-omitted-detail [l: Loop] -> string
    (string-concat-many
      ["stage O: the report does not name "
       (int-to-string (list-length (o-missing-names l))) " of the "
       (int-to-string (lp-count l)) " kill-matrix rows: "
       (quoted-list (o-missing-names l))
       ". driver-spec sec 13 requires the FULL result of the perturbation "
       "exercise, including perturbations that were not detected. Naming a "
       "row is not resolving it; that clause is disclosure-only and this check "
       "does not decide it."]))

  (def-shell o-skip-line [] -> string
    (string-concat-many
      ["  no kill matrix: the perturbation-omission check did not run"]))

  (def-shell o-decide [rn: Run l: Loop] -> ((Run, Ctl), Command)
    (if (omission-ok? (lp-count l)
                      (o-named-count (lp-note l) (lp-row-list l))
                      (o-survivor-count (lp-row-list l))
                      (o-survivors-unnamed (lp-note l) (lp-row-list l)))
        (to-summed rn (lp-k l) (lp-start l))
        (halt-with rn (lp-k l) PartialThenHalt (o-omitted-detail l)
                   "driver-spec sec 13")))

  (def-shell owrote-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (copy-failed? r)
        (halt-errored rn (lp-k l) (o-copy-detail rn l))
        (o-decide rn l)))

  (def-shell oskip-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (copy-failed? r)
        (halt-errored rn (lp-k l) (o-copy-detail rn l))
        (let [(nxt (to-summed rn (lp-k l) (lp-start l)))]
          (pair (first nxt)
                (seq-commands (wasi.io.stdout (o-skip-line)) (second nxt))))))

  ;; ---- the dispatch, per registry.stage-oracle ----------------------------

  (def-shell oracle-enter [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (let [(o (stage-oracle (idx-at rn (b-k b))))]
      (if (= o 1) (h-enter rn b t)
      (if (= o 2) (k-enter rn b t)
          (n-enter rn b t)))))

  ;; What follows a passing output. A stage with a compiler oracle enters its
  ;; loop; every other stage takes the 4b/4c path in outp-next.
  (def-shell outp-pass [rn: Run b: Body t: string] -> ((Run, Ctl), Command)
    (if (stage-omission-check? (idx-at rn (b-k b)))
        (o-enter rn b t)
    (if (> (stage-oracle (idx-at rn (b-k b))) 0)
        (oracle-enter rn b t)
        (outp-next rn b t))))


  ;; ---- stage A: intake and provenance pinning ---------------------------
  ;;
  ;; stage_A_intake, over wasi.http.get (v0.21.0), which lifted the STOP this
  ;; stage carried since v0.14.83. Per source, in argv order (the RFC, then
  ;; each --amend-url): if the destination is absent or --force is set, fetch
  ;; it; then digest it, count its lines and append the pin. After the last
  ;; source, write PROVENANCE.json, the declared output.
  ;;
  ;;   AProbe   wasi.fs.sha256 of dest: RText means present (the reference's
  ;;            `dest.exists()`), RErr means absent. Present and not forced
  ;;            skips the fetch and keeps the hex; forced or absent fetches.
  ;;   AFetch   wasi.http.get's arm. RNone: the COMPLETE body is at dest.
  ;;            RErr: dest is unchanged and the text names the status or the
  ;;            transport failure; the reference tracebacks out of urlopen
  ;;            here (unguarded), so the port records failed/Errored on
  ;;            section 9.1 item 1's precedent.
  ;;   ADigest  sha256 of the fetched file.
  ;;   ALines   the read, for `text.count("\n")`. The reference decodes with
  ;;            errors="replace" and cannot fail; wasi.fs.read answers RErr on
  ;;            bytes that are not UTF-8 and the port records failed, the
  ;;            divergence the 4b header records for _sources_text.
  ;;   AWrote   the PROVENANCE.json write; then the digest sweep.
  ;;
  ;; The file name is the URL's last non-empty `/` field, or rfc.txt: the
  ;; reference's `url.rstrip("/").split("/")[-1] or "rfc.txt"`. The mkdir of
  ;; 00-source precedes the fetch because wasi.http.get does not create
  ;; dest's parent (LLMLL.md sec 13). The log lines are the reference's.
  ;; PROVENANCE.json is `{"sources": [{url, file, sha256, lines}, ...]}`;
  ;; json-serialize's whitespace differs from json.dumps(indent=1), which
  ;; nothing consumes (stage B re-serializes it, mode PARSE).

  (def-shell source-name [url: string] -> string
    (let [(n (list-fold (split-on "/" url) ""
               (fn [acc: string f: string] (if (string-empty? f) acc f))))]
      (if (string-empty? n) "rfc.txt" n)))

  (def-shell a-urls [c: Cfg] -> Json
    (json-of-list
      (list-map (list-fold (cfg-amend-urls c)
                           (list-append (list-empty) (cfg-rfc-url c))
                           (fn [acc: list[string] u: string] (list-append acc u)))
                (fn [u: string] (json-of-string u)))))

  (def-shell a-url [l: Loop] -> string
    (unwrap-or (json-as-string (lp-row l)) ""))

  (def-shell a-dest [rn: Run l: Loop] -> string
    (string-concat-many [(wd-path (cfg-of rn) "00-source") "/" (source-name (a-url l))]))

  (def-shell a-line-count [t: string] -> int
    (- (list-length (split-on "\n" t)) 1))

  (def-shell a-pin [url: string hex: string lines: int] -> Json
    (jset (jset (jset (jset json-object "url" (json-of-string url))
                      "file" (json-of-string (source-name url)))
                "sha256" (json-of-string hex))
          "lines" (json-of-int lines)))

  (def-shell a-next [rn: Run l: Loop] -> ((Run, Ctl), Command)
    (if (< (lp-idx l) (lp-count l))
        (go rn (AProbe l) (wasi.fs.sha256 (a-dest rn l)))
        (go rn (AWrote l)
            (wasi.fs.write (art-path (cfg-of rn) (idx-at rn (lp-k l)) 0)
                           (json-serialize (jset json-object "sources" (lp-acc l)))))))

  (def-shell a-enter [rn: Run k: int start: int] -> ((Run, Ctl), Command)
    (a-next rn (mk-loop k start 0 (a-urls (cfg-of rn)) (json-of-list (list-empty)) "")))

  (def-shell a-fetch-cmd [rn: Run l: Loop] -> Command
    (seq-commands
      (wasi.io.stdout (string-concat "  fetching " (a-url l)))
      (seq-commands
        (wasi.fs.mkdir (wd-path (cfg-of rn) "00-source"))
        (wasi.http.get (a-url l) (a-dest rn l)))))

  (def-shell aprobe-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (and (present? r) (not (cfg-forced (cfg-of rn))))
        (go rn (ALines (lp-with-note l (text-of r))) (wasi.fs.read (a-dest rn l)))
        (go rn (AFetch l) (a-fetch-cmd rn l))))

  (def-shell afetch-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (match r
      ((RNone)   (go rn (ADigest l) (wasi.fs.sha256 (a-dest rn l))))
      ((RErr e)  (halt-errored rn (lp-k l)
                   (string-concat-many
                     ["stage A: fetching " (a-url l) " failed (" e "); "
                      (source-name (a-url l)) " is unchanged"])))
      ((RText _) (halt-errored rn (lp-k l) "stage A: the fetch produced no arm"))
      ((RCode _) (halt-errored rn (lp-k l) "stage A: the fetch produced no arm"))
      ((RList _) (halt-errored rn (lp-k l) "stage A: the fetch produced no arm"))))

  (def-shell adigest-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (go rn (ALines (lp-with-note l (text-of r))) (wasi.fs.read (a-dest rn l)))
        (halt-errored rn (lp-k l)
          (string-concat-many ["stage A: " (source-name (a-url l))
                               " was fetched but could not be digested"]))))

  (def-shell a-pinned-line [url: string hex: string lines: int] -> string
    (string-concat-many
      ["  pinned " (source-name url) ": " (string-slice hex 0 16) "... ("
       (int-to-string lines) " lines)"]))

  (def-shell alines-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (if (present? r)
        (let [(n (a-line-count (text-of r)))]
          (let [(nxt (a-next rn (lp-scored l (a-pin (a-url l) (lp-note l) n))))]
            (pair (first nxt)
                  (seq-commands (wasi.io.stdout (a-pinned-line (a-url l) (lp-note l) n))
                                (second nxt)))))
        (halt-errored rn (lp-k l)
          (string-concat-many
            ["stage A: " (source-name (a-url l)) " is not readable text. The "
             "reference decodes it with errors=\"replace\" and cannot reach this; "
             "the port records the stage failed rather than pinning a line count "
             "over bytes it could not read."]))))

  (def-shell awrote-step [rn: Run l: Loop r: Response] -> ((Run, Ctl), Command)
    (to-summed rn (lp-k l) (lp-start l)))

  (def-shell outp-decide [rn: Run b: Body present: bool size: int t: string]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (b-k b)))]
      (let [(v (if (is-passed (verdict-of present size (stage-floor i)))
                   (shape-verdict i t)
                   (verdict-of present size (stage-floor i))))]
        (match v
          ((Passed)
            (if (barrier-met? i t)
                (outp-pass rn b t)
                (halt-with rn (b-k b) ConditionUnmet (barrier-detail i)
                           "driver-spec sec 6:229-231")))
          ((Absent)    (halt-verdict rn (b-k b) v
                         (outp-detail (cfg-of rn) i (b-tag b) v)))
          ((Malformed) (halt-verdict rn (b-k b) v
                         (outp-detail (cfg-of rn) i (b-tag b) v)))))))

  (def-shell outp-step [rn: Run b: Body r: Response] -> ((Run, Ctl), Command)
    (match r
      ((RText t)  (outp-decide rn b true (string-length t) t))
      ((RErr _)   (outp-decide rn b false 0 ""))
      ((RNone)    (outp-decide rn b false 0 ""))
      ((RCode _)  (outp-decide rn b false 0 ""))
      ((RList _)  (outp-decide rn b false 0 ""))))

  (def-shell made-step [rn: Run d: (int, (int, int)) r: Response] -> ((Run, Ctl), Command)
    (if (< (+ (md-j d) 1) (stage-out-count (idx-at rn (md-k d))))
        (go rn (mk-md (md-k d) (+ (md-j d) 1) (md-start d))
            (write-cmd rn (md-k d) (+ (md-j d) 1)))
        (go rn (mk-sm (md-k d) 0 (md-start d) json-object)
            (wasi.fs.sha256 (art-path (cfg-of rn) (idx-at rn (md-k d)) 0)))))

  ;; The reference's outputs map is comprehended over the declared outputs THAT
  ;; EXIST (:2010-2011), so a missing artifact yields a SHORT map rather than a
  ;; null. An RErr here is that filter.
  (def-shell summed-step [rn: Run d: (int, (int, (int, Json))) r: Response]
      -> ((Run, Ctl), Command)
    (let [(i (idx-at rn (sm-k d)))]
      (let [(outs (if (string-empty? (hex-of r))
                      (sm-outs d)
                      (jset (sm-outs d) (stage-out i (sm-j d))
                            (json-of-string (hex-of r)))))]
        (if (< (+ (sm-j d) 1) (stage-out-count i))
            (go rn (mk-sm (sm-k d) (+ (sm-j d) 1) (sm-start d) outs)
                (wasi.fs.sha256 (art-path (cfg-of rn) i (+ (sm-j d) 1))))
            (go rn (mk-st (sm-k d) (sm-start d) outs) wasi.clock.monotonic)))))

  (def-shell stamped-step [rn: Run d: (int, (int, Json)) r: Response]
      -> ((Run, Ctl), Command)
    (if (halts-post? rn (st-k d))
        (halt-now rn (st-k d) PartialThenHalt (st-start d))
        (let [(i (idx-at rn (st-k d)))]
          (let [(m2 (put-row (man-of rn) (stage-key i)
                             (complete-row (stage-kind i)
                                           (secs-between (st-start d) (ns-of r))
                                           (st-outs d))))]
            (go (with-man rn m2) (mk-rc (st-k d) 0)
                (wasi.fs.write (manifest-path (cfg-of rn)) (json-serialize m2)))))))

  ;; The manifest write has already happened on entry here, so a halt can go
  ;; straight to Done: the command this arm returns is the one RC-4 drops.
  (def-shell recorded-step [rn: Run d: (int, int)] -> ((Run, Ctl), Command)
    (if (= (rc-code d) 0)
        (enter rn (+ (rc-k d) 1))
        (go rn (Done (rc-code d)) (wasi.io.stdout ""))))

  (def-shell drv-init [] -> ((Run, Ctl), Command)
    (pair (pair (Run (pair (Cfg (pair "."
                                 (pair "" (pair "" (pair ""
                                   (pair false
                                     (pair (AgentCfg (pair "" (pair (list-empty)
                                                              (pair "" 1800))))
                                           (pair "" (pair "" (pair "" (list-empty)))))))))))
                           (pair (empty-manifest) (list-empty))))
                (Boot 0))
          wasi.proc.args))

  (def-shell drv-step [s: (Run, Ctl) input: string r: Response]
      -> ((Run, Ctl), Command)
    (match (phase-of s)
      ((Boot n)     (boot-step   (run-of s) n r))
      ((Digest d)   (digest-step (run-of s) d r))
      ((Started k)  (started-step (run-of s) k r))
      ((Made d)     (made-step   (run-of s) d r))
      ((Pre b)      (pre-step    (run-of s) b r))
      ((Srcs b)     (srcs-step   (run-of s) b r))
      ((Src b)      (src-step    (run-of s) b r))
      ((Prov b)     (prov-step   (run-of s) b r))
      ((Copy b)     (copy-step   (run-of s) b r))
      ((Tmpl b)     (tmpl-step   (run-of s) b r))
      ((Delegate b) (delegate-step (run-of s) b r))
      ((Outp b)     (outp-step   (run-of s) b r))
      ((Summed d)   (summed-step (run-of s) d r))
      ((Stamped d)  (stamped-step (run-of s) d r))
      ((Recorded d) (recorded-step (run-of s) d))
      ((Ending c)   (go (run-of s) (Done c) (wasi.io.stdout "")))
      ((Done c)     (go (run-of s) (Done c) (wasi.io.stdout "")))
      ((HGood l)    (hgood-step  (run-of s) l r))
      ((HMut l)     (hmut-step   (run-of s) l r))
      ((HOutG l)    (houtg-step  (run-of s) l r))
      ((HOutM l)    (houtm-step  (run-of s) l r))
      ((HWrote l)   (hwrote-step (run-of s) l r))
      ((KCheck d)   (kcheck-step (run-of s) d r))
      ((NRow l)     (nrow-step   (run-of s) l r))
      ((NSkip l)    (nskip-step  (run-of s) l r))
      ((NOut l)     (nout-step   (run-of s) l r))
      ((NWrote l)   (nwrote-step (run-of s) l r))
      ((AProbe l)   (aprobe-step (run-of s) l r))
      ((AFetch l)   (afetch-step (run-of s) l r))
      ((ADigest l)  (adigest-step (run-of s) l r))
      ((ALines l)   (alines-step (run-of s) l r))
      ((AWrote l)   (awrote-step (run-of s) l r))
      ((OWrote l)   (owrote-step (run-of s) l r))
      ((OSkip l)    (oskip-step  (run-of s) l r))))

  (def-shell drv-done? [s: (Run, Ctl)] -> bool
    (match (phase-of s)
      ((Boot _)     false)
      ((Digest _)   false)
      ((Started _)  false)
      ((Made _)     false)
      ((Pre _)      false)
      ((Srcs _)     false)
      ((Src _)      false)
      ((Prov _)     false)
      ((Copy _)     false)
      ((Tmpl _)     false)
      ((Delegate _) false)
      ((Outp _)     false)
      ((Summed _)   false)
      ((Stamped _)  false)
      ((Recorded _) false)
      ((Ending _)   false)
      ((Done _)     true)
      ((HGood _)    false)
      ((HMut _)     false)
      ((HOutG _)    false)
      ((HOutM _)    false)
      ((HWrote _)   false)
      ((KCheck _)   false)
      ((NRow _)     false)
      ((NSkip _)    false)
      ((NOut _)     false)
      ((NWrote _)   false)
      ((AProbe _)   false)
      ((AFetch _)   false)
      ((ADigest _)  false)
      ((ALines _)   false)
      ((AWrote _)   false)
      ((OWrote _)   false)
      ((OSkip _)    false)))

  (def-shell done-code [s: (Run, Ctl)] -> int
    (match (phase-of s)
      ((Boot _)     1)
      ((Digest _)   1)
      ((Started _)  1)
      ((Made _)     1)
      ((Pre _)      1)
      ((Srcs _)     1)
      ((Src _)      1)
      ((Prov _)     1)
      ((Copy _)     1)
      ((Tmpl _)     1)
      ((Delegate _) 1)
      ((Outp _)     1)
      ((Summed _)   1)
      ((Stamped _)  1)
      ((Recorded _) 1)
      ((Ending _)   1)
      ((Done c)     c)
      ((HGood _)    1)
      ((HMut _)     1)
      ((HOutG _)    1)
      ((HOutM _)    1)
      ((HWrote _)   1)
      ((KCheck _)   1)
      ((NRow _)     1)
      ((NSkip _)    1)
      ((NOut _)     1)
      ((NWrote _)   1)
      ((AProbe _)   1)
      ((AFetch _)   1)
      ((ADigest _)  1)
      ((ALines _)   1)
      ((AWrote _)   1)
      ((OWrote _)   1)
      ((OSkip _)    1)))

  ;; The terminal marker. It leaves through :on-done rather than through a
  ;; step, because RC-4 drops the terminating step's command and a halt report
  ;; that is constructed and not performed fails driver-spec section 4:139-143
  ;; SILENTLY. spine.llmll:673-679 records :on-done as unusable and is right
  ;; for an int state; section 4's sum carries the reason, so it becomes
  ;; available here.
  (def-shell drv-final [s: (Run, Ctl)] -> Command
    (wasi.io.stdout
      (string-concat "[driver-ll] end status=" (int-to-string (done-code s)))))

  ;; :status. Contract-checked, not body-faithful; see the header. The clamp is
  ;; what makes the declared range true by construction rather than by
  ;; assertion, and it fails in the safe direction: 256 exits 255, not 0.
  ;;
  ;; EVERY ARM BINDS ITS PAYLOAD, including the eight that ignore it. A `_`
  ;; there is PWildcard, and isCoreBodySyntactic's payload-constructor leg
  ;; (Syntax.hs:810) admits only PConstructor n [PVar _], so a wildcard turns
  ;; the whole match into non-core syntax and the def is rejected at `check`.
  (def drv-status [s: (Run, Ctl)] -> int
    (post (and (>= result 0) (<= result 255))
      :source "[EXIT-RANGE] PROC-BOUNDARY-1 sec 4.4 - the declared range on the function :status names")
    (match (second s)
      ((Boot b)     1)
      ((Digest d)   1)
      ((Started k)  1)
      ((Made m)     1)
      ((Pre pb)     1)
      ((Srcs sb)    1)
      ((Src cb)     1)
      ((Prov vb)    1)
      ((Copy yb)    1)
      ((Tmpl tb)    1)
      ((Delegate g) 1)
      ((Outp ob)    1)
      ((Summed u)   1)
      ((Stamped t)  1)
      ((Recorded v) 1)
      ((Ending e)   1)
      ((Done c)     (if (< c 0) 1 (if (> c 255) 255 c)))
      ((HGood hg)   1)
      ((HMut hm)    1)
      ((HOutG ho)   1)
      ((HOutM hp)   1)
      ((HWrote hw)  1)
      ((KCheck kd)  1)
      ((NRow nr)    1)
      ((NSkip ns)   1)
      ((NOut no)    1)
      ((NWrote nw)  1)
      ((AProbe ap)  1)
      ((AFetch af)  1)
      ((ADigest ad) 1)
      ((ALines al)  1)
      ((AWrote aw)  1)
      ((OWrote ow)  1)
      ((OSkip os)   1)))

  (def-main
    :mode    console
    :init    (drv-init)
    :step    drv-step
    :done?   drv-done?
    :on-done drv-final
    :status  drv-status))
