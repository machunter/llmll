(module crux-skip-digest-dropped)
;; INVENTED MUTANT, and the DISCRIMINATING one. Phase 4 proposal section 10
;; case 19.
;;
;; crux-skip-presence-only.llmll drops the PRESENCE conjunct, and both
;; [S5-SKIP] and [S5-PRESENCE] refute it. This drops the DIGEST conjunct
;; instead: [S5-SKIP] refutes and [S5-PRESENCE] does not, because presence
;; alone still cannot cause a skip here. The pair makes the entailment
;; [S5-SKIP] |= [S5-PRESENCE] observable in the gate rather than only argued,
;; which is what CLAUSE-INDEP-1 is filed against: no mutation refutes
;; [S5-PRESENCE] ALONE.
;;
;; The shipped defect this is adjacent to is real: presence is not integrity,
;; and an artifact edited after its stage recorded completion is not that
;; stage's output. Dropping the digest conjunct is how a hand-edited body
;; entered the ARP tree unnoticed.
(def may-skip [manifest-complete: bool artifacts-present: bool
               digests-match: bool forced: bool] -> bool

  (post (=> result (and manifest-complete
                        (and artifacts-present digests-match)))
    :source "[S5-SKIP] driver-spec.txt sec 5 - skipped only when all three hold")

  (post (=> forced (not result))
    :source "[S5-FORCE] driver-spec.txt sec 5 - a forced re-run runs regardless")

  (post (=> (and artifacts-present (not manifest-complete)) (not result))
    :source "[S5-PRESENCE] driver-spec.txt sec 5 - presence alone MUST NOT cause a skip")

  (and (not forced)
       (and manifest-complete artifacts-present)))
