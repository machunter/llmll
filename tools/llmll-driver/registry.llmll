;; DRIVER-LL Phase 4, sub-phase 4a: the stage registry.
;;
;; The sixteen stages of scripts/rfc_to_implementation.py's STAGES list
;; (:1507-1545), as if-chains over an index rather than as data read from a
;; file. The reason is the one wasi.proc.run's argv split rests on
;; (TypeCheck.hs builtinEnv, the wasi.proc.run entry): a table written as
;; syntax is a constant a reader enumerates from the source, where a table read
;; from an artifact is whatever the artifact happened to say. The Python
;; registry has the same property for the same reason.
;;
;; FIELD ORDER, because the Python dataclass and its log line disagree.
;; Stage(key, name, kind, fn, outputs) is the constructor (:1499-1505), so
;; Stage("A", "intake and provenance pinning", "mechanical", ...) has kind
;; THIRD. The log line is `stage {key} [{kind}] {name}` (:1953). Reading the
;; constructor as (key, kind, name) puts the stage's prose where its kind
;; belongs in every line the cover asserts on.
;;
;; DECLARED OUTPUTS, not written ones. driver-spec.txt section 5's skip
;; conditions quantify over "every artifact the stage declares", and section
;; 3.6 of the Phase 4 proposal settles the same reading for the
;; PartialThenHalt axis. Nineteen declared outputs over sixteen stages; three
;; stages declare two (D, L, M) and the rest declare one.
;;
;; stage-out-dir is declared rather than derived. There is no string operation
;; that splits a path at its last separator, and deriving it with string-split
;; and a fold would put a parser between the registry and the filesystem for a
;; value that is a constant. The cost is that a path and its directory can
;; drift apart; scripts/driver_ll_cover.py asserts every declared output
;; actually appears under the workdir after a run, which is what catches it.

(module registry)

(def-shell stage-count [] -> int 16)

(def-shell stage-key [i: int] -> string
  (if (= i 0)  "A"
  (if (= i 1)  "B"
  (if (= i 2)  "C"
  (if (= i 3)  "D"
  (if (= i 4)  "E"
  (if (= i 5)  "F"
  (if (= i 6)  "G"
  (if (= i 7)  "G2"
  (if (= i 8)  "H"
  (if (= i 9)  "I"
  (if (= i 10) "J"
  (if (= i 11) "K"
  (if (= i 12) "L"
  (if (= i 13) "M"
  (if (= i 14) "N"
  (if (= i 15) "O"
      "?")))))))))))))))))

(def-shell stage-kind [i: int] -> string
  (if (= i 0)  "mechanical"
  (if (= i 1)  "agent"
  (if (= i 2)  "agent"
  (if (= i 3)  "agent"
  (if (= i 4)  "mechanical"
  (if (= i 5)  "agent"
  (if (= i 6)  "agent"
  (if (= i 7)  "gate"
  (if (= i 8)  "agent"
  (if (= i 9)  "agent"
  (if (= i 10) "gate"
  (if (= i 11) "agent"
  (if (= i 12) "gate"
  (if (= i 13) "agent"
  (if (= i 14) "agent"
  (if (= i 15) "agent"
      "?")))))))))))))))))

(def-shell stage-name [i: int] -> string
  (if (= i 0)  "intake and provenance pinning"
  (if (= i 1)  "scope decision"
  (if (= i 2)  "normativity rubric"
  (if (= i 3)  "dual blind extraction"
  (if (= i 4)  "mechanical reconciliation"
  (if (= i 5)  "characteristic core"
  (if (= i 6)  "disposition pass"
  (if (= i 7)  "artifact audit"
  (if (= i 8)  "feasibility probes"
  (if (= i 9)  "pre-registration"
  (if (= i 10) "the gate"
  (if (= i 11) "root contract authoring"
  (if (= i 12) "coverage lint and freeze"
  (if (= i 13) "the swarm"
  (if (= i 14) "kill matrix"
  (if (= i 15) "writeup"
      "?")))))))))))))))))

(def-shell stage-out-count [i: int] -> int
  (if (= i 3) 2 (if (= i 12) 2 (if (= i 13) 2 1))))

(def-shell stage-out [i: int j: int] -> string
  (if (= i 0)  "00-source/PROVENANCE.json"
  (if (= i 1)  "01-scope/scope.md"
  (if (= i 2)  "02-rubric/rubric.md"
  (if (= i 3)  (if (= j 0) "03-extraction/a/extraction.json"
                           "03-extraction/b/extraction.json")
  (if (= i 4)  "04-reconcile/SUMMARY.json"
  (if (= i 5)  "05-core/core.json"
  (if (= i 6)  "06-disposition/inventory-dispositioned.json"
  (if (= i 7)  "06b-audit/audit.json"
  (if (= i 8)  "07-feasibility/feasibility.json"
  (if (= i 9)  "08-prereg/PRE-REGISTRATION.md"
  (if (= i 10) "09-gate/gate.json"
  (if (= i 11) "10-roots/roots.llmll"
  (if (= i 12) (if (= j 0) "11-freeze/rfc-cov-1.txt"
                           "11-freeze/ROOTS.txt")
  (if (= i 13) (if (= j 0) "12-wave/wave.json"
                           "12-wave/roots.ast.json")
  (if (= i 14) "13-kill-matrix/kill-matrix.json"
  (if (= i 15) "REPORT.md"
      "?")))))))))))))))))

;; ------------------------------------------------------------------
;; Sub-phase 4b: the three stages that have real bodies, and the four
;; constants each one's body reads out of this table.
;;
;; WHY THE TABLE AND NOT THE STAGE BODY. A per-stage constant written inside
;; a stage body is a value only that body's author can enumerate; written
;; here it is a row a reader checks against rfc_to_implementation.py's
;; corresponding stage function. stage-floor in particular is the constant
;; driver-spec.txt section 7:288-291 turns on: it is the bar the STAGE
;; CONTRACT declares, which is what makes validate.verdict-of subject-neutral,
;; and it must not become a value measured from a run.
;; ------------------------------------------------------------------

;; True for the stages sub-phases 4b, 4c and 4d land. Every other stage keeps
;; the 4a stub write. This is scaffolding with a schedule, exactly as the 4a
;; injector is: 4c retired D, F and G from the false half, 4d retires H, K and
;; N, 4e landed M in wave.llmll rather than here (so 13 stays false by design),
;; 4f O. A and E are mechanical and outside proposal section 9's sub-phase
;; table; A is ported over wasi.http.get (v0.21.0, the STOP lifted) as the
;; roadmap's step (3), and E waits on a reconcile.py invocation.
;;
;; 4f lands O and takes the count to eleven. Stage O is the LAST stage this
;; program stubs that is its own to land: E, G2, J and L are real in
;; spine.llmll and M in wave.llmll, and all five stay stubbed here until
;; program unification retires this table.
;;
;; STAGE M'S ROW IS NOW DEAD AND THE TABLE KEEPS IT ANYWAY. Program unification
;; job (a2) folded stage M into the sequencer's stage loop, and `started-step`
;; reads `stage-fanout` BEFORE it reads this table, so row 13 is never
;; consulted. It reads false and stage M is ported, which is exactly the kind of
;; sentence this table exists to stop being true; it is recorded here rather
;; than repaired because flipping the row would be cosmetic and deleting the
;; table is blocked on E, J, L and G2, which still live unreached in
;; spine.llmll. Section 2 clause 3 of the unification proposal deletes this
;; table, not corrects it, and that clause closes when those four land.
;;
;; SO THE COUNT OF STAGES THIS PROGRAM STILL STUBS IS FOUR, not five: E, G2, J
;; and L. Do not read "five stubbed stages" off this table any more.
;;
;; 4c LANDS D, F AND G TOGETHER rather than in its plan's stated order, and the
;; reason is a data dependency the plan did not weigh. F reads
;; 04-reconcile/data/extraction-a.json, which stage D stages there (:663-665),
;; and G reads the core F writes. A tree with D still stubbed cannot exercise F
;; or G end to end at all, because the 4a stub writes to the stage's own
;; declared outputs and not to the directory the next stage reads. The plan's
;; "smallest first" ordering was an authoring argument and shape.llmll already
;; discharged it; the landing order follows the pipeline.
;;
(def-shell stage-ported? [i: int] -> bool
  (if (= i 0) true
  (if (= i 1) true
  (if (= i 2) true
  (if (= i 3) true
  (if (= i 5) true
  (if (= i 6) true
  (if (= i 8) true
  (if (= i 9) true
  (if (= i 11) true
  (if (= i 14) true
  (if (= i 15) true false))))))))))))

;; The byte floor the stage contract declares for the stage's declared output.
;; NEGATIVE means the contract declares no floor.
;;
;;   B  200  rfc_to_implementation.py:579-580, `out.stat().st_size > 200`
;;   C  400  :593, `out.stat().st_size > 400`
;;   I   -1  NO VALIDATOR. Proposal section 9.1 item 2, measured: stage I
;;           (:1053-1065) holds zero halt calls, and a 0-byte and a 28-byte
;;           PRE-REGISTRATION.md both record `complete` at exit 0. A validator
;;           where the reference has none is new behaviour and must not ride
;;           in on a port; it lands at 4f beside stage O's.
;;
;; A negative floor does NOT disable the presence check. That one is
;; AgentRunner's (:331-334), per delegated call rather than per declared
;; floor, and validate's [V7-PRESENCE] holds for every floor.
;;
;; 4c ADDS NO FLOORS, and the absence is a measurement rather than an
;; oversight. D, F and G declare no byte floor at all: their stage contracts
;; declare a SHAPE, checked by check_extraction (:386), the core-ids clause
;; (:714) and check_dispositioned (:481). So all three keep -1 here and carry
;; their contract through stage-shape instead.
;;
;; 4d ADDS NO FLOORS EITHER. H, K and N declare no byte floor: H's contract is
;; the probe manifest's SHAPE (stage-shape 4) and then the COMPILER's verdict
;; per probe; K's is the compiler's exit status alone; N's per-row checks are
;; guarded reads inside its score loop. All three keep -1 here.
;;
;; -1 THEREFORE MEANS TWO DIFFERENT THINGS and a reader must not collapse
;; them. For stage I it means the contract declares no validation at all
;; (proposal section 9.1 item 2, measured: zero halt calls). For D, F and G it
;; means no BYTE floor while a shape check applies. stage-shape is what
;; separates the two, and stage I is 0 there.
(def-shell stage-floor [i: int] -> int
  (if (= i 1) 200 (if (= i 2) 400 (- 0 1))))

;; Which content-shape validator the stage contract declares, as the tag
;; shape.llmll's four proved decisions are keyed by. 0 is none.
;;
;;   1  extraction    check_extraction (:386-428), stage D
;;   2  core          the core-ids clause (:712-714), stage F
;;   3  dispositions  check_dispositioned (:481-500), stage G
;;   4  probes        the `isinstance(probes, list) and probes` require and the
;;                    per-row `p["file"]` / `p["mutant_file"]` indexing in
;;                    stage_H_feasibility, decided by shape.probe-rows-conform?
;;
;; Stage G's validator holds a FOURTH decision this tag does not name: the
;; closed-barrier condition of :493, which is `require_spec` and therefore
;; spec-defined and `stopped` where the other five are `require` and `failed`.
;; It is not a shape check and does not route through validate.verdict-outcome;
;; see shape.llmll's header, item 3. Keying it here would have put a stopped
;; disposition behind a table entry named for a shape.
(def-shell stage-shape [i: int] -> int
  (if (= i 3) 1 (if (= i 5) 2 (if (= i 6) 3 (if (= i 8) 4 0)))))

;; The prompt template, by basename under --prompts-dir.
(def-shell stage-prompt [i: int] -> string
  (if (= i 1)  "stage-B-scope.md"
  (if (= i 2)  "stage-C-rubric.md"
  (if (= i 3)  "stage-D-extract.md"
  (if (= i 5)  "stage-F-core.md"
  (if (= i 6)  "stage-G-disposition.md"
  (if (= i 8)  "stage-H-feasibility.md"
  (if (= i 9)  "stage-I-prereg.md"
  (if (= i 11) "stage-K-contracts.md"
  (if (= i 13) "stage-M-fill.md"
  (if (= i 14) "stage-N-mutants.md"
  (if (= i 15) "stage-O-writeup.md"
      ""))))))))))))

;; ------------------------------------------------------------------
;; Sub-phase 4c: the invocation dimension.
;;
;; Every stage 4b ported delegates ONCE. Stage D delegates TWICE, to two blind
;; extractors over identical bytes (:645-659), and it is the only
;; agent-delegated stage that does.
;;
;; WHY THIS IS NOT stage-out-count. D's two invocations happen to correspond
;; one-to-one with its two declared outputs, and encoding that correspondence
;; as a rule would be wrong twice: stage L declares two outputs and is a gate
;; that delegates nothing, and stage M declares two while delegating once per
;; HOLE, which is neither one nor two. The correspondence is a coincidence at D
;; and a separate table is what keeps it from being read as a law.
;; ------------------------------------------------------------------

(def-shell stage-tag-count [i: int] -> int
  (if (= i 3) 2 1))

;; Whether the stage provisions an ISOLATED input set into each invocation's
;; directory before delegating. Stage D only (:648-651), and its docstring is why:
;; "Each extractor gets its own directory holding the pinned bytes and the rubric
;; and nothing else." Named rather than derived from stage-tag-count, because
;; provisioning and multiple invocations are different properties that happen to
;; coincide at the one stage that has either.
(def-shell stage-provision? [i: int] -> bool
  (= i 3))

;; Where the stage copies declared output j after validating it, or "".
;;
;; Stage D stages the pair "where reconcile.py expects them" (:662-665), which is
;; a SECOND location for the same bytes: the declared outputs stay under
;; 03-extraction and the copies are what stage E reads. Stage F and stage G then
;; read the A-side copy (:706, :737-739), so this table is what makes the rest of
;; the pipeline reachable at all -- F halts on an absent precondition without it,
;; measured.
(def-shell stage-stage-dir [i: int] -> string
  (if (= i 3) "04-reconcile/data" ""))

(def-shell stage-stage-dest [i: int j: int] -> string
  (if (= i 3) (if (= j 0) "04-reconcile/data/extraction-a.json"
                          "04-reconcile/data/extraction-b.json")
      ""))

;; The extractor letter the prompt's {{extractor}} placeholder carries
;; (:654, `extractor=tag.upper()`). Empty for every stage that delegates once.
;; The lowercase form is not here: it is already in stage-out-dir, which gives
;; 03-extraction/a and 03-extraction/b, and the agent's directory IS that
;; directory.
(def-shell stage-tag-upper [i: int j: int] -> string
  (if (= i 3) (if (= j 0) "A" "B") ""))

;; The label AgentRunner.run prints and the log line quotes (:309, :335).
;; Takes the invocation index because stage D's is per-tag,
;; `f"extract-{tag}"` (:655).
;;
;; STAGE M IS EMPTY HERE AND STILL DELEGATES, so "" means two things in this
;; column and a reader must not collapse them. The reference's stage M label is
;; `f"fill-{fn}#{attempt}"`, a function of the hole's name and the attempt
;; number, and no [i: int j: int] -> string entry can hold a value settled at run
;; time. stage-fanout is what separates the two readings: "" with a zero fanout
;; means the stage delegates to no agent, and "" with a non-zero fanout means the
;; label is composed by the fan-out machine, which knows the hole. This is the
;; same technique stage-floor's -1 needed and stage-shape supplied.
;;
;; stage-prompt IS FILLED FOR M AND WAS EMPTY UNTIL THE STAGE M AGENT CONTRACT.
;; The comment here used to say the row must stay empty because wave.llmll hands
;; the agent the checkout brief and an output path, and called that the
;; sole-channel discipline. driver-spec section 8 does not say that. Its third
;; paragraph requires the driver to report any file in an agent's directory that
;; was not among ITS DECLARED INPUTS, which makes a declared input a driver-side
;; commitment; a rendered task statement is one because the driver declares it.
;; So the row names the template and the WAVE renders it, per attempt, because
;; {{hole}}, {{brief}} and {{errors}} are settled inside the hole loop and the
;; stage loop never sees them. stage-pre-count stays zero for M for that reason:
;; the stage reads no artifact BEFORE delegating.
(def-shell stage-agent-label [i: int j: int] -> string
  (if (= i 1)  "scope"
  (if (= i 2)  "rubric"
  (if (= i 3)  (if (= j 0) "extract-a" "extract-b")
  (if (= i 5)  "core"
  (if (= i 6)  "disposition"
  (if (= i 8)  "feasibility"
  (if (= i 9)  "prereg"
  (if (= i 11) "contracts"
  (if (= i 14) "mutants"
  (if (= i 15) "writeup" "")))))))))))

;; The workdir-relative artifacts the stage reads BEFORE delegating. All are
;; unguarded reads in the reference and all are guarded decisions here; see
;; proposal section 9.1 item 1, section 9.2 item 4, and the sequencer's
;; disclosure block. The population was two at 4b and is FIVE at 4c.
;;
;;   B  00-source/PROVENANCE.json              :573, read_json, must PARSE
;;   C  (none)                                 :590-592 reads only pinned sources
;;   D  02-rubric/rubric.md                    :642, read_text, raw
;;   F  04-reconcile/data/extraction-a.json    :706-710, read_json + ["normative"]
;;   G  04-reconcile/data/extraction-a.json    :737-739, same projection
;;      05-core/core.json                      :731-732, read_json + ["core_ids"]
;;      01-scope/scope.md                      :742, read_text, raw
;;   I  01-scope/scope.md                      :1062-1063, read_text, raw
;;
;; Sub-phase 4d adds three stages and a FOURTH mode. The population is TEN.
;;
;;   H  01-scope/scope.md                      stage_H_feasibility, read_text, raw
;;   K  06-disposition/inventory-dispositioned.json
;;                                             stage_K_contracts, read_json +
;;                                             ["rows"], then the rows whose
;;                                             disposition == "Encoded" (mode 3)
;;      01-scope/scope.md                      stage_K_contracts, read_text, raw
;;   N  12-wave/roots.ast.json                 stage_N_killmatrix, read_text, raw
;;      08-prereg/PRE-REGISTRATION.md          stage_N_killmatrix, read_text, raw
;;
;; K'S READS LAND BEFORE ITS SOURCES HERE AND AROUND THEM IN THE REFERENCE.
;; The reference reads the inventory, then the pinned sources (inside the
;; prompt call), then the scope. The port's Pre loop reads both artifacts and
;; only then lists 00-source, so a workdir missing BOTH the scope and the
;; sources names the scope here and the sources there. The decision is
;; `failed` either way; only the detail string differs, and it is disclosed
;; rather than reordered, because reordering would put one stage's read
;; sequence outside the loop every other stage shares.
;;
;; STAGE G READS THE SAME extraction-a.json STAGE F DOES, and both read the
;; A-SIDE census rather than anything reconciled. F's local name for it is
;; `merged` (:706) and nothing merges it: reconcile.py reads the pair and writes
;; only reconciliation.json (:75-76, :155-156). Proposal section 9.2 item 5
;; records the consequence, that the B-side extraction has no downstream
;; consumer, and forbids the port from inventing a merge. The name `merged` is
;; deliberately not carried into any binding here.
;;
;; ORDER IS THE REFERENCE'S KEYWORD ORDER (:735-742), which matters because a
;; substituted value carrying a later placeholder would be expanded by it. For G
;; that is inventory, then core_ids, then scope.
;; ------------------------------------------------------------------

(def-shell stage-pre-count [i: int] -> int
  (if (= i 1)  1
  (if (= i 3)  1
  (if (= i 5)  1
  (if (= i 6)  3
  (if (= i 8)  1
  (if (= i 9)  1
  (if (= i 11) 2
  (if (= i 14) 2
  (if (= i 15) 5 0))))))))))

(def-shell stage-pre-path [i: int j: int] -> string
  (if (= i 1)  "00-source/PROVENANCE.json"
  (if (= i 3)  "02-rubric/rubric.md"
  (if (= i 5)  "04-reconcile/data/extraction-a.json"
  (if (= i 6)  (if (= j 0) "04-reconcile/data/extraction-a.json"
               (if (= j 1) "05-core/core.json"
                           "01-scope/scope.md"))
  (if (= i 8)  "01-scope/scope.md"
  (if (= i 9)  "01-scope/scope.md"
  (if (= i 11) (if (= j 0) "06-disposition/inventory-dispositioned.json"
                           "01-scope/scope.md")
  (if (= i 14) (if (= j 0) "12-wave/roots.ast.json"
                           "08-prereg/PRE-REGISTRATION.md")
  (if (= i 15) (if (= j 0) "09-gate/gate.json"
               (if (= j 1) "11-freeze/rfc-cov-1.txt"
               (if (= j 2) "13-kill-matrix/kill-matrix.json"
               (if (= j 3) "12-wave/wave.json"
                           "04-reconcile/SUMMARY.json"))))
      ""))))))))))

;; What the driver does with the artifact's bytes before substitution.
;;
;;   0  RAW      the text, verbatim. D's rubric, G's scope, I's scope.
;;   1  PARSE    must parse as JSON; the whole document is re-serialized. B's
;;               provenance, which the reference json.dumps back into the prompt
;;               (:577), so a file that does not parse cannot reach the agent
;;               either way.
;;   2  PROJECT  must parse, then a named member is re-serialized. F's and G's
;;               inventory (["normative"]) and G's core_ids (["core_ids"]).
;;   3  FILTER   must parse, the named member must be an array, and the rows
;;               whose stage-pre-filter-key equals stage-pre-filter-val are
;;               re-serialized as an array. K's Encoded rows: the reference
;;               reads ["rows"] and keeps r["disposition"] == "Encoded", then
;;               json.dumps(encoded, indent=1). An EMPTY selection is "[]",
;;               two characters, and is NOT a rejection: the reference authors
;;               zero rows and halts nowhere.
;;   4  OPTIONAL the text verbatim when the artifact reads, and the constant
;;               "(stage not run)" when it does not. NEW AT 4f and stage O is
;;               the only user. Its five inputs all reach the prompt through
;;               `maybe()` in stage_O_writeup, which substitutes exactly that
;;               string for an absent file. Every other mode HALTS on an absent
;;               artifact, which is right for every other stage: theirs are
;;               unguarded reads in the reference and an absent one tracebacks.
;;               Stage O's are guarded there, so halting would be the port
;;               inventing a halt, which section 12 forbids. `--only O` is the
;;               run that reaches it.
;;
;; MODE 2 IS WHERE THE PORT'S PROMPT BYTES DIVERGE, disclosed, and it is below
;; the oracle. The reference emits json.dumps(..., indent=1) and, for core_ids,
;; json.dumps(sorted(set)); LLMLL has json-serialize and no sort builtin, so the
;; port's prompt carries the same members with different whitespace and, for
;; core_ids, in the artifact's own order. Section 2.1's abstraction function
;; retains a field when some specification obligation mentions it, and no
;; obligation mentions prompt whitespace or the element order of a prompt blob.
;; The same disclosure already covers barriers-json (sequencer.llmll:631).
(def-shell stage-pre-mode [i: int j: int] -> int
  (if (= i 1)  1
  (if (= i 3)  0
  (if (= i 5)  2
  (if (= i 6)  (if (= j 0) 2 (if (= j 1) 2 0))
  (if (= i 8)  0
  (if (= i 9)  0
  (if (= i 11) (if (= j 0) 3 0)
  (if (= i 14) 0
  (if (= i 15) 4 0))))))))))

;; The member mode 2 projects, or mode 3 filters, or "".
(def-shell stage-pre-proj [i: int j: int] -> string
  (if (= i 5)  "normative"
  (if (= i 6)  (if (= j 0) "normative" (if (= j 1) "core_ids" ""))
  (if (= i 11) (if (= j 0) "rows" "")
      ""))))

;; Mode 3's row filter: the key read on each row and the value it must equal.
;; Stage-contract constants, like the floor: `r["disposition"] == "Encoded"`
;; in stage_K_contracts, and nothing measured from a run.
(def-shell stage-pre-filter-key [i: int j: int] -> string
  (if (= i 11) (if (= j 0) "disposition" "") ""))

(def-shell stage-pre-filter-val [i: int j: int] -> string
  (if (= i 11) (if (= j 0) "Encoded" "") ""))

;; The prompt placeholder the precondition artifact fills.
(def-shell stage-pre-key [i: int j: int] -> string
  (if (= i 1)  "{{provenance}}"
  (if (= i 3)  "{{rubric}}"
  (if (= i 5)  "{{inventory}}"
  (if (= i 6)  (if (= j 0) "{{inventory}}"
               (if (= j 1) "{{core_ids}}" "{{scope}}"))
  (if (= i 8)  "{{scope}}"
  (if (= i 9)  "{{scope}}"
  (if (= i 11) (if (= j 0) "{{encoded}}" "{{scope}}")
  (if (= i 14) (if (= j 0) "{{tree}}" "{{prereg}}")
  (if (= i 15) (if (= j 0) "{{gate}}"
               (if (= j 1) "{{coverage}}"
               (if (= j 2) "{{kill_matrix}}"
               (if (= j 3) "{{wave}}" "{{reconcile}}"))))
      ""))))))))))

;; Whether the stage's prompt carries {{rfc_text}}, and so whether the stage
;; reads the pinned sources through _sources_text (:613-630). B, C, D, F, G
;; and K do (:576, :591, :653, :708, :736, and stage_K_contracts's rfc_text
;; keyword); I carries {{scope}} and {{barriers}} and does not, and neither H
;; (llmll, scope) nor N (tree, prereg) does.
(def-shell stage-needs-src? [i: int] -> bool
  (if (= i 1)  true
  (if (= i 2)  true
  (if (= i 3)  true
  (if (= i 5)  true
  (if (= i 6)  true
  (if (= i 11) true false)))))))

;; Whether the stage's prompt carries {{barriers}}. Stage G (:741) and stage I
;; (:1064).
(def-shell stage-needs-barriers? [i: int] -> bool
  (if (= i 6) true (= i 9)))

;; ------------------------------------------------------------------
;; Sub-phase 4d: the three tables the compiler-oracle stages add.
;; ------------------------------------------------------------------

;; Whether the stage's prompt carries {{llmll}}, the compiler command the
;; agent is told to self-check with. H, K and M (`llmll=ctx.llmll` in all three
;; prompt calls). The value substituted is --llmll-cmd, the same executable the
;; stage then runs itself, so the agent's self-check and the stage's oracle
;; cannot silently name two compilers.
;;
;; M'S ROW IS DESCRIPTIVE AND NOT CONSULTED, and the asymmetry is stated rather
;; than hidden. `render` in sequencer.llmll reads this table and stage M never
;; reaches `render`: the wave does its own rendering and substitutes {{llmll}}
;; unconditionally, because a wave with no compiler command cannot run at all.
;; The row is filled because this table describes the PROMPT FILES, and
;; test_driver_ll_4d.py computes the {{llmll}} set from those files and checks
;; it against this row. An empty row would make that check report a true
;; invariant over a table that had stopped describing stage M.
(def-shell stage-needs-llmll? [i: int] -> bool
  (if (= i 8) true (if (= i 11) true (= i 13))))

;; Whether the stage provisions the LANGUAGE reference into the agent's
;; directory before delegating: _provision_reference, called by H, K, M and N.
;; The two files are LLMLL.md and docs/llmll-ast.schema.json, copied from
;; --reference-dir when that flag is given; the reference copies them from
;; REPO when they exist and silently skips them otherwise, and the port's
;; unchecked copies have the same tolerance. This is the tool manual and not
;; the answer: neither file says anything about the target RFC.
;;
;; STAGE M WAS FALSE HERE AND THE REFERENCE CALLS IT THERE. That was a PORT GAP
;; and not a decision, measured at the (a2) fold: _provision_reference runs
;; inside stage_M_wave's per-hole closure, wave.llmll did not provision, and no
;; document recorded the omission. The stage M agent contract closes it. The row
;; is now TRUE and `fan-cfg` reads it: a true row passes --reference-dir into the
;; WaveCfg and a false row passes the empty string, which is what tells the wave
;; to copy nothing. So this row decides a behaviour rather than describing one,
;; which is the opposite of the stage-needs-llmll? row above; read both comments
;; before assuming either.
;;
;; THE WAVE PROVISIONS PER ATTEMPT AND THE REFERENCE PER HOLE. The port's agent
;; directory is per (hole, attempt) and the reference's is per hole, so the copy
;; has to follow the directory. That is the safe direction: each attempt's
;; directory then holds its own declared inputs rather than inheriting them.
(def-shell stage-provision-ref? [i: int] -> bool
  (if (= i 8) true (if (= i 11) true (if (= i 13) true (= i 14)))))

;; THE FILE THE AGENT WRITES, which for two stages is NOT the declared output.
;; Restart record section 6 item 6: stages H and N invert the artifact flow.
;; The agent writes a CATALOGUE (`probes.json`, `mutants.json`, the
;; `out_name` of each ctx.agent.run call) that is an INPUT to the stage's own
;; computation, and the DRIVER writes the declared output (`feasibility.json`,
;; `kill-matrix.json`) after running the compiler over what the catalogue
;; names. Every other delegated stage's agent writes the declared output
;; itself, so this table defaults to stage-out. The delegated-output
;; validation (presence, floor, shape) applies to what the AGENT wrote; the
;; digest sweep after the stage applies to what the stage DECLARED.
;;
;; The first port of stage H gave the agent the declared path and the stub
;; wrote feasibility.json where probes.json was expected; the shape check
;; then rejected the driver's own placeholder. One run found it; no static
;; check would have, because both names are strings and both paths exist.
(def-shell stage-agent-out [i: int j: int] -> string
  (if (= i 8)  "07-feasibility/probes.json"
  (if (= i 14) "13-kill-matrix/mutants.json"
  (if (= i 15) "14-report/REPORT.md"
      (stage-out i j)))))

;; Where the agent WORKS, which is the directory of stage-agent-out and not of
;; stage-out. They differ at exactly one stage. H's and N's agent files sit in
;; the stage's own directory, so their agent directory is stage-out-dir like
;; everyone else's; stage O's declared output is the workdir-root REPORT.md
;; (the shutil.copy2 at the tail of stage_O_writeup), while the agent writes in
;; 14-report. Taking the agent directory from stage-out-dir would run stage O's
;; agent in the workdir ROOT, beside MANIFEST.json.
(def-shell stage-agent-dir [i: int j: int] -> string
  (if (= i 15) "14-report" (stage-out-dir i j)))

;; Whether the stage's declared output is checked for perturbation OMISSION
;; after it is written: stage O only, driver-spec.txt sec 13, decided by
;; report.omission-free?. Separate from stage-oracle because that table is
;; "which COMPILER-oracle loop follows" and no compiler runs here; separate
;; from stage-shape because this is a relation between two artifacts and not
;; the shape of one.
(def-shell stage-omission-check? [i: int] -> bool
  (= i 15))

;; Which compiler-oracle loop follows a passing delegated output. 0 is none,
;; and every stage 4b and 4c ported is 0.
;;
;;   1  H  per probe: `llmll verify --strict-verified-core` on the probe and
;;         on its mutant, scored by oracle.probe-established?; then the stage
;;         bar, oracle.feasibility-established?, AFTER feasibility.json is
;;         written (the require_written site, driver-spec sec 4:146-147)
;;   2  K  `llmll check` on the authored roots, halting on its exit code
;;   3  N  per mutant: verify, scored by oracle.outcome-as-expected?; the
;;         matrix is written only when oracle.matrix-complete? holds
(def-shell stage-oracle [i: int] -> int
  (if (= i 8) 1 (if (= i 11) 2 (if (= i 14) 3 0))))

;; Which run-time work-item source the stage delegates over. 0 is none: the
;; stage delegates each of its stage-tag-count tags exactly ONCE, and the static
;; tables above give every invocation its label and its directory.
;;
;;   1  M  one delegation per HOLE in the AST at declared output 1, retried
;;         under two budgets. The count is DATA and is never a function of i.
;;
;; WHAT THIS TABLE IS NOT. It is not an artifact count. stage-out-count counts
;; DECLARED outputs and stage M declares two, statically; the per-attempt
;; directories the wave creates are undeclared scratch, exactly as the
;; reference's 12-wave/agent-NN-fn directories are. The program-unification
;; proposal's section 4.10 item 2 read stage M's multiplicity off the wrong
;; column and concluded the registry needed a run-time artifact count. It does
;; not, and no stage has ever had one: stage H's probe rows and stage N's mutant
;; rows are the same dimension and they live in the sequencer's Loop payload,
;; seeded from a JSON array read at run time.
;;
;; SEPARATE FROM stage-tag-count, for the reason that table's own header gives.
;; D's two tags are two DIFFERENT extractors, with two prompt substitutions, two
;; provisioned input sets and two declared outputs. M's holes are ONE tag run
;; many times. Widening stage-tag-count would make those the same idea.
;;
;; SEPARATE FROM stage-oracle, which is the compiler loop that FOLLOWS a passing
;; delegated output. This is the loop that CONTAINS the delegation.
(def-shell stage-fanout [i: int] -> int
  (if (= i 13) 1 0))

;; The directory of stage-out i j, workdir-relative. "." for a top-level
;; artifact: wasi.fs.mkdir creates parents (measured) and is RNone on a
;; directory that already exists (measured), so mkdir "." is a no-op rather
;; than a special case the caller has to avoid.
(def-shell stage-out-dir [i: int j: int] -> string
  (if (= i 0)  "00-source"
  (if (= i 1)  "01-scope"
  (if (= i 2)  "02-rubric"
  (if (= i 3)  (if (= j 0) "03-extraction/a" "03-extraction/b")
  (if (= i 4)  "04-reconcile"
  (if (= i 5)  "05-core"
  (if (= i 6)  "06-disposition"
  (if (= i 7)  "06b-audit"
  (if (= i 8)  "07-feasibility"
  (if (= i 9)  "08-prereg"
  (if (= i 10) "09-gate"
  (if (= i 11) "10-roots"
  (if (= i 12) "11-freeze"
  (if (= i 13) "12-wave"
  (if (= i 14) "13-kill-matrix"
  (if (= i 15) "."
      ".")))))))))))))))))
